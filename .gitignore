## Visual studio for Mac
##


# globs
Makefile.in
*.userprefs
*.usertasks
config.make
config.status
aclocal.m4
install-sh
autom4te.cache/
*.tar.gz
tarballs/
test-results/

# content below from: https://github.com/github/gitignore/blob/main/Global/macOS.gitignore
# General
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon


# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# content below from: https://github.com/github/gitignore/blob/main/Global/Windows.gitignore
# Windows thumbnail cache files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db

# Dump file
*.stackdump

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk

# Vim temporary swap files
*.swp

# Single Target Config
solution-config.props
# Publish Profiles
!**/Properties/PublishProfiles/*.pubxml
# ──────────────────────────────────────────────────────────────────────────────
# Rules for this project
# ──────────────────────────────────────────────────────────────────────────────

# Local SQLite databases (auto-generated, contain absolute paths)
*.db
*.db-wal
*.db-shm

# Secrets and credentials. None belong in source. If one is added by mistake
# (dotnet user-secrets, appsettings.Local.json, .env, etc.), these entries stop it
# from being committed.
*.env
.env
.env.*
*.key
appsettings.Local.json
appsettings.*.Local.json
secrets.json
**/secrets/
**/*.secret

# An AWS profile or credentials never belong in the repo. These entries are a second safeguard.
aws.config
.aws/
credentials.json

# Coverage and validation runs: output JSON from the AcoustID/AudD coverage
# scripts. Contains test results, not secrets, but no need to version it.
acoustid_coverage_*.json
audd_coverage_*.json

# Local backup copy of this file. It is never committed.
appsettings.Development.json

# Raw PCM capture dumps: debug output of the vinyl recorder, about 30 MB each,
# written next to the executable. They are never source files, and a committed file stays in
# the history for good.
*.pcm

# Bundled ffmpeg + fpcalc, fetched per-RID by scripts/fetch-tools.{ps1,sh} during the build and
# checked against the SHA-256 pinned in scripts/tool-versions.txt. 21 to 29 MB per ffmpeg; fetched,
# never committed. A binary that is not the pinned one is fetched again on the next build.
RPM.Desktop/NativeLibs/tools/

# Machine-local iOS codesigning identity (see RPM.Mobile/signing.local.props)
signing.local.props

# The beat, key and lyric timing models. The four that ship are 214 MB together and can be rebuilt
# from upstream by scripts/export_*_onnx.py. The float32 wav2vec2 and the eight-bit beat model
# exist only in a working copy and do not ship. None of them is committed: the build downloads the
# ones that ship from updates.rpmrpmrpm.com and checks their hashes (FetchRpmModels in
# RPM.Desktop/RPM.Desktop.csproj), so a clean checkout builds without them here.
# The two small art models next to them are committed. The models listed here are the ones to keep out.
RPM.Desktop/Assets/OnnxModels/beat_this.onnx
RPM.Desktop/Assets/OnnxModels/beat_this.int8.onnx
RPM.Desktop/Assets/OnnxModels/skey.onnx
RPM.Desktop/Assets/OnnxModels/wav2vec2.onnx
RPM.Desktop/Assets/OnnxModels/wav2vec2.onnx.data
RPM.Desktop/Assets/OnnxModels/wav2vec2.int8.onnx
RPM.Desktop/Assets/OnnxModels/wav2vec2.vocab.json

# Benchmark corpora and their annotations, fetched by scripts/fetch-tempo-corpora.sh: 2.5 GB of
# other people's audio and a tempo_eval checkout. The results a run produces are kept
# (bench/results), the corpora and the raw per-track CSVs are not.
bench/data/
bench/tempo_eval/
bench/out*/
bench/*.log

# What the model said about each track of a corpus, kept so a measurement costs two minutes instead
# of forty-five (tools/TempoBench --cache). Derived from the corpora above and from the weights, and
# stamped with both, so it is rebuilt and not restored. It is 15 MB for GiantSteps.
bench/logits/

# Swift Package Manager build products (RPM.iOS)
.build/
*.xcuserdatad
DerivedData/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/

# Faces downloaded by scripts/gen_wordmarks.py to cut the genre wordmarks. Not shipped and not
# ours to redistribute: the app carries the outlines, never the fonts.
scripts/.fontcache/

# Photographs pulled from Pexels by scripts/gen_genre_photos.py for the genre heads. The same
# bargain as the faces: kept so a re-run after a crop change costs nothing, not ours to
# redistribute, and the app carries what was cut from them rather than the originals.
scripts/.photocache/

# rpmscope, the Scope reader: its virtualenv is a local build artefact
tools/rpmscope/.venv/
tools/rpmscope/*.egg-info/

# The AOT smoke harness publishes here; see scripts/aot-smoke.sh.
.aot-smoke/

# Personal Xcode signing (see RPM.iOS/Signing.xcconfig)
Local.xcconfig

# Editors, IDEs and assistants: personal settings stay out of the repo.
.vscode/
.idea/
.run/
.vs/
.vsconfig
.claude/
.mcp.json
*.code-workspace

# Font Awesome 5 Pro, copied in from the private rpm-fonts-pro repo by the build (RpmIconFonts in
# RPM.Desktop/RPM.Desktop.csproj). The licence does not allow publishing these files.
RPM.Desktop/Assets/Fonts/fa-solid-900.ttf
RPM.Desktop/Assets/Fonts/fa-regular-400.ttf
