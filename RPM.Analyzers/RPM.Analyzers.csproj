<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The repo's own rules, checked by the compiler.

    A rule that can only be enforced by noticing is a rule that is not enforced: the catalogue rule
    was written down for a year and broken in five places, each of them a hand-built URL handed to a
    shared fetcher, none of them looking like a catalogue client. These are the same rules, stated
    where they cannot be walked past.

    netstandard2.0 because that is what an analyzer loads as, whatever the projects it checks target.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
