<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- The Scope ring writes fixed records straight into a mapped page: no marshalling, no bounds
         check, no allocation. Nothing else in this assembly is unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Scope.StartForTest and StopForTest, which exist for the tests and for nothing else. -->
    <InternalsVisibleTo Include="RPM.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" />
    <!-- Library mirror (.rpm/library.db) — indexed search/sort over the central music folder -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPM.Fingerprint\RPM.Fingerprint.csproj" />
  </ItemGroup>


  <!-- The repo's own rules, as compile errors. Not referenced by RPM.Lambda.Api or RPM.Fingerprint:
       the API is the one process allowed to reach a catalogue, so RPM002 would be wrong there. -->
  <ItemGroup>
    <ProjectReference Include="..\\RPM.Analyzers\\RPM.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Asked<T> lives in RPM.Fingerprint so the API can use it too. -->
    <Using Include="RPM.Fingerprint.Net" />
  </ItemGroup>

  <!-- The key the apps send to the rpm API (RpmApi.Shipped). The source holds none. A release build gets
       the official key from the release with -p:RpmAppKey=…; a contributor sets their own developer key
       from rpmrpmrpm.com/developer as RPM_APP_KEY in the environment, which MSBuild reads as a property.
       Without a key, pages that need the API stay empty. The key is written into a generated file, not
       read at run time, so it is a constant in a Native AOT build too. -->
  <PropertyGroup>
    <RpmAppKey Condition="'$(RpmAppKey)' == ''">$(RPM_APP_KEY)</RpmAppKey>
  </PropertyGroup>

  <Target Name="RpmAppKeySource" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <RpmAppKeyFile>$(IntermediateOutputPath)RpmAppKey.g.cs</RpmAppKeyFile>
    </PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RpmAppKey)', '^[A-Za-z0-9_-]*$'))"
           Text="RpmAppKey may hold only letters, digits, '_' and '-'." />
    <!-- RpmUpdates=true marks an official release (RPM.Desktop.csproj). A release without the official
         key would ship an app whose API pages stay empty, and a developer key in a release would count
         every user's requests against one person's account. -->
    <Error Condition="'$(RpmUpdates)' == 'true' And '$(RpmAppKey)' == ''"
           Text="A release build (RpmUpdates=true) needs the official key in RpmAppKey or RPM_APP_KEY." />
    <Error Condition="'$(RpmUpdates)' == 'true' And $(RpmAppKey.StartsWith('rpm_dev_'))"
           Text="A release build (RpmUpdates=true) must not use a developer key." />
    <WriteLinesToFile File="$(RpmAppKeyFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by RPM.Core.csproj (RpmAppKeySource). Do not edit.;namespace RPM.Core.Net%3B;public static partial class RpmApi { private const string Shipped = &quot;$(RpmAppKey)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(RpmAppKeyFile)" />
      <FileWrites Include="$(RpmAppKeyFile)" />
    </ItemGroup>
  </Target>

</Project>
