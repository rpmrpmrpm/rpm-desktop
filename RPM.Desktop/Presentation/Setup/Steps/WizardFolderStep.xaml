<UserControl x:Class="RPM.Desktop.Presentation.Setup.Steps.WizardFolderStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
             xmlns:loc="using:RPM.Desktop.Strings">

  <!-- The central music folder.

       THE PICKER ROW CARRIES ITS OWN VALIDATION. The row's rim, its glyph and its second line are the
       state, so there is one object to read. A coloured line under the button would be a second element
       on the screen describing the first. -->

  <Grid>

    <!-- The mark and its tagline are the host's (WizardPage), in the same corner on every step. -->


  <!-- One group, centred, as every step is: the kicker, the heading, the line and the picker. -->
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
              Margin="52,44,52,96" Spacing="30" MaxWidth="1080">

    <!-- The ask. -->
    <StackPanel Spacing="20" Width="560" HorizontalAlignment="Center">

      <TextBlock x:Name="Kicker" FontSize="11" Foreground="#6BFFFFFF"
                 CharacterSpacing="220"
                 HorizontalAlignment="Center"/>

      <TextBlock Text="{loc:Str Key=Wizard_FolderTitle}"
                 FontFamily="{StaticResource RpmDisplayFontBold}"
                 FontSize="38" LineHeight="42" Foreground="White" TextWrapping="Wrap"
                 TextAlignment="Center" HorizontalAlignment="Center"/>

      <TextBlock Text="{loc:Str Key=Wizard_FolderBody}" FontSize="14" LineHeight="22"
                 Foreground="#A3FFFFFF" TextWrapping="Wrap" MaxWidth="460"
                 TextAlignment="Center" HorizontalAlignment="Center"/>

      <!-- The picker, which is also the validation. -->
      <Border x:Name="PickerRow" CornerRadius="12" Padding="16,14"
              Background="#13FFFFFF" BorderThickness="1" BorderBrush="#2BFFFFFF">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <FontIcon x:Name="PickerGlyph" Grid.Column="0" Style="{StaticResource FaIcon}"
                    Glyph="&#xF07C;" FontSize="18" Foreground="{StaticResource RpmCyanBrush}"
                    VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <TextBlock x:Name="PathText" Text="{loc:Str Key=Wizard_NoFolderChosen}"
                       FontSize="14" Foreground="White"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <TextBlock x:Name="StateText" FontSize="12" Foreground="#99FFFFFF"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
          </StackPanel>

          <ctl:RpmButton Grid.Column="2" x:Name="BrowseButton" Click="Browse_Click"
                         Padding="18,0" VerticalAlignment="Center"
                         Content="{loc:Str Key=Main_Browse}"/>
        </Grid>
      </Border>

    </StackPanel>
  </StackPanel>

    <!-- Footer. It sits on the dots' own line, at the far end. The band's height is shared with the
         host and the other steps, so all three feet land together. -->
    <Grid Height="{StaticResource WizardFooterHeight}" VerticalAlignment="Bottom">
      <ctl:RpmPrimaryButton x:Name="NextButton" Click="Next_Click" IsEnabled="False"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,52,0" Padding="26,0">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{loc:Str Key=Wizard_Next}" FontWeight="Bold" VerticalAlignment="Center"/>
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xF054;" FontSize="12"
                    VerticalAlignment="Center"/>
        </StackPanel>
      </ctl:RpmPrimaryButton>
    </Grid>
  </Grid>
</UserControl>
