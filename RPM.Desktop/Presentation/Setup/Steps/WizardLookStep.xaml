<UserControl x:Class="RPM.Desktop.Presentation.Setup.Steps.WizardLookStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
             xmlns:loc="using:RPM.Desktop.Strings">

  <!-- Step four: how rpm looks, and when it opens by itself.

       Centred, as the other steps are: the heading and the sections are one group in the middle of the
       window, each section a heading, a line and its choice, all on the centre line. The pictures are
       tiles to pick from, so what is chosen is seen rather than read. The group scrolls in a window too
       short for it. Every choice is also on a Settings page, and is written when Next is pressed. -->

  <Grid Margin="52,110,52,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <StackPanel Spacing="32" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0,8,0,24">

        <StackPanel Spacing="20" HorizontalAlignment="Center">
          <TextBlock x:Name="Kicker" FontSize="11" Foreground="#6BFFFFFF" CharacterSpacing="220"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="{loc:Str Key=Wizard_LookTitle}"
                     FontFamily="{StaticResource RpmDisplayFontBold}"
                     FontSize="38" LineHeight="42" Foreground="White" TextWrapping="Wrap"
                     TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <TextBlock Text="{loc:Str Key=Settings_Background}" FontSize="16" FontWeight="SemiBold"
                     Foreground="White" HorizontalAlignment="Center"/>
          <TextBlock Text="{loc:Str Key=Wizard_LookBackgroundHint}" FontSize="13" Foreground="#99FFFFFF"
                     TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
          <StackPanel x:Name="Backgrounds" Orientation="Horizontal" Spacing="14"
                      HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <TextBlock Text="{loc:Str Key=Settings_PegasusVisualizer}" FontSize="16" FontWeight="SemiBold"
                     Foreground="White" HorizontalAlignment="Center"/>
          <TextBlock Text="{loc:Str Key=Settings_PegasusVisualizerHint}" FontSize="13"
                     Foreground="#99FFFFFF" TextWrapping="Wrap" TextAlignment="Center"
                     HorizontalAlignment="Center"/>
          <StackPanel x:Name="Rooms" Orientation="Horizontal" Spacing="14"
                      HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- The switches, in two cards side by side: the record, and when rpm opens by itself. Both
             Windows settings are written when Next is pressed. The music files one opens Windows'
             Default apps page at rpm, because no app may make itself the default; the user confirms it
             there. -->
        <Grid ColumnSpacing="14" HorizontalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="388"/>
            <ColumnDefinition Width="388"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" CornerRadius="12" Padding="18,14" Background="#13FFFFFF"
                  BorderThickness="1" BorderBrush="#2BFFFFFF">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Str Key=Settings_ArtDisplay}" FontSize="16" FontWeight="SemiBold"
                         Foreground="White"/>
              <ToggleSwitch x:Name="RecordToggle" Header="{loc:Str Key=Settings_HeaderRecord}"
                            OffContent="" OnContent=""/>
              <TextBlock Text="{loc:Str Key=Settings_HeaderRecordHint}" FontSize="12" Foreground="#88FFFFFF"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" CornerRadius="12" Padding="18,14" Background="#13FFFFFF"
                  BorderThickness="1" BorderBrush="#2BFFFFFF">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Str Key=Wizard_LookStart}" FontSize="16" FontWeight="SemiBold"
                         Foreground="White"/>
              <ToggleSwitch x:Name="DiscToggle" Header="{loc:Str Key=Settings_DiscDefault}"
                            OffContent="" OnContent=""/>
              <ToggleSwitch x:Name="FilesToggle" Header="{loc:Str Key=Settings_OpenMusicFiles}"
                            OffContent="" OnContent=""/>
              <TextBlock Text="{loc:Str Key=Settings_OpenMusicFilesHint}" FontSize="12" Foreground="#88FFFFFF"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>

      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" Height="{StaticResource WizardFooterHeight}">
      <ctl:RpmPrimaryButton x:Name="NextButton" Click="Next_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="26,0">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{loc:Str Key=Wizard_Next}" FontWeight="Bold" VerticalAlignment="Center"/>
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xF054;" FontSize="12"
                    VerticalAlignment="Center"/>
        </StackPanel>
      </ctl:RpmPrimaryButton>
    </Grid>
  </Grid>
</UserControl>
