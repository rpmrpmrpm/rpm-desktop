<UserControl x:Class="RPM.Desktop.Presentation.Setup.Steps.WizardAccountStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
             xmlns:loc="using:RPM.Desktop.Strings">

  <!-- Step two: the rpm account. Sign in or sign up with the ways the sign-in window offers: Apple and
       Google (which make an account the first time), or an email and password. The cloud needs an
       account, and this step says so; everything else works without one, so it can be skipped.

       One group, centred, as every step is. -->

  <Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="52,44,52,96" Spacing="20" Width="560">

      <TextBlock x:Name="Kicker" FontSize="11" Foreground="#6BFFFFFF" CharacterSpacing="220"
                 HorizontalAlignment="Center"/>

      <TextBlock Text="{loc:Str Key=Wizard_AccountTitle}"
                 FontFamily="{StaticResource RpmDisplayFontBold}"
                 FontSize="38" LineHeight="42" Foreground="White" TextWrapping="Wrap"
                 TextAlignment="Center" HorizontalAlignment="Center"/>

      <TextBlock Text="{loc:Str Key=Wizard_AccountBody}" FontSize="14" LineHeight="22"
                 Foreground="#A3FFFFFF" TextWrapping="Wrap" MaxWidth="480"
                 TextAlignment="Center" HorizontalAlignment="Center"/>

      <!-- The ways in, in a card like the other steps' pickers. Apple first and the two as equals, as
           the sign-in window has them (App Store guideline 4.8). -->
      <Border x:Name="SignInCard" CornerRadius="12" Padding="18,16" Background="#13FFFFFF"
              BorderThickness="1" BorderBrush="#2BFFFFFF">
        <StackPanel Spacing="12">
          <TextBlock Text="{loc:Str Key=Login_ContinueWith}" FontFamily="{StaticResource RpmDisplayFont}"
                     FontSize="11" CharacterSpacing="85" Foreground="#77FFFFFF" HorizontalAlignment="Center"/>

          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="AppleButton" Grid.Column="0" Click="Apple_Click"
                    Style="{StaticResource GlassButtonStyle}"
                    HorizontalAlignment="Stretch" Height="44" MinHeight="44">
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="&#xf179;" FontFamily="{StaticResource FaBrandFont}" FontSize="16"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Str Key=Login_Apple}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button x:Name="GoogleButton" Grid.Column="1" Click="Google_Click"
                    Style="{StaticResource GlassButtonStyle}"
                    HorizontalAlignment="Stretch" Height="44" MinHeight="44">
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="&#xf1a0;" FontFamily="{StaticResource FaBrandFont}" FontSize="16"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Str Key=Login_Google}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock Text="{loc:Str Key=Login_NewHere}" FontSize="12" Foreground="#88FFFFFF"
                     TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>

          <TextBlock Text="{loc:Str Key=Login_Or}" FontSize="12" Foreground="#77FFFFFF"
                     HorizontalAlignment="Center"/>

          <!-- A new install's listener has no account yet, and signing up happens only in the app: the
               sign-up window makes one with an email and password. Someone who already has one signs in
               with the link under it; the sign-in window has the fields, the errors and the
               forgotten-password link, so they are not written twice. -->
          <ctl:RpmPrimaryButton x:Name="SignUpButton" Click="SignUp_Click" HorizontalAlignment="Center"
                                Padding="24,0">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf234;" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Str Key=Wizard_AccountSignUp}" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
          </ctl:RpmPrimaryButton>
          <HyperlinkButton x:Name="EmailButton" Click="Email_Click" HorizontalAlignment="Center"
                           FontSize="12" Padding="2,0" Content="{loc:Str Key=Wizard_AccountHaveOne}"/>

          <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="#E6FFFFFF" TextWrapping="Wrap"
                     TextAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <!-- Signed in: the news, and who, in place of the ways in. -->
      <Border x:Name="SignedInCard" CornerRadius="12" Padding="18,16" Background="#13FFFFFF"
              BorderThickness="1" BorderBrush="{StaticResource RpmCyanBrush}" Visibility="Collapsed">
        <StackPanel Spacing="6" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xF00C;" FontSize="16"
                      Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Wizard_AccountLoggedIn}" FontSize="16" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="SignedInText" FontSize="13" Foreground="#A3FFFFFF" HorizontalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>

      <!-- And then Discogs, which needs the rpm account to go through: the same connection the Catalog
           settings make (CatalogSettingsPage.OnConnect), offered here once there is an account to make
           it with. -->
      <Border x:Name="DiscogsCard" CornerRadius="12" Padding="18,16" Background="#13FFFFFF"
              BorderThickness="1" BorderBrush="#2BFFFFFF" Visibility="Collapsed">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xF51F;" FontSize="15"
                      Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Wizard_DiscogsTitle}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{loc:Str Key=Wizard_DiscogsBody}" FontSize="13" LineHeight="20"
                     Foreground="#A3FFFFFF" TextWrapping="Wrap" TextAlignment="Center"
                     HorizontalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <ctl:RpmButton x:Name="DiscogsButton" Click="Discogs_Click" Padding="20,0"
                           Content="{loc:Str Key=Catalog_DiscogsConnect}"/>
            <ctl:RpmButton x:Name="DiscogsRecheck" Click="DiscogsRecheck_Click" Padding="18,0"
                           Content="{loc:Str Key=Catalog_DiscogsRecheck}" Visibility="Collapsed"/>
          </StackPanel>
          <TextBlock x:Name="DiscogsStatus" FontSize="12.5" Foreground="#E6FFFFFF" TextWrapping="Wrap"
                     TextAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Footer, on the dots' line, at the far end: skip while signed out, Next once signed in. -->
    <Grid Height="{StaticResource WizardFooterHeight}" VerticalAlignment="Bottom">
      <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Margin="0,0,52,0">
        <ctl:RpmLink x:Name="SkipLink" Click="Next_Click" Content="{loc:Str Key=Wizard_SkipForNow}"
                     VerticalAlignment="Center"/>
        <ctl:RpmPrimaryButton x:Name="NextButton" Click="Next_Click" Padding="26,0" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{loc:Str Key=Wizard_Next}" FontWeight="Bold" VerticalAlignment="Center"/>
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xF054;" FontSize="12"
                      VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
