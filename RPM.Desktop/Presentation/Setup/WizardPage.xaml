<Page x:Class="RPM.Desktop.Presentation.Setup.WizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:RPM.Desktop.Presentation.Common"
      xmlns:loc="using:RPM.Desktop.Strings"
      xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
      xmlns:steps="using:RPM.Desktop.Presentation.Setup.Steps"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="Transparent">

  <!-- The setup wizard's host: the ground, the step showing, and the three dots.
       The shell already gives this page the whole window (ArtBandRow collapses to nought, and there is no
       deck), so there is no chrome to hide here.

       THE STEPS ARE CONTROLS, NOT FRAME PAGES. This is a deliberate difference from NavigationService's
       model. The drifting room and the record are continuous across the three steps. A Frame navigation
       rebuilds the page, so the room would restart its drift and the record would jump back to its resting
       angle at every step. A Frame gives a back stack, but this wizard's Back is one field on the host. -->

  <Grid Background="Black">

    <!-- The ground, as one layer, so the welcome can bring it up out of the black as one thing (see
         WizardPage.Welcome). Its palette is the app's own ink, not a record's, because no record exists
         yet. This is the one screen in the app that runs before the collection exists. Drift is switched
         off in the code-behind while the import press runs, because that press needs the processor
         cores. -->
    <Grid x:Name="Ground" IsHitTestVisible="False">
      <common:CardRoom x:Name="Room" Live="True" Shown="True"/>

      <!-- Over it, so the text stays readable whatever the drift is doing underneath. -->
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#57080C12"/>
            <GradientStop Offset="1.0" Color="#C7080C12"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <!-- The welcome: the first thing a new install says, alone in the middle of the window while the
         opening sound plays. The greeting turns through every language the app speaks (two greetings,
         one fading over the other), the line under it comes up after two seconds, and it all stays
         until Continue is pressed. See WizardPage.Welcome. -->
    <StackPanel x:Name="Intro" Opacity="0" Visibility="Collapsed" Spacing="18"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid HorizontalAlignment="Center" IsHitTestVisible="False">
        <TextBlock x:Name="HelloA" FontFamily="{StaticResource RpmDisplayFontBold}" FontSize="44"
                   Foreground="White" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
        <TextBlock x:Name="HelloB" FontFamily="{StaticResource RpmDisplayFontBold}" FontSize="44"
                   Foreground="White" HorizontalAlignment="Center" TextWrapping="NoWrap" Opacity="0"/>
      </Grid>
      <TextBlock x:Name="HelloLine" Text="{loc:Str Key=Wizard_HelloSubtitle}" Opacity="0"
                 FontSize="18" Foreground="#C4FFFFFF" HorizontalAlignment="Center" IsHitTestVisible="False"/>
      <ctl:RpmPrimaryButton x:Name="ContinueButton" Click="Continue_Click" Opacity="0" IsEnabled="False"
                            HorizontalAlignment="Center" Padding="30,0" Margin="0,22,0,0">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{loc:Str Key=Wizard_Continue}" FontWeight="Bold" VerticalAlignment="Center"/>
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xF054;" FontSize="12"
                    VerticalAlignment="Center"/>
        </StackPanel>
      </ctl:RpmPrimaryButton>
    </StackPanel>

    <Grid x:Name="StepHost" Margin="0,0,0,0" utu:SafeArea.Insets="VisibleBounds">

      <!-- One of the three is visible. All three are built up front, because each is a few dozen
           elements. Building the import step when Next is pressed would put its first layout inside the
           transition. -->
      <steps:WizardRegionStep x:Name="RegionStep"/>
      <steps:WizardAccountStep x:Name="AccountStep" Visibility="Collapsed"/>
      <steps:WizardFolderStep x:Name="FolderStep" Visibility="Collapsed"/>
      <steps:WizardImportStep x:Name="ImportStep" Visibility="Collapsed"/>
      <steps:WizardLookStep   x:Name="LookStep"   Visibility="Collapsed"/>
      <steps:WizardLayoutStep x:Name="LayoutStep" Visibility="Collapsed"/>
      <steps:WizardDoneStep   x:Name="DoneStep"   Visibility="Collapsed"/>

      <!-- The mark and its tagline, in the same corner on every step, so nothing moves between them. It
           stays where it is for the rest of the app's life: top left of the window, at the size and
           position that the artwork header parks it at once setup is done. ArtDisplay draws it at
           46.5 x 18 on a margin of 25,44, and grows it by RpmParkedScale to 93 x 36 when the deck is
           idle. These are those numbers. The tagline is nudged right so its first letter stands under
           the descender of the mark's p (ArtDisplay.PlaceTagline works this out; here the mark never
           moves, so the approximation holds). -->
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,44,0,0"
                  IsHitTestVisible="False">
        <Path Style="{StaticResource RpmWordmark}" Fill="#E8FFFFFF" Width="93" Height="36"
              HorizontalAlignment="Left"/>
        <TextBlock FontSize="11" LineHeight="14" Margin="8,1,0,0">
          <Run x:Name="TaglineHead" Foreground="#66FFFFFF"/><Run x:Name="TaglineTail" Foreground="#A6FFFFFF"/>
        </TextBlock>
      </StackPanel>

      <!-- The dots are owned by the host, one per step (WizardSteps.Count, built in code), and they sit
           in one place on every step.

           The dots share a line with each step's action. Each step draws its buttons in a footer of the
           same height, aligned to the same bottom edge. So the dots and the action sit on one line
           across the foot of the window. The height is stored once, as WizardFooterHeight in
           Generic.xaml, because every step's footer must agree on it. -->
      <Grid Height="{StaticResource WizardFooterHeight}" VerticalAlignment="Bottom"
            IsHitTestVisible="False">
        <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="9"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="52,0,0,0"/>
      </Grid>

    </Grid>
  </Grid>
</Page>
