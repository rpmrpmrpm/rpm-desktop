<ContentDialog x:Class="RPM.Desktop.Presentation.About.AboutDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <!-- ScrollBody is off because this card has two scrollers of its own, and only one is shown at a time:
       the list and the licence reader. A body scroller around them would measure both with no limit.
       The outer scroller would then scroll whichever one is on screen a second time. -->
  <ctl:ResizableDialogShell x:Name="Shell" TitleGlyph="&#xf05a;" ScrollBody="False">

    <Grid>
      <!-- The list: the app first, then everyone else. -->
      <Grid x:Name="ListView">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>   <!-- the app itself -->
          <RowDefinition Height="Auto"/>   <!-- the heading over the credits -->
          <RowDefinition Height="*"/>      <!-- the credits -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ContentBorderStyle}" Padding="20,16">
          <StackPanel Spacing="4">
            <TextBlock Text="rpm" FontSize="34"
                       FontFamily="{StaticResource RpmHeaderFont}" Foreground="#CCFFFFFF"/>
            <TextBlock Text="{loc:Str Key=About_Tagline}" FontSize="13" Foreground="#B3FFFFFF"/>

            <!-- The version and the copyright are on one line. They are two short facts about this copy,
                 and neither needs a line of its own under the 34 point name. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <TextBlock x:Name="VersionText" FontSize="12" Foreground="#88FFFFFF"/>
              <TextBlock Text="·" FontSize="12" Foreground="#55FFFFFF"/>
              <TextBlock x:Name="RightsText" FontSize="12" Foreground="#88FFFFFF"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
              <Button Style="{StaticResource DenseButtonStyle}" Click="Website_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0ac;" FontSize="11"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="{loc:Str Key=About_Website}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource DenseButtonStyle}" Click="Support_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf1cd;" FontSize="11"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="{loc:Str Key=About_Support}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource DenseButtonStyle}" Click="Privacy_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf3ed;" FontSize="11"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="{loc:Str Key=About_Privacy}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource DenseButtonStyle}" Click="Terms_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf15c;" FontSize="11"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="{loc:Str Key=About_Terms}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource DenseButtonStyle}" Click="LgplSource_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf121;" FontSize="11"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="{loc:Str Key=About_LgplSource}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6" Margin="2,22,2,12">
          <TextBlock Text="{loc:Str Key=About_Acknowledgements}"
                     FontSize="17" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="{loc:Str Key=About_Intro}" FontSize="12.5" Foreground="#99FFFFFF"
                     TextWrapping="Wrap"/>
          <TextBox x:Name="FilterBox"
                   PlaceholderText="{loc:Str Key=About_Search}"
                   TextChanged="Filter_Changed"
                   Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
          <StackPanel x:Name="Entries" Spacing="0"/>
        </ScrollViewer>

        <TextBlock x:Name="NoMatchText" Grid.Row="2"
                   Text="{loc:Str Key=About_NoMatch}"
                   FontSize="13" Foreground="#88FFFFFF"
                   HorizontalAlignment="Center" Margin="0,40,0,0"
                   Visibility="Collapsed"/>
      </Grid>

      <!-- The licence reader. It is the same card, showing the whole of one licence. It covers the list
           rather than sitting beside it, because these texts are long (about 25,000 words) and are meant
           to be read in full. -->
      <Grid x:Name="ReaderView" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="3" Margin="2,0,2,14">
          <TextBlock x:Name="ReaderTitle" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock x:Name="ReaderSubtitle" FontSize="12.5" Foreground="#99FFFFFF"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}" Padding="0">
          <ScrollViewer x:Name="ReaderScroller" VerticalScrollBarVisibility="Auto" Padding="18,16">
            <!-- This is the only monospaced text in the app. A licence has its own line breaks and
                 indentation. The app's own font would re-wrap paragraphs that were written to a fixed
                 width. -->
            <TextBlock x:Name="ReaderText" FontFamily="Consolas, Menlo, monospace"
                       FontSize="11.5" Foreground="#CCFFFFFF"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <ctl:ResizableDialogShell.Footer>
      <Button x:Name="CloseButton" Click="Close_Click"
              Style="{StaticResource GlassButtonStyle}" Padding="18,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon x:Name="CloseGlyph" Style="{StaticResource FaIcon}" Glyph="&#xf00d;"
                    FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="CloseLabel" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
