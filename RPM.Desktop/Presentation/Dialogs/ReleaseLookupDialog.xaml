<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.ReleaseLookupDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:local="using:RPM.Desktop.Presentation.Dialogs"
               xmlns:model="using:RPM.Desktop.Presentation.Dialogs.Models"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
        <!-- Sizes for data entry: 24 px inputs, 12 pt text. The search form is like the other forms in
             the import path. Each row it saves is a row of results on screen. -->
        <ResourceDictionary Source="ms-appx:///Themes/DenseForm.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter scrim than the framework default. The dialog card is translucent, so the
               artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter scrim than the framework default. The dialog card is translucent, so the
               artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="Fa">ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro Solid</FontFamily>

      <!-- Labels are left-aligned, as in the disc window. The metadata editors right-align theirs,
           because their long lists of fields read as one block. This window has six boxes above a list
           of results. -->
      <Style x:Key="LookupFieldLabelStyle" TargetType="TextBlock"
             BasedOn="{StaticResource DenseFieldLabelStyle}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
      </Style>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <!-- The header shows the window's name and nothing else. The purpose of the window is shown by what
       it contains. ScrollBody is off because the results fill the card. A scrolling body would measure
       the list against infinite height and collapse it to one row. -->
  <ctl:ResizableDialogShell x:Name="Shell" Title="{loc:Str Key=Lookup_Heading}" TitleGlyph="&#xf002;"
                            ScrollBody="False">

    <!-- Two pages in one card. The search is the window's own task. The track step is the follow-up
         page. It takes the whole card, not a strip beside the results, because it is a grid of editable
         rows and a record can have thirty of them. Only one page is shown at a time. -->
    <Grid>

    <!-- ══ PAGE 1 ══ The question is on the left and the answers are on the right. This is the same
         shape as the disc window, for the same reason. The search is a short list of fields that does
         not need much height. The results are what the user studies, so they get the full height. -->
    <Grid x:Name="SearchPage" ColumnSpacing="{StaticResource DenseColumnSpacing}">
      <Grid.ColumnDefinitions>
        <!-- The label column plus a readable box, and no wider. The rest of the width is for results. -->
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- The form scrolls on its own, so a short window can still reach the buttons. It uses the
           scrollbar lane as padding, so the scrollbar cannot cover the boxes. -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                    Padding="0,0,14,0">
        <StackPanel Spacing="{StaticResource DenseGroupSpacing}" VerticalAlignment="Top">

          <!-- ── SEARCH ── The dense form: a label in a fixed column, and a 24 px box beside it. Every
               input starts on one vertical line, so an empty field shows as a gap in that line. -->
          <StackPanel>
            <TextBlock Text="{loc:Str Key=Lookup_SearchKicker}" Style="{StaticResource DenseGroupHeaderStyle}"/>
            <Border Height="1" Background="{StaticResource DenseRuleBrush}" Margin="0,3,0,8"/>

            <Grid ColumnSpacing="8" RowSpacing="{StaticResource DenseRowSpacing}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Key=Lookup_Album}"
                         Style="{StaticResource LookupFieldLabelStyle}"/>
              <TextBox x:Name="SearchBox" Grid.Row="0" Grid.Column="1" KeyDown="Field_KeyDown"
                       PlaceholderText="{loc:Str Key=Search_AlbumPlaceholder}"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Key=Lookup_Artist}"
                         Style="{StaticResource LookupFieldLabelStyle}"/>
              <TextBox x:Name="ArtistBox" Grid.Row="1" Grid.Column="1" KeyDown="Field_KeyDown"/>

              <!-- Year and country are short answers, so they share a row, as in the disc window. -->
              <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Str Key=Review_ColYear}"
                         Style="{StaticResource LookupFieldLabelStyle}"/>
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center">
                <TextBox x:Name="YearBox" KeyDown="Field_KeyDown" MaxLength="4"
                         Width="{StaticResource DenseNarrowWidth}"/>
                <TextBlock Text="{loc:Str Key=Lookup_Country}" Margin="6,0,0,0"
                           Style="{StaticResource LookupFieldLabelStyle}"/>
                <!-- The country box holds two characters. The placeholder that shows which two ("e.g.
                     GB") is the whole hint. A narrow box cut it off, so the box is wide enough for it. -->
                <TextBox x:Name="CountryBox" KeyDown="Field_KeyDown" MaxLength="2"
                         Width="{StaticResource DenseNarrowWidth}"
                         PlaceholderText="{loc:Str Key=Lookup_CountryHint}"/>
              </StackPanel>

              <!-- What the album is released on. This is a filter, not a hint. A famous title is mostly
                   CDs in any catalogue, so a record, a cassette or a reel never shows on the first page
                   unless the search is narrowed to it. The filter starts from where the lookup was
                   opened (a record being split, or a CD in the drive), and the user can change it. -->
              <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Str Key=Lookup_Media}"
                         Style="{StaticResource LookupFieldLabelStyle}"/>
              <ComboBox x:Name="MediaBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left"
                        MinWidth="150"/>
            </Grid>

            <!-- The catalogue number and barcode name one pressing exactly. They are shown only when a
                 provider that can resolve them is connected (Discogs). MusicBrainz alone cannot, so the
                 fields are hidden. The panel is outside the grid above, because a Grid still reserves
                 row spacing for a row whose only child is collapsed. -->
            <Grid x:Name="CodeFieldsPanel" Visibility="Collapsed" Margin="0,6,0,0"
                  ColumnSpacing="8" RowSpacing="{StaticResource DenseRowSpacing}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Key=Lookup_CatalogNumber}"
                         Style="{StaticResource LookupFieldLabelStyle}"/>
              <TextBox x:Name="CatnoBox" Grid.Row="0" Grid.Column="1" KeyDown="Field_KeyDown"
                       PlaceholderText="{loc:Str Key=Lookup_CatalogHint}"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Key=Lookup_Barcode}"
                         Style="{StaticResource LookupFieldLabelStyle}"/>
              <TextBox x:Name="BarcodeBox" Grid.Row="1" Grid.Column="1" KeyDown="Field_KeyDown"
                       PlaceholderText="{loc:Str Key=Lookup_BarcodeHint}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"
                        HorizontalAlignment="Right">
              <!-- Clears the seeded fields in one click. A CD's auto-lookup fills album, artist and
                   year. When the user looks up a pressing by catalogue number, those values would
                   narrow the search wrongly. -->
              <Button x:Name="ClearButton" Click="Clear_Click" Style="{StaticResource DenseButtonStyle}"
                      Padding="12,0" ToolTipService.ToolTip="{loc:Str Key=Lookup_ClearTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf12d;" FontSize="11"/>
                  <TextBlock Text="{loc:Str Key=Lookup_Clear}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <!-- The form's own button, at the form's own height. The window's Cancel and Use buttons
                   keep their full height in the footer. -->
              <ctl:RpmPrimaryButton x:Name="SearchButton" Click="Search_Click" Height="24" MinHeight="24"
                                    Padding="14,0" FontSize="11.5" CornerRadius="4">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf002;" FontSize="11"/>
                  <TextBlock Text="{loc:Str Key=Lookup_SearchButton}" VerticalAlignment="Center"/>
                </StackPanel>
              </ctl:RpmPrimaryButton>
            </StackPanel>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- ── RESULTS ── The pressings that came back. Under the heading is what they were searched on:
           the criteria the form held when Search ran. So a stale seed (for example a wrong auto-lookup
           from a CD) is clear at a glance. Set by SearchAsync. -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Str Key=Lookup_ResultsKicker}"
                   Style="{StaticResource DenseGroupHeaderStyle}"/>
        <Border Grid.Row="1" Height="1" Background="{StaticResource DenseRuleBrush}" Margin="0,3,0,8"/>

        <StackPanel Grid.Row="2" x:Name="SearchSummaryPanel" Orientation="Horizontal" Spacing="8"
                    Visibility="Collapsed" Margin="0,0,0,8">
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf002;" FontSize="10" Foreground="#88FFFFFF"
                    VerticalAlignment="Center"/>
          <TextBlock x:Name="SearchSummaryText" FontSize="11.5"
                     Foreground="{StaticResource DenseLabelInkBrush}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </StackPanel>

      <!-- Results -->
      <!-- The scrollbar lane is used as padding, as in every scroller in these windows. A ListView
           draws its bar at its own right edge, over the content furthest right, which here is the match
           pill and the track count. Padding stops the rows short of the bar. -->
      <ListView Grid.Row="3" x:Name="ResultList" SelectionMode="Single" Padding="0,0,14,0"
                SelectionChanged="ResultList_SelectionChanged" DoubleTapped="ResultList_DoubleTapped"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
        <!-- Selected rows use the same cyan tint as the main collection grid (MainPage). -->
        <ListView.Resources>
          <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#2404C8FF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#3004C8FF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#3004C8FF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="#1404C8FF"/>
        </ListView.Resources>
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="CornerRadius" Value="6"/>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="model:ReleaseLookupRow">
            <!-- A row is a picture, two lines and a score. The sleeve is 56 px high. The text uses the
                 form's sizes. The user compares the year, country and format in the subtitle, so more
                 rows on screen make comparing easier. -->
            <Grid ColumnSpacing="10" Padding="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- The sleeve. The image placeholder icon sits behind the cover. So a release with no
                   art, or one whose thumbnail fails to load, shows the icon instead of an empty grey
                   box. -->
              <Border Grid.Column="0" Width="56" Height="56" CornerRadius="4" Background="#18FFFFFF">
                <Grid>
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf03e;" FontSize="18" Foreground="#40FFFFFF"/>
                  <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                </Grid>
              </Border>

              <!-- Facts -->
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#F2FFFFFF"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="#99FFFFFF"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <!-- ── Where it came from, and what pictures come with it ── Two questions are answered
                   before the pressing is chosen. Which catalogue is speaking? Discogs is named, and the
                   app's own catalogue is the unmarked default. And what art does this pressing have? A
                   record with photographs is easier to identify, so the count matters. The count is
                   shown as a count, because no catalogue says which photograph is the disc. -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <ctl:DiscogsIcon Width="13" Height="13" Foreground="#99FFFFFF"
                                 VerticalAlignment="Center" Visibility="{Binding DiscogsVisibility}"
                                 ToolTipService.ToolTip="Discogs"/>
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf03e;" FontSize="11"
                          Foreground="#99FFFFFF" VerticalAlignment="Center"
                          Visibility="{Binding ArtVisibility}"
                          ToolTipService.ToolTip="{loc:Str Key=Lookup_ArtTooltip}"/>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            Visibility="{Binding PhotosVisibility}"
                            ToolTipService.ToolTip="{Binding PhotosTooltip}">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf302;" FontSize="11"
                            Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding PhotosText}" FontSize="11" Foreground="#99FFFFFF"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>

              <!-- Match pill, and the popup that gives the reasons for the score. -->
              <Button Grid.Column="3" Background="#18FFFFFF" BorderThickness="0" Padding="10,3"
                      MinWidth="0" MinHeight="0" CornerRadius="11" VerticalAlignment="Center"
                      Visibility="{Binding MatchVisibility}">
                <TextBlock Text="{Binding MatchText}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{Binding MatchBrush}"/>
                <Button.Flyout>
                  <Flyout>
                    <!-- The standard light grey system flyout, not a dark bubble. -->
                    <Flyout.FlyoutPresenterStyle>
                      <Style TargetType="FlyoutPresenter">
                        <Setter Property="RequestedTheme" Value="Light"/>
                      </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <StackPanel Width="260" Spacing="10">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding MatchText}" FontSize="26" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Verdict}" FontSize="13" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding ReasonLines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf111;" FontSize="5"
                                        Foreground="#80000000" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding}" FontSize="12" Foreground="#99000000" TextWrapping="Wrap"/>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
        </ListView>

      <!-- ── NOTHING THERE YET ── The results column with no results in it. There are two states, and
           only one is shown at a time. Either the app is waiting for the catalogues, or it is waiting
           for the user. Both sit in the list's own cell, so neither can appear beside a row. -->

      <!-- Waiting on the catalogues. This is the app's wait mark: a record turning, drawn in the same
           glass as the panes. The system ring is not used. Only Spinning is set on it. It shows and
           hides itself, so it cannot keep turning over results that have already arrived. -->
      <ctl:RecordSpinner x:Name="ResultsLoader" Grid.Row="3" Width="52" Height="52"
                         VerticalAlignment="Center" HorizontalAlignment="Center"/>

      <!-- Waiting on the user. This points at the side it is filled from. It shows only before anything
           has been asked: on open with nothing seeded, and again when the search boxes are emptied. An
           arrow at the form tells the user where to type. It would say nothing to someone who has just
           run a search. -->
      <StackPanel x:Name="EmptyHint" Grid.Row="3" Spacing="10" IsHitTestVisible="False"
                  Visibility="Collapsed"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
        <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf002;" FontSize="34" Foreground="#33FFFFFF"
                  HorizontalAlignment="Center"/>
        <!-- The arrow points at the form, where the answer is typed. It points left, not down. -->
        <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf060;" FontSize="12" Foreground="#66FFFFFF"
                    VerticalAlignment="Center"/>
          <TextBlock Text="{loc:Str Key=Lookup_EmptyHint}" FontSize="12.5" Foreground="#88FFFFFF"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <!-- Asked, and answered with nothing. The magnifier is struck through. This shows the difference
           between the two states in the icon itself. This state is a result, not an invitation, so
           there is no arrow to the form. -->
      <StackPanel x:Name="NoResults" Grid.Row="3" Spacing="10" IsHitTestVisible="False"
                  Visibility="Collapsed"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid HorizontalAlignment="Center">
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf002;" FontSize="34" Foreground="#33FFFFFF"/>
          <!-- The usual way to strike out an icon: the slash is its own glyph, drawn over the icon it
               cancels, on the same box so it lands corner to corner. -->
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf715;" FontSize="34" Foreground="#33FFFFFF"/>
        </Grid>
        <TextBlock Text="{loc:Str Key=Lookup_NoResults}" FontSize="12.5" Foreground="#88FFFFFF"
                   HorizontalAlignment="Center"/>
      </StackPanel>
      </Grid>
    </Grid>

    <!-- ══ PAGE 2: THE RECORD'S TRACKS, filled in from the release ══ The files on the shelf, in the
         order they sit on the record. Each one shows what it is called now and what the release would
         make it. The rows are editable. A catalogue is often wrong, and a window that offered only "all
         of it or none of it" would send people back to the tag editor. -->
    <Grid x:Name="TracksPage" Visibility="Collapsed" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- What was picked, shown again. Once a pressing is picked, the window shows a grid of titles
           instead of the search. Without this line, nothing on screen names the pressing. -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf51f;" FontSize="12" Foreground="#99FFFFFF"
                  VerticalAlignment="Center"/>
        <TextBlock x:Name="TracksReleaseText" FontSize="13" Foreground="#F2FFFFFF"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- The record's own fields are a second answer, and a bigger one. They rename the album. So they
           have a box of their own, with the values it would write shown beside it. They are not changed
           as a side effect of fixing the titles. -->
      <!-- A Grid instead of a StackPanel, and both halves use the same type size. The CheckBox draws
           its label through a content presenter. The stock template aligns that to the top of the
           control, so a wrapped label lines up with the box. A sibling centred in the row would sit a
           couple of pixels off. -->
      <!-- The label and the values are one text block, in two runs. Two separate items could not share
           a line, because the CheckBox aligns its label to the top and anything beside it lands a
           couple of pixels off. Two runs in one block cannot disagree about the baseline. The whole
           line sits inside the tick, so clicking the values also toggles it. -->
      <CheckBox x:Name="AlbumFieldsBox" Grid.Row="1" IsChecked="True" MinWidth="0" MinHeight="0"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
        <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis">
          <Run x:Name="AlbumFieldsLabel"/><Run x:Name="AlbumFieldsValues" Foreground="#88FFFFFF"/>
        </TextBlock>
      </CheckBox>

      <!-- Column heads. They use the row grid's measurements, which are NOT the scroller's. A row sits
           inside the scroller's 14 px bar lane, and then has 8 px of margin and 4 px of padding of its
           own. So its right edge is 26 px in from the card, not 14. A heading at 14 px made every star
           column a little wider than the boxes under it, and the Length figures ended up left of their
           label. -->
      <Grid x:Name="TracksHeaderGrid" Grid.Row="2" ColumnSpacing="8" Margin="12,6,26,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="62"/>
          <ColumnDefinition Width="0.8*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="0.7*"/>
          <ColumnDefinition Width="48"/>
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" x:Name="TracksSelectAllBox" Click="TracksSelectAll_Click" MinWidth="0"
                  MinHeight="0" IsChecked="True" VerticalAlignment="Bottom"
                  ToolTipService.ToolTip="{loc:Str Key=Lookup_TickAllTooltip}"/>
        <TextBlock Grid.Column="2" Text="{loc:Str Key=Review_ColTrack}" FontSize="11.5"
                   Foreground="{StaticResource DenseLabelInkBrush}" VerticalAlignment="Bottom"/>
        <TextBlock Grid.Column="3" Text="{loc:Str Key=Lookup_ColCurrent}" FontSize="11.5"
                   Foreground="{StaticResource DenseLabelInkBrush}" VerticalAlignment="Bottom"/>
        <TextBlock Grid.Column="4" Text="{loc:Str Key=Review_ColTitle}" FontSize="11.5"
                   Foreground="{StaticResource DenseLabelInkBrush}" VerticalAlignment="Bottom"/>
        <TextBlock Grid.Column="5" Text="{loc:Str Key=Review_ColArtist}" FontSize="11.5"
                   Foreground="{StaticResource DenseLabelInkBrush}" VerticalAlignment="Bottom"/>
        <TextBlock Grid.Column="6" Text="{loc:Str Key=Review_ColLength}" FontSize="11.5"
                   Foreground="{StaticResource DenseLabelInkBrush}" VerticalAlignment="Bottom"/>
      </Grid>

      <!-- An ItemsControl, on purpose, not a ListView. These rows are editable forms with text boxes in
           them. There are tens of them, never thousands. A ListView recycles its containers, and a
           recycled container can keep part of what it showed before. That is the fault this screen must
           avoid. -->
      <ScrollViewer x:Name="TrackFillScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" Padding="0,0,14,0">
        <ItemsControl x:Name="TrackFillList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="model:ReleaseTrackFillRow">
              <Grid ColumnSpacing="8" Padding="4,1" Margin="8,1" CornerRadius="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="62"/>
                  <ColumnDefinition Width="0.8*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="0.7*"/>
                  <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="0"
                          MinHeight="0" VerticalAlignment="Center"
                          Visibility="{Binding TickVisibility}"/>

                <!-- The record has more tracks than the release. This row is one of the extra ones. It
                     is marked, not dropped. A row missing from the list would look like a file that
                     does not exist. -->
                <FontIcon Grid.Column="1" Style="{StaticResource FaIcon}" Glyph="&#xf071;" FontSize="11"
                          Foreground="{StaticResource RpmGoldBrush}" VerticalAlignment="Center"
                          Visibility="{Binding WarningVisibility}"
                          ToolTipService.ToolTip="{loc:Str Key=Lookup_NoTrackOnRelease}"/>

                <TextBlock Grid.Column="2" Text="{Binding PlaceText}" FontSize="11.5"
                           Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding CurrentText}" FontSize="11.5"
                           Foreground="#88FFFFFF" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <TextBox Grid.Column="4" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsEditable}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="5" Text="{Binding Artist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsEditable}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="6" Text="{Binding LengthText}" FontSize="11.5"
                           Foreground="#88FFFFFF" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- The listing is behind a throttled lookup, and this page is what the user is waiting for. So
           the user is put on it first, and the wait is shown here. Otherwise the search list would look
           as if it had stopped responding to the button just pressed. This is the app's wait mark, a
           record turning. -->
      <ctl:RecordSpinner x:Name="TracksLoader" Grid.Row="3" Width="52" Height="52"
                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
    </Grid>

    <ctl:ResizableDialogShell.FooterLeading>
      <!-- The status line and each source's count, at the bottom left, together. -->
      <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <ItemsControl x:Name="SourceList" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="18"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:ProviderProgressVm">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                          Visibility="{Binding ChipVisibility}">
                <!-- No Visibility binding. The spinner shows itself while it turns (see RecordSpinner).
                     A local write to its Visibility would replace a binding there. -->
                <ctl:RecordSpinner Width="16" Height="16" VerticalAlignment="Center" Spinning="{Binding IsBusy}"/>
                <FontIcon Style="{StaticResource FaIcon}" Glyph="{Binding StateGlyph}" FontSize="10"
                          Foreground="{Binding StateBrush}" Visibility="{Binding GlyphVisibility}"
                          VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ctl:ResizableDialogShell.FooterLeading>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- The offer sits next to the button it changes. When ticked, the primary button reads "Next"
             and the window goes on to the tracks. When unticked, it reads "Use this release" and the
             window is done. It is hidden where the caller has no files for it to name. -->
        <CheckBox x:Name="TrackStepBox" Visibility="Collapsed" MinWidth="0" MinHeight="0"
                  Margin="0,0,8,0" VerticalAlignment="Center" Click="TrackStepBox_Click"
                  Content="{loc:Str Key=Lookup_SetTrackMetadata}"/>
        <!-- The second offer, beside it: whether this pressing replaces the record's pictures. It
             starts in the state the record is in: unticked over an existing cover, ticked over an empty
             one. It is hidden where the caller does not take pictures at all. See ArtAsk. -->
        <CheckBox x:Name="OverwriteArtBox" Visibility="Collapsed" MinWidth="0" MinHeight="0"
                  Margin="0,0,8,0" VerticalAlignment="Center"
                  Content="{loc:Str Key=Lookup_OverwriteArt}"/>
        <Button x:Name="BackButton" Click="Back_Click" Visibility="Collapsed"
                Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf060;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Lookup_Back}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="CloseButton" Click="Close_Click"
                Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ctl:RpmPrimaryButton x:Name="UseButton" Click="Use_Click" IsEnabled="False" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon x:Name="UseGlyph" Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock x:Name="UseText" Text="{loc:Str Key=Lookup_Use}" FontWeight="Bold"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
        <ctl:RpmPrimaryButton x:Name="ApplyButton" Click="Apply_Click" Visibility="Collapsed" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Lookup_ApplyTracks}" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
