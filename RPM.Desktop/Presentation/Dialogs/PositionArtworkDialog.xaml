<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.PositionArtworkDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
        <!-- Sizes for data entry: 24 px inputs, 12 pt text. -->
        <ResourceDictionary Source="ms-appx:///Themes/DenseForm.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <FontFamily x:Key="PlaceFa">ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro Solid</FontFamily>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <!-- ScrollBody is false. The header model must be laid out in the space the card really has.
       With unbounded height (which a scrolling body gives) it would size itself to the whole
       photo, and the card would grow to fit it. -->
  <ctl:ResizableDialogShell x:Name="Shell" ScrollBody="False"
                            Title="{loc:Str Key=ArtPlace_Title}" TitleGlyph="&#xf0b2;">

    <Grid RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>      <!-- The header, to scale, with the photo in it -->
        <RowDefinition Height="Auto"/>   <!-- The same three numbers, as figures -->
      </Grid.RowDefinitions>

      <!-- ═══ The header, to scale ═══ Every rectangle here is one of the app's own measurements
           (ArtDisplay.HeaderShape) times one factor. So this is the header at another size, not a
           drawing of it. The photo is the same photo, drawn into the same zone as in the real header.

           Code sets the position of every part (Stage_SizeChanged → Model). The Canvas holds them,
           and the named parts give the code something to place. -->
      <Border Grid.Row="0" Style="{StaticResource ContentBorderStyle}" Padding="14">
        <Grid x:Name="Stage" Background="Transparent"
              SizeChanged="Stage_SizeChanged"
              PointerPressed="Stage_PointerPressed"
              PointerMoved="Stage_PointerMoved"
              PointerReleased="Stage_PointerReleased"
              PointerCaptureLost="Stage_PointerReleased"
              PointerWheelChanged="Stage_PointerWheelChanged">

        <Canvas x:Name="Model" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Canvas.Clip>
            <RectangleGeometry x:Name="ModelClip"/>
          </Canvas.Clip>

          <!-- The library ground, under the header. The record overlaps it, as it does in the app,
               instead of being cut off at the bottom of the model. -->
          <Rectangle x:Name="LibraryPlate" Fill="#14000000"/>
          <Rectangle x:Name="LibraryCard" Fill="#1FFFFFFF" RadiusX="8" RadiusY="8"/>

          <!-- The header's own surface, shown when there is no photo. -->
          <Rectangle x:Name="HeaderPlate" Fill="#141A22"/>

          <!-- The photo's zone, clipped the same way as in the header. The photo inside is sized and
               placed in code (PlacePhoto) every time the framing changes. It is not a render transform. -->
          <Grid x:Name="PictureZone">
            <Grid.Clip>
              <RectangleGeometry x:Name="PictureClip"/>
            </Grid.Clip>
            <Image x:Name="Photo" Stretch="Fill"
                   HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
          </Grid>

          <!-- Where the photo ends on the left. In the header its left edge fades into a blurred copy
               of itself, so it has no visible edge. The model has no blurred copy, so the fade goes into
               the header's own ground instead. A hard vertical edge in the middle of the photo would
               not appear in the real header, so it must not appear here. -->
          <Rectangle x:Name="PictureFade" IsHitTestVisible="False">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#FF141A22"/>
                <GradientStop Offset="1" Color="#00141A22"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>

          <!-- The header's scrim: the darkening behind the text, which fades out towards the record. -->
          <Rectangle x:Name="Scrim" IsHitTestVisible="False">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#A6000000"/>
                <GradientStop x:Name="ScrimMid" Offset="0.45" Color="#4D000000"/>
                <GradientStop x:Name="ScrimEnd" Offset="0.85" Color="#00000000"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>

          <!-- The album cover square, where it sits: bottom left of the title band. -->
          <Border x:Name="CoverBox" CornerRadius="4" Background="#3D000000"
                  BorderBrush="#59FFFFFF" BorderThickness="1">
            <TextBlock x:Name="CoverGlyph" Text="&#xf51f;" FontFamily="{StaticResource PlaceFa}"
                       Foreground="#59FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <!-- Title, artist and album, as bars at the heights of the real lines. -->
          <Rectangle x:Name="TitleBar"  Fill="#D9FFFFFF" RadiusX="1.5" RadiusY="1.5"/>
          <Rectangle x:Name="ArtistBar" Fill="#8CFFFFFF" RadiusX="1.5" RadiusY="1.5"/>
          <Rectangle x:Name="AlbumBar"  Fill="#59FFFFFF" RadiusX="1.5" RadiusY="1.5"/>

          <!-- The record: its shadow, the disc, two grooves, the label and the spindle hole. Centred on
               the header's right edge, so half of it hangs off, as it does in the app. -->
          <Ellipse x:Name="RecordShadow" Fill="#40000000"/>
          <Ellipse x:Name="RecordDisc" Fill="#0D0D10" Stroke="#26FFFFFF" StrokeThickness="1"/>
          <Ellipse x:Name="RecordGrooveOuter" Stroke="#1AFFFFFF" StrokeThickness="1"/>
          <Ellipse x:Name="RecordGrooveInner" Stroke="#14FFFFFF" StrokeThickness="1"/>
          <Ellipse x:Name="RecordLabel" Fill="#4D6A7480"/>
          <Ellipse x:Name="RecordHole" Fill="#141A22"/>

          <!-- Where the title band ends. The photo continues past it, under the library's first card. -->
          <Rectangle x:Name="BandFoot" Fill="#1FFFFFFF"/>

          <!-- The edge of the window, drawn over everything. -->
          <Rectangle x:Name="PlateEdge" Stroke="#38FFFFFF" StrokeThickness="1"
                     RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
        </Canvas>

        <!-- Shown instead of the model while the photo is being fetched, and if it cannot be opened. -->
        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource DenseLabelInkBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>
        </Grid>
      </Border>

      <!-- ═══ The same three numbers, as figures ═══ Everything a drag does, given exactly. Use these
           when a drag is not precise enough, for example to match two artists or to move a face one
           percent. -->
      <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}" Padding="12,10">
        <Grid RowSpacing="{StaticResource DenseRowSpacing}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" ColumnSpacing="{StaticResource DenseColumnSpacing}"
                RowSpacing="{StaticResource DenseRowSpacing}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- How large the subject is drawn. -->
            <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Str Key=ArtPlace_Zoom}"
                         Width="{StaticResource DenseLabelWidth}"
                         Style="{StaticResource DenseFieldLabelStyle}"/>
              <Slider Grid.Column="1" x:Name="ZoomSlider" Style="{StaticResource SlimSliderStyle}"
                      Minimum="0" Maximum="1000" StepFrequency="1"
                      VerticalAlignment="Center" ValueChanged="Zoom_ValueChanged"/>
              <TextBlock Grid.Column="2" x:Name="ZoomValue" Width="{StaticResource DenseNarrowWidth}"
                         Style="{StaticResource DenseFieldLabelStyle}"
                         Foreground="{StaticResource DenseValueInkBrush}"/>
            </Grid>

            <!-- How far the photo reaches across the header before the clear gap by the record. -->
            <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Str Key=ArtPlace_Width}"
                         Width="{StaticResource DenseLabelWidth}"
                         Style="{StaticResource DenseFieldLabelStyle}"/>
              <Slider Grid.Column="1" x:Name="WidthSlider" Style="{StaticResource SlimSliderStyle}"
                      Minimum="0" Maximum="1000" StepFrequency="1"
                      VerticalAlignment="Center" ValueChanged="Width_ValueChanged"/>
              <TextBlock Grid.Column="2" x:Name="WidthValue" Width="{StaticResource DenseNarrowWidth}"
                         Style="{StaticResource DenseFieldLabelStyle}"
                         Foreground="{StaticResource DenseValueInkBrush}"/>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Str Key=ArtPlace_Across}"
                         Width="{StaticResource DenseLabelWidth}"
                         Style="{StaticResource DenseFieldLabelStyle}"/>
              <Slider Grid.Column="1" x:Name="AcrossSlider" Style="{StaticResource SlimSliderStyle}"
                      Minimum="0" Maximum="1000" StepFrequency="1"
                      VerticalAlignment="Center" ValueChanged="Across_ValueChanged"/>
              <TextBlock Grid.Column="2" x:Name="AcrossValue" Width="{StaticResource DenseNarrowWidth}"
                         Style="{StaticResource DenseFieldLabelStyle}"
                         Foreground="{StaticResource DenseValueInkBrush}"/>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Str Key=ArtPlace_Down}"
                         Width="{StaticResource DenseLabelWidth}"
                         Style="{StaticResource DenseFieldLabelStyle}"/>
              <Slider Grid.Column="1" x:Name="DownSlider" Style="{StaticResource SlimSliderStyle}"
                      Minimum="0" Maximum="1000" StepFrequency="1"
                      VerticalAlignment="Center" ValueChanged="Down_ValueChanged"/>
              <TextBlock Grid.Column="2" x:Name="DownValue" Width="{StaticResource DenseNarrowWidth}"
                         Style="{StaticResource DenseFieldLabelStyle}"
                         Foreground="{StaticResource DenseValueInkBrush}"/>
            </Grid>
          </Grid>

          <Border Grid.Row="1" BorderBrush="{StaticResource DenseRuleBrush}" BorderThickness="0,1,0,0"
                  Margin="0,4,0,0"/>

          <Grid Grid.Row="2" ColumnSpacing="10" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="AutoButton" Style="{StaticResource DenseButtonStyle}"
                    Click="Auto_Click">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0e2;" FontSize="10"
                          VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Str Key=ArtPlace_UseApp}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Grid.Column="1" x:Name="FillButton" Style="{StaticResource DenseButtonStyle}"
                    Click="Fill_Click">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf010;" FontSize="10"
                          VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Str Key=ArtPlace_FitWhole}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <TextBlock Grid.Column="2" x:Name="HintText" FontSize="11.5"
                       Foreground="{StaticResource DenseLabelInkBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis"
                       Text="{loc:Str Key=ArtPlace_Hint}"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock x:Name="ArtistText" FontSize="11.5"
                         Foreground="{StaticResource DenseValueInkBrush}"
                         TextTrimming="CharacterEllipsis" MaxWidth="260"/>
              <TextBlock Text="&#183;" FontSize="11.5" Foreground="{StaticResource DenseRuleBrush}"/>
              <TextBlock x:Name="SourceText" FontSize="11.5"
                         Foreground="{StaticResource DenseLabelInkBrush}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="CancelButton" Click="Cancel_Click"
                Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ctl:RpmPrimaryButton x:Name="SaveButton" Click="Save_Click" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=ArtPlace_Save}" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
