<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.ApplyNamingDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <ctl:ResizableDialogShell x:Name="Shell" Title="{loc:Str Key=Naming_ApplyTitle}" TitleGlyph="&#xf07b;">

    <StackPanel Spacing="16">
      <TextBlock Text="{loc:Str Key=Naming_ApplySaved}" FontSize="13" Foreground="#CCFFFFFF"
                 TextWrapping="Wrap"/>

      <!-- What the choice means. The template applies only to new files, unless the records that
           are already filed are moved to match it. -->
      <Border x:Name="ChoicePanel" Style="{StaticResource ContentBorderStyle}" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="{loc:Str Key=Naming_ApplyQuestion}" Foreground="White" FontSize="14"/>
          <TextBlock Text="{loc:Str Key=Naming_ApplyExplain}" FontSize="12" Foreground="#99FFFFFF"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="TemplateText" FontSize="12" Foreground="#CCFFFFFF" TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
          <TextBlock x:Name="PatternText" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                     Foreground="#7FD4FF" TextWrapping="Wrap"/>
          <TextBlock x:Name="CountText" FontSize="12" Foreground="#99FFFFFF" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- The run: a bar, the file being moved, and the result when it is finished. -->
      <Border x:Name="ProgressPanel" Style="{StaticResource ContentBorderStyle}" Padding="16"
              Visibility="Collapsed">
        <StackPanel Spacing="10">
          <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Value="0" HorizontalAlignment="Stretch"/>
          <TextBlock x:Name="ProgressText" FontSize="12" Foreground="#CCFFFFFF"/>
          <TextBlock x:Name="CurrentText" FontSize="11" Foreground="#88FFFFFF"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="RefusedText" FontSize="12" Foreground="#FFB2B2" TextWrapping="Wrap"
                     Visibility="Collapsed"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- A plus for the files that are new, a check to apply it to the whole library, a square
             to stop, and a cross to close. These are the same four marks the other footers use. -->
        <Button x:Name="OnlyNewButton" Click="OnlyNew_Click"
                Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf067;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Naming_ApplyOnlyNew}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ctl:RpmPrimaryButton x:Name="ApplyButton" Click="Apply_Click" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Naming_ApplyNow}" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
        <Button x:Name="StopButton" Click="Stop_Click"
                Style="{StaticResource GlassButtonStyle}" Padding="18,0" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf04d;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Naming_ApplyStop}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="CloseButton" Click="Close_Click"
                Style="{StaticResource GlassButtonStyle}" Padding="18,0" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Naming_ApplyClose}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
