<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.PromptDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <!-- The app's own question dialog: the small OK and OK/Cancel questions. It uses the look of the
       view chooser instead of the framework's look.

       A stock ContentDialog has a white-cornered box, a title in the system dialog style, and buttons
       that fill the full width. None of that matches the rest of the app. The view menu already shows
       what a small RPM surface looks like: a dark card with 8 px corners, a darker band across the top
       with the name in 12 px semibold text, a thin line under the band, and the content on the card.
       This dialog uses the same look.

       The framework chrome is turned off the same way the large dialogs turn it off. The ContentDialog
       is only a transparent host for the dimmed backdrop and the modal behaviour. Everything visible is
       the card below. So the buttons are also ours, and so is the answer. See the Answer method in
       PromptDialog.xaml.cs. -->

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- The same lighter scrim the big dialogs use, so the artwork behind reads through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <!-- The card. It has the same surface, 8 px corners and hairline edge as the view chooser flyout,
       so a question and a menu look like one family. -->
  <Border x:Name="Card" MinWidth="380" MaxWidth="480" CornerRadius="8"
          Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <StackPanel>

      <!-- The title band. It matches the view chooser: 32 px high, CardTitleBarBrush, a hairline
           under it, and the name in 12 px semibold at three-quarter white. Collapsed when there is
           no title. -->
      <Border x:Name="TitleBand" Background="{StaticResource CardTitleBarBrush}" CornerRadius="8,8,0,0"
              Height="32" Padding="16,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
        <TextBlock x:Name="TitleText" VerticalAlignment="Center"
                   FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </Border>

      <!-- The question. A string is shown as body copy. Anything else (a panel or a text box) is
           placed as it is, on the card, aligned to the edges of the buttons. -->
      <ContentPresenter x:Name="BodyHost" Margin="16,14,16,0" HorizontalContentAlignment="Stretch"/>

      <!-- The buttons. The cancel action is on the left and the main action is on the right. -->
      <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right"
                  Spacing="10" Margin="16,18,16,16">
        <ctl:RpmButton x:Name="SecondaryButton" Padding="18,0" Visibility="Collapsed"
                       Click="Secondary_Click"/>
        <ctl:RpmButton x:Name="CloseButton" Padding="18,0" Visibility="Collapsed"
                       Click="Close_Click"/>
        <ctl:RpmPrimaryButton x:Name="PrimaryButton" Padding="18,0" Visibility="Collapsed"
                              Click="Primary_Click"/>
        <!-- The typed confirmation button (ConfirmByTypingAsync). It takes the place of the primary
             button. It is red and stays disabled until the text box holds the required text. -->
        <ctl:RpmDangerButton x:Name="DangerButton" Padding="18,0" Visibility="Collapsed"
                             IsEnabled="False" Click="Danger_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</ContentDialog>
