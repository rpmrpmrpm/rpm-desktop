<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.AlbumEditDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The standard sizing for data-entry forms: 24 px inputs, 12 pt text. -->
        <ResourceDictionary Source="ms-appx:///Themes/DenseForm.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <ctl:ResizableDialogShell x:Name="Shell" Title="{loc:Str Key=AlbumEdit_Title}" TitleGlyph="&#xf51f;"
                            ScrollBody="False">

    <!-- Two rows: the tab strip, which is fixed, and the tab under it. The shell's body scroller is
         off (ScrollBody), because it would scroll the strip away with the fields. Each tab has its
         own scroller and takes the bar's lane as PADDING, so the bar cannot cover the inputs at the
         right edge. This is the same layout as the per-file editor. -->
    <Grid RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- The tab strip and the release lookup share one row, as in the per-file editor. The strip
           is the same one used there (see RailTabStrip). A record has as many fields as a track,
           and one column of them would be a long scroll with no landmarks. -->
      <Grid Grid.Row="0" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="TabStripHost" Grid.Column="0" HorizontalAlignment="Left"/>
        <!-- This is one record, so the lookup needs no setup first. It fills the boxes, and the
             user decides by reading them. It is at the top, so its edge lines up with the strip. -->
        <Button x:Name="LookupButton" Grid.Column="1" Click="LookUpRelease_Click"
                Style="{StaticResource DenseButtonStyle}" Padding="12,0" Visibility="Collapsed"
                VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf002;" FontSize="11"/>
            <TextBlock Text="{loc:Str Key=MassEdit_LookUpRelease}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <ScrollViewer x:Name="PanelBasic" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" Padding="0,0,14,0">
        <Grid ColumnSpacing="{StaticResource DenseColumnSpacing}" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="BasicLeft"  Grid.Column="0" Spacing="{StaticResource DenseGroupSpacing}"/>
          <StackPanel x:Name="BasicRight" Grid.Column="1" Spacing="{StaticResource DenseGroupSpacing}"/>
        </Grid>
      </ScrollViewer>

      <ScrollViewer x:Name="PanelWork" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" Padding="0,0,14,0" Visibility="Collapsed">
        <Grid ColumnSpacing="{StaticResource DenseColumnSpacing}" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="WorkLeft"  Grid.Column="0" Spacing="{StaticResource DenseGroupSpacing}"/>
          <StackPanel x:Name="WorkRight" Grid.Column="1" Spacing="{StaticResource DenseGroupSpacing}"/>
        </Grid>
      </ScrollViewer>

      <!-- What the library thinks about this record, as opposed to what its files say. It has its
           own tab because none of it is a tag. These are settings. Putting them among the fields
           that are written to every track would suggest that they are tags too. -->
      <ScrollViewer x:Name="PanelSettings" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" Padding="0,0,14,0" Visibility="Collapsed">
        <Grid ColumnSpacing="{StaticResource DenseColumnSpacing}" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="SettingsLeft" Grid.Column="0" Spacing="{StaticResource DenseGroupSpacing}"/>
          <StackPanel x:Name="SettingsRight" Grid.Column="1" Spacing="{StaticResource DenseGroupSpacing}"/>
        </Grid>
      </ScrollViewer>

      <!-- The two pictures for the whole record: the cover, and the label printed on the disc. -->
      <ScrollViewer x:Name="PanelArtwork" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" Padding="0,0,14,0" Visibility="Collapsed">
        <StackPanel x:Name="ArtworkHost" Orientation="Horizontal" Spacing="12"
                    VerticalAlignment="Top"/>
      </ScrollViewer>
    </Grid>

    <!-- The folder the record is in. It sits beside the buttons, where the path can be read. -->
    <ctl:ResizableDialogShell.FooterLeading>
      <TextBlock x:Name="FolderText" FontSize="11.5" Foreground="#8CFFFFFF" MaxWidth="420"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </ctl:ResizableDialogShell.FooterLeading>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Click="Cancel_Click" Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ctl:RpmPrimaryButton Click="Save_Click" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0c7;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=AlbumEdit_Save}" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
