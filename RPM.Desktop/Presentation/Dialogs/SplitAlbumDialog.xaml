<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.SplitAlbumDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:dlgc="using:RPM.Desktop.Presentation.Dialogs.Controls"
               xmlns:local="using:RPM.Desktop.Presentation.Dialogs"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
        <!-- Sizes for data entry: 24 px inputs, 12 pt text. This window is a form over a picture. Every
             row it saves from the header is a row of the track list on screen. -->
        <ResourceDictionary Source="ms-appx:///Themes/DenseForm.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter scrim than the framework default. The dialog card is translucent, so the
               artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter scrim than the framework default. The dialog card is translucent, so the
               artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="Fa">ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro Solid</FontFamily>

      <!-- The waveform's tools: small square glass keys, all the same size. The strip then reads as one
           instrument, not as a row of words.

           It has its own template, because the standard template paints a theme brush over the
           background on hover. The snap key shows that it is on with a lit background, and hover
           must not hide that. Here hover and press add a wash on top instead, so a lit key stays lit. -->
      <Style x:Key="WaveToolStyle" TargetType="Button">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="#DDFFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="Back" Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"/>
                <Border x:Name="Wash" Background="#26FFFFFF" Opacity="0"
                        CornerRadius="{TemplateBinding CornerRadius}"/>
                <ContentPresenter x:Name="Body" Content="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="Wash.Opacity" Value="1"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="Wash.Opacity" Value="1"/>
                        <Setter Target="Body.Opacity" Value="0.7"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="Back.Opacity" Value="0.4"/>
                        <Setter Target="Body.Opacity" Value="0.3"/>
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Reset to defaults, as a key at the top right of a group of sliders. It has the undo arrow,
           and the name in the tooltip. It is a glass key like the toolbar's, one size smaller, so it
           sits on a slider row. -->
      <Style x:Key="ResetKeyStyle" TargetType="Button" BasedOn="{StaticResource WaveToolStyle}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <!-- A tool step's name, in the second column of its row. -->
      <Style x:Key="StepTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#E6FFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>

      <!-- The line beside a step's controls: what to do, or where the step stands. -->
      <Style x:Key="StepNoteStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="#99FFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <!-- The body does not scroll. It is two panes with a splitter between them. The waveform is a fixed
       working surface, and the track list must not push it off the top. Everything below sizes to the
       card, and the list scrolls inside its own pane. -->
  <ctl:ResizableDialogShell x:Name="Shell" Title="{loc:Str Key=Split_Title}" TitleGlyph="&#xf51f;"
                            ScrollBody="False">

    <Grid RowSpacing="8">
      <!-- The two panes are shares of the space the card has left. The dense header gives back about
           fifty pixels. The wave's share is reduced to match (5* to 4*), so the waveform opens at its usual
           height and the extra room goes to the track list, which runs short. The splitter writes both
           numbers from the real heights, so this is only the opening ratio.

           The waveform's toolbar and the tool panel are a row of their own above the wave row. They are
           sized to what they hold. So opening or closing a tool takes its height from both panes
           through the stars, never from the waveform's minimum. The minimum height of the wave row is
           for the waveform alone, and it does not include the toolbar. -->
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition x:Name="WaveRow" Height="4*" MinHeight="116"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition x:Name="ListRow" Height="6*" MinHeight="120"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Intro: what this does, and where the original goes. -->
      <TextBlock Grid.Row="0" x:Name="IntroText" Text="{loc:Str Key=Split_Intro}"
                 FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}" TextWrapping="Wrap"/>

      <!-- The album header, in the dense form style. The label sits to the left of its box, on a fixed
           gutter. The album's box and the artist's box start on the same vertical line, and an empty
           one shows as a break in it. The header reflows to two rows, so the fields are not squeezed.
           It collapses back to one line only when the window is wide enough for all three (see
           Header_SizeChanged). Format is in the footer, next to Split. -->
      <Grid Grid.Row="1" x:Name="HeaderGrid" ColumnSpacing="16"
            RowSpacing="{StaticResource DenseRowSpacing}" SizeChanged="Header_SizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The album name is a plain field to type or correct. Naming the record from the catalogues
             is a separate task. The Look up button opens a window for it. It is a button on a field
             row, so it takes the row's height (DenseButtonStyle). -->
        <Grid x:Name="AlbumPanel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="82"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{loc:Str Key=Review_ColAlbum}"
                     Style="{StaticResource DenseFieldLabelStyle}"/>
          <TextBox Grid.Column="1" x:Name="AlbumBox" VerticalAlignment="Center"/>
          <Button Grid.Column="2" x:Name="LookupButton" Click="Lookup_Click"
                  Style="{StaticResource DenseButtonStyle}" VerticalAlignment="Center"
                  ToolTipService.ToolTip="">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf002;" FontSize="11"/>
              <TextBlock Text="{loc:Str Key=Split_LookUp}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>

        <Grid x:Name="ArtistPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="82"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{loc:Str Key=Details_AlbumArtist}"
                     Style="{StaticResource DenseFieldLabelStyle}"/>
          <TextBox Grid.Column="1" x:Name="AlbumArtistBox"/>
        </Grid>

        <!-- Year and country are short answers, so they get short boxes. A year in a full-width field
             looks like a mistake waiting to happen. -->
        <StackPanel x:Name="YearPanel" Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                    Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{loc:Str Key=Review_ColYear}" Style="{StaticResource DenseFieldLabelStyle}"/>
          <TextBox x:Name="YearBox" MaxLength="4" Width="{StaticResource DenseNarrowWidth}"/>
        </StackPanel>
        <StackPanel x:Name="CountryPanel" Grid.Row="1" Grid.Column="3" Orientation="Horizontal"
                    Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{loc:Str Key=Lookup_Country}" Style="{StaticResource DenseFieldLabelStyle}"/>
          <TextBox x:Name="CountryBox" MaxLength="2" Width="{StaticResource DenseTinyWidth}"/>
        </StackPanel>
      </Grid>

      <!-- The tools that work on the waveform, then the open clean-up tool below them. The waveform is
           the next row. This is where a record is really split. The grid below is for names and for
           typing an exact time. A cut is placed on the waveform, by looking at it. -->
      <StackPanel Grid.Row="2" Spacing="6">

        <!-- The toolbar. Transport and edits are on the left, zoom is on the right, and the readout is
             between them: the cursor's time, and what is selected when something is. -->
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
            <Button x:Name="WavePlayButton" Click="WavePlay_Click" Style="{StaticResource WaveToolStyle}"
                    ToolTipService.ToolTip="{loc:Str Key=Split_ToolPlayTooltip}"
                    AutomationProperties.Name="{loc:Str Key=Split_ToolPlayTooltip}">
              <TextBlock x:Name="WavePlayGlyph" Text="&#xf04b;" FontFamily="{StaticResource Fa}" FontSize="11"/>
            </Button>
            <Border Width="1" Height="18" Background="#22FFFFFF" Margin="4,0"/>
            <Button x:Name="WaveSplitButton" Click="WaveSplit_Click" Style="{StaticResource WaveToolStyle}"
                    ToolTipService.ToolTip="{loc:Str Key=Split_ToolSplitTooltip}"
                    AutomationProperties.Name="{loc:Str Key=Split_ToolSplitTooltip}">
              <TextBlock Text="&#xf0c4;" FontFamily="{StaticResource Fa}" FontSize="11"/>
            </Button>
            <Button x:Name="WaveCombineButton" Click="WaveCombine_Click" Style="{StaticResource WaveToolStyle}"
                    ToolTipService.ToolTip="{loc:Str Key=Split_ToolCombineTooltip}"
                    AutomationProperties.Name="{loc:Str Key=Split_ToolCombineTooltip}">
              <TextBlock Text="&#xf066;" FontFamily="{StaticResource Fa}" FontSize="11"/>
            </Button>
            <Button x:Name="WaveNewTrackButton" Click="WaveNewTrack_Click" Style="{StaticResource WaveToolStyle}"
                    ToolTipService.ToolTip="{loc:Str Key=Split_ToolNewTrackTooltip}"
                    AutomationProperties.Name="{loc:Str Key=Split_ToolNewTrackTooltip}">
              <TextBlock Text="&#xf067;" FontFamily="{StaticResource Fa}" FontSize="11"/>
            </Button>
            <Button x:Name="WaveClearButton" Click="WaveClearMarkers_Click" Style="{StaticResource WaveToolStyle}"
                    ToolTipService.ToolTip="{loc:Str Key=Split_ToolClearMarkersTooltip}"
                    AutomationProperties.Name="{loc:Str Key=Split_ToolClearMarkersTooltip}">
              <TextBlock Text="&#xf12d;" FontFamily="{StaticResource Fa}" FontSize="11"/>
            </Button>
            <Button x:Name="WaveDropButton" Click="WaveDropTrack_Click" Style="{StaticResource WaveToolStyle}"
                    ToolTipService.ToolTip="{loc:Str Key=Split_ToolDropTrackTooltip}"
                    AutomationProperties.Name="{loc:Str Key=Split_ToolDropTrackTooltip}">
              <TextBlock Text="&#xf2ed;" FontFamily="{StaticResource Fa}" FontSize="11"/>
            </Button>
            <Border Width="1" Height="18" Background="#22FFFFFF" Margin="4,0"/>
            <!-- Snap is a plain button that shows its own state. A ToggleButton's checked look is hard
                 to get right under Uno. The lit background here shows the state just as well. -->
            <Button x:Name="WaveSnapButton" Click="WaveSnap_Click" Style="{StaticResource WaveToolStyle}"
                    ToolTipService.ToolTip="{loc:Str Key=Split_ToolSnapTooltip}"
                    AutomationProperties.Name="{loc:Str Key=Split_ToolSnapTooltip}">
              <TextBlock Text="&#xf076;" FontFamily="{StaticResource Fa}" FontSize="11"/>
            </Button>
            <!-- Vinyl only: the clean-up tools, as a menu. Each item opens its tool's panel under this
                 toolbar. The key is lit while any tool is on, so a closed panel still says the cut will
                 be cleaned. The width is cleared in InitRestore. The style's square 30 px is for glyph
                 keys, and this key carries a word. -->
            <Border x:Name="ToolsSeparator" Width="1" Height="18" Background="#22FFFFFF" Margin="4,0"
                    Visibility="Collapsed"/>
            <Button x:Name="ToolsButton" Style="{StaticResource WaveToolStyle}"
                    Visibility="Collapsed" ToolTipService.ToolTip="{loc:Str Key=Split_ToolsTooltip}">
              <!-- A margin, not the button's Padding. WaveToolStyle's template does not read Padding. -->
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="9,0">
                <TextBlock Text="&#xf0d0;" FontFamily="{StaticResource Fa}" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Str Key=Split_ToolsButton}" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBlock Text="&#xf078;" FontFamily="{StaticResource Fa}" FontSize="8" Opacity="0.7"
                           VerticalAlignment="Center"/>
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout x:Name="ToolsFlyout" Placement="BottomEdgeAlignedLeft" Opening="ToolsMenu_Opening"/>
              </Button.Flyout>
            </Button>
          </StackPanel>

          <TextBlock Grid.Column="1" x:Name="WaveReadout" FontSize="11" Foreground="#99FFFFFF"
                     VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0"
                     TextTrimming="CharacterEllipsis"/>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
            <Button x:Name="WaveZoomOutButton" Click="WaveZoomOut_Click" Style="{StaticResource WaveToolStyle}"
                    ToolTipService.ToolTip="{loc:Str Key=Split_ToolZoomOutTooltip}"
                    AutomationProperties.Name="{loc:Str Key=Split_ToolZoomOutTooltip}">
              <TextBlock Text="&#xf010;" FontFamily="{StaticResource Fa}" FontSize="11"/>
            </Button>
            <Button x:Name="WaveZoomInButton" Click="WaveZoomIn_Click" Style="{StaticResource WaveToolStyle}"
                    ToolTipService.ToolTip="{loc:Str Key=Split_ToolZoomInTooltip}"
                    AutomationProperties.Name="{loc:Str Key=Split_ToolZoomInTooltip}">
              <TextBlock Text="&#xf00e;" FontFamily="{StaticResource Fa}" FontSize="11"/>
            </Button>
            <Button x:Name="WaveZoomSelectionButton" Click="WaveZoomSelection_Click" Style="{StaticResource WaveToolStyle}"
                    ToolTipService.ToolTip="{loc:Str Key=Split_ToolZoomSelectionTooltip}"
                    AutomationProperties.Name="{loc:Str Key=Split_ToolZoomSelectionTooltip}">
              <TextBlock Text="&#xf31e;" FontFamily="{StaticResource Fa}" FontSize="11"/>
            </Button>
            <Button x:Name="WaveZoomFitButton" Click="WaveZoomFit_Click" Style="{StaticResource WaveToolStyle}"
                    ToolTipService.ToolTip="{loc:Str Key=Split_ToolZoomFitTooltip}"
                    AutomationProperties.Name="{loc:Str Key=Split_ToolZoomFitTooltip}">
              <TextBlock Text="&#xf065;" FontFamily="{StaticResource Fa}" FontSize="11"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- ── TOOLS ── Vinyl only: noise reduction, click removal, and bass and treble. They open from
             the Tools menu on the toolbar above. Only one tool is open at a time, and none is open at
             the start, so the waveform keeps its height until a tool is asked for. Noise reduction has
             four numbered steps, because the order matters. The other two are one switch and two
             sliders. All three work with their default settings, and the sliders are under Show
             advanced. The noise profile is measured from the selection on the waveform below. That is
             why the panel sits directly above it.

             No slider here has a Value or a ValueChanged in the markup. Both raise ValueChanged during
             InitializeComponent, before the handlers' TextBlocks exist. WinUI reports that as a failure
             to assign to RangeBase.Value. A Minimum above the control's default of 0 also moves the
             value, so the same failure shows up for RangeBase.Minimum. RenderRestore sets every
             slider's value, and InitRestore wires the handlers after the tree exists. -->
        <Border x:Name="RestorePanel" Visibility="Collapsed"
                Background="#14FFFFFF" CornerRadius="6" BorderBrush="#22FFFFFF" BorderThickness="1"
                Padding="12,8,8,10">
          <StackPanel Spacing="8">

            <!-- The open tool's name, the advanced switch and the close button. -->
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ToolGlyph" Grid.Column="0" FontFamily="{StaticResource Fa}" FontSize="12"
                         Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
              <TextBlock x:Name="ToolTitle" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                         Foreground="#F2FFFFFF" VerticalAlignment="Center"/>
              <!-- The chevron and the word are set in RenderTools. It reads Show with a down chevron
                   while the sliders are hidden, and Hide with an up chevron while they are shown. -->
              <Button x:Name="AdvancedButton" Grid.Column="2" Click="Advanced_Click"
                      Style="{StaticResource DenseButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock x:Name="AdvancedGlyph" FontFamily="{StaticResource Fa}" FontSize="9"
                             VerticalAlignment="Center"/>
                  <TextBlock x:Name="AdvancedText" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="CloseToolButton" Grid.Column="3" Click="CloseTool_Click"
                      Style="{StaticResource WaveToolStyle}" Width="24" Height="24"
                      VerticalAlignment="Center"
                      ToolTipService.ToolTip="{loc:Str Key=Split_ToolClose}"
                      AutomationProperties.Name="{loc:Str Key=Split_ToolClose}">
                <TextBlock Text="&#xf00d;" FontFamily="{StaticResource Fa}" FontSize="11"/>
              </Button>
            </Grid>

            <!-- ── Noise reduction ── select a quiet part, take a profile of it, and turn the gate on. -->
            <StackPanel x:Name="NoiseTool" Spacing="6" Visibility="Collapsed">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="170"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ctl:StepBadge x:Name="NoiseSelectBadge" Grid.Column="0" Step="1"/>
                <TextBlock Grid.Column="1" Text="{loc:Str Key=Split_StepSelectQuiet}"
                           Style="{StaticResource StepTitleStyle}"/>
                <Button x:Name="SelectGapButton" Grid.Column="2" Click="SelectGap_Click"
                        Style="{StaticResource DenseButtonStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="&#xf05b;" FontFamily="{StaticResource Fa}" FontSize="10"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Str Key=Split_SelectGap}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <TextBlock x:Name="SelectQuietNote" Grid.Column="3" Style="{StaticResource StepNoteStyle}"/>
              </Grid>

              <Grid x:Name="NoiseProfileStep" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="170"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ctl:StepBadge x:Name="NoiseProfileBadge" Grid.Column="0" Step="2"/>
                <TextBlock Grid.Column="1" Text="{loc:Str Key=Split_StepTakeProfile}"
                           Style="{StaticResource StepTitleStyle}"/>
                <Button x:Name="TakeProfileButton" Grid.Column="2" Click="TakeProfile_Click"
                        Style="{StaticResource DenseButtonStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="&#xf1fb;" FontFamily="{StaticResource Fa}" FontSize="10"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Str Key=Split_TakeProfile}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <TextBlock x:Name="ProfileStatusText" Grid.Column="3" Style="{StaticResource StepNoteStyle}"/>
              </Grid>

              <Grid x:Name="NoiseOnStep" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="170"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ctl:StepBadge x:Name="NoiseOnBadge" Grid.Column="0" Step="3"/>
                <TextBlock Grid.Column="1" Text="{loc:Str Key=Split_StepTurnOn}"
                           Style="{StaticResource StepTitleStyle}"/>
                <CheckBox x:Name="NoiseCheck" Grid.Column="2" Content="{loc:Str Key=Split_NoiseOn}"
                          Click="Noise_Click" FontSize="11.5" Foreground="#CCFFFFFF"
                          MinWidth="0" MinHeight="0" VerticalAlignment="Center"
                          Padding="8,0,0,0" VerticalContentAlignment="Center"/>
              </Grid>
            </StackPanel>

            <!-- ── Click removal ── needs nothing measured first, so it is one switch, with no numbered
                 steps. -->
            <Grid x:Name="ClickTool" ColumnSpacing="12" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <!-- Top padding is off and the label is centred. The template's padding is set for 14 pt
                   text, and it leaves 11.5 pt text sitting below the middle of the box. -->
              <CheckBox x:Name="DeclickCheck" Grid.Column="0" Content="{loc:Str Key=Split_DeclickOn}"
                        Click="Declick_Click" FontSize="11.5" Foreground="#CCFFFFFF"
                        MinWidth="0" MinHeight="0" VerticalAlignment="Center"
                        Padding="8,0,0,0" VerticalContentAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{loc:Str Key=Split_DeclickNote}"
                         Style="{StaticResource StepNoteStyle}"/>
            </Grid>

            <!-- ── Bass and treble ── two sliders, with no numbered steps. They come last in the chain
                 on purpose: de-click, then the gate, then these (see RestoreChain). Lifting the top end
                 before the gate gives it a signal that its profile does not describe, so the hiss reads
                 as music and survives.

                 They are here as well as in the record window, because a recorded session cannot reach
                 that window again. That window makes a new session folder every time it opens. Both
                 places use the same restore.json and the same two numbers. This is the screen where the
                 result is heard. -->
            <StackPanel x:Name="ToneTool" Spacing="4" Visibility="Collapsed">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56"/>
                  <ColumnDefinition Width="*" MaxWidth="320"/>
                  <ColumnDefinition Width="50"/>
                  <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Key=Vinyl_ToneBass}"
                           Style="{StaticResource DenseFieldLabelStyle}" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="BassSlider" Minimum="-12" Maximum="12"
                        StepFrequency="0.5" Style="{StaticResource SlimSliderStyle}"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="BassValueText" FontSize="11.5"
                           Foreground="{StaticResource DenseValueInkBrush}" TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="3" x:Name="ToneResetButton" Click="ToneReset_Click"
                        Style="{StaticResource ResetKeyStyle}"
                        ToolTipService.ToolTip="{loc:Str Key=Split_ResetDefaults}"
                        AutomationProperties.Name="{loc:Str Key=Split_ResetDefaults}">
                  <TextBlock Text="&#xf0e2;" FontFamily="{StaticResource Fa}" FontSize="10"/>
                </Button>
              </Grid>
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56"/>
                  <ColumnDefinition Width="*" MaxWidth="320"/>
                  <ColumnDefinition Width="50"/>
                  <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Key=Vinyl_ToneTreble}"
                           Style="{StaticResource DenseFieldLabelStyle}" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="TrebleSlider" Minimum="-12" Maximum="12"
                        StepFrequency="0.5" Style="{StaticResource SlimSliderStyle}"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="TrebleValueText" FontSize="11.5"
                           Foreground="{StaticResource DenseValueInkBrush}" TextAlignment="Right"
                           VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="{loc:Str Key=Split_ToneNote}" Style="{StaticResource StepNoteStyle}"/>
            </StackPanel>

            <!-- ── Listen ── shared by every tool. There is one Play button, and a switch between the
                 recording as it is and the recording with every tool that is on applied, as the cut
                 will use it. Flipping the switch while it plays swaps the sound at the same point, so
                 the two can be compared directly. While no tool is on there is nothing to compare, so
                 Play and the switch are disabled. Play stays usable as Stop while something plays. The
                 selection can still be heard as it is, from the waveform toolbar's play key.

                 Under noise reduction this is step 4, Listen. Its number and name wait, dimmed, until
                 noise reduction is on. The other tools have no steps, so for them the number and name
                 are collapsed.

                 Margins are used instead of ColumnSpacing. A collapsed number and name then take no
                 room. When they are shown, the controls line up with the step rows above (20 + 10 + 170
                 + 10).

                 There is no IsOn and no Toggled in the markup. Setting IsOn raises Toggled, the same
                 trap as the sliders' Value. RenderTools sets it, and InitRestore wires it. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ctl:StepBadge x:Name="ListenBadge" Grid.Column="0" Step="4" Margin="0,0,10,0"/>
              <TextBlock x:Name="ListenTitle" Grid.Column="1" Width="170" Margin="0,0,10,0"
                         Text="{loc:Str Key=Split_StepListen}" Style="{StaticResource StepTitleStyle}"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14">
                <Button x:Name="ListenPlayButton" Click="ListenPlay_Click" MinWidth="72"
                        Style="{StaticResource DenseButtonStyle}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="ListenPlayGlyph" Text="&#xf04b;" FontFamily="{StaticResource Fa}"
                               FontSize="9" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ListenPlayText" Text="{loc:Str Key=Split_ListenPlay}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <!-- The two words are part of the switch. Either one sets it. -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock x:Name="ListenOriginalLabel" Text="{loc:Str Key=Split_ListenOriginal}"
                             FontSize="11.5" VerticalAlignment="Center" Tapped="ListenOriginal_Tapped"/>
                  <ToggleSwitch x:Name="ListenSwitch" OnContent="" OffContent="" MinWidth="0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{loc:Str Key=Split_ListenSwitchTooltip}"/>
                  <TextBlock x:Name="ListenChangesLabel" Text="{loc:Str Key=Split_ListenWithChanges}"
                             FontSize="11.5" VerticalAlignment="Center" Tapped="ListenChanges_Tapped"/>
                </StackPanel>
              </StackPanel>
              <TextBlock x:Name="ListenNote" Grid.Column="3" Margin="14,0,0,0"
                         Style="{StaticResource StepNoteStyle}"/>
            </Grid>

            <!-- ── Advanced, noise reduction ── the gate's three knobs. The defaults are the ones
                 Audacity opens with (NoiseReductionSettings), which suit most records. -->
            <Border x:Name="NoiseAdvanced" Visibility="Collapsed"
                    BorderBrush="{StaticResource DenseRuleBrush}" BorderThickness="0,1,0,0"
                    Padding="30,8,0,0">
              <StackPanel Spacing="4">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="*" MaxWidth="300"/>
                  <ColumnDefinition Width="50"/>
                  <ColumnDefinition Width="24"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Key=Split_NoiseReduction}"
                           Style="{StaticResource DenseFieldLabelStyle}" HorizontalAlignment="Left"/>
                <Slider Grid.Column="1" x:Name="ReductionSlider" Minimum="0" Maximum="30"
                        StepFrequency="1" Style="{StaticResource SlimSliderStyle}"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="ReductionValueText" FontSize="11.5"
                           Foreground="{StaticResource DenseValueInkBrush}" TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="3" x:Name="NoiseResetButton" Click="NoiseReset_Click"
                        Style="{StaticResource ResetKeyStyle}"
                        ToolTipService.ToolTip="{loc:Str Key=Split_ResetDefaults}"
                        AutomationProperties.Name="{loc:Str Key=Split_ResetDefaults}">
                  <TextBlock Text="&#xf0e2;" FontFamily="{StaticResource Fa}" FontSize="10"/>
                </Button>
                <TextBlock Grid.Column="4" Text="{loc:Str Key=Split_NoiseReductionNote}"
                           Style="{StaticResource StepNoteStyle}"/>
              </Grid>
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="*" MaxWidth="300"/>
                  <ColumnDefinition Width="50"/>
                  <ColumnDefinition Width="24"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Key=Split_NoiseSensitivity}"
                           Style="{StaticResource DenseFieldLabelStyle}" HorizontalAlignment="Left"/>
                <Slider Grid.Column="1" x:Name="SensitivitySlider" Minimum="0" Maximum="12"
                        StepFrequency="0.5" Style="{StaticResource SlimSliderStyle}"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="SensitivityValueText" FontSize="11.5"
                           Foreground="{StaticResource DenseValueInkBrush}" TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{loc:Str Key=Split_NoiseSensitivityNote}"
                           Style="{StaticResource StepNoteStyle}"/>
              </Grid>
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="*" MaxWidth="300"/>
                  <ColumnDefinition Width="50"/>
                  <ColumnDefinition Width="24"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Key=Split_NoiseSmoothing}"
                           Style="{StaticResource DenseFieldLabelStyle}" HorizontalAlignment="Left"/>
                <Slider Grid.Column="1" x:Name="SmoothingSlider" Minimum="0" Maximum="6"
                        StepFrequency="1" Style="{StaticResource SlimSliderStyle}"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="SmoothingValueText" FontSize="11.5"
                           Foreground="{StaticResource DenseValueInkBrush}" TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{loc:Str Key=Split_NoiseSmoothingNote}"
                           Style="{StaticResource StepNoteStyle}"/>
              </Grid>
              </StackPanel>
            </Border>

            <!-- ── Advanced, click removal ── how hard it looks for clicks. The slider is the threshold
                 turned round, so moving right finds more clicks. The stored value is 20 minus the
                 slider's threshold, which keeps the number on the scale that ClickRepair reads. On two
                 test records, a threshold of 10 removed every click and rebuilt 1.4% of the side. A
                 threshold of 16 removed most of them and rebuilt 0.5%. Below 6, the repair starts to
                 treat the music's own transients as damage. That is why the strong end stops there. -->
            <Border x:Name="ClickAdvanced" Visibility="Collapsed"
                    BorderBrush="{StaticResource DenseRuleBrush}" BorderThickness="0,1,0,0"
                    Padding="0,8,0,0">
              <StackPanel Spacing="4">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*" MaxWidth="240"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="24"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Key=Split_DeclickStrength}"
                           Style="{StaticResource DenseFieldLabelStyle}" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="1" Text="{loc:Str Key=Split_DeclickGentle}"
                           Style="{StaticResource StepNoteStyle}"/>
                <Slider Grid.Column="2" x:Name="DeclickSlider" Minimum="0" Maximum="14"
                        StepFrequency="0.5" Style="{StaticResource SlimSliderStyle}"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{loc:Str Key=Split_DeclickStrong}"
                           Style="{StaticResource StepNoteStyle}"/>
                <Button Grid.Column="4" x:Name="ClickResetButton" Click="ClickReset_Click"
                        Style="{StaticResource ResetKeyStyle}"
                        ToolTipService.ToolTip="{loc:Str Key=Split_ResetDefaults}"
                        AutomationProperties.Name="{loc:Str Key=Split_ResetDefaults}">
                  <TextBlock Text="&#xf0e2;" FontFamily="{StaticResource Fa}" FontSize="10"/>
                </Button>
                <TextBlock Grid.Column="5" Text="{loc:Str Key=Split_DeclickStrengthNote}"
                           Style="{StaticResource StepNoteStyle}"/>
              </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Grid.Row="3" Background="#06121A" CornerRadius="4" BorderBrush="#12242F" BorderThickness="1"
              Padding="1">
        <dlgc:WaveformEditor x:Name="Wave"/>
      </Border>

      <!-- Drag the waveform taller when placing a cut, and shorter when typing names. -->
      <ctl:RowSplitter Grid.Row="4" Height="10" Background="Transparent" HorizontalAlignment="Stretch"
                       PointerPressed="WaveSplitter_PointerPressed" PointerMoved="WaveSplitter_PointerMoved"
                       PointerReleased="WaveSplitter_PointerReleased"
                       PointerCaptureLost="WaveSplitter_PointerReleased">
        <Rectangle Height="4" Width="46" RadiusX="2" RadiusY="2" Fill="#33FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </ctl:RowSplitter>

      <!-- Track grid -->
      <Grid Grid.Row="5" RowSpacing="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header labels sit at the bottom. They line up with the select-all checkbox, and sit the
             usual label distance above the input rows, as Album and Year do at the top. -->
        <Grid Grid.Row="0" ColumnSpacing="8" Margin="8,0,20,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition x:Name="HeaderAlbumCol" Width="92"/>
            <ColumnDefinition Width="18"/>
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0" x:Name="SelectAllBox" Click="SelectAll_Click" MinWidth="0" MinHeight="0"
                    VerticalAlignment="Bottom" ToolTipService.ToolTip="{loc:Str Key=Split_SelectAllTooltip}"/>
          <TextBlock Grid.Column="1" Text="#" FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}" VerticalAlignment="Bottom"/>
          <TextBlock Grid.Column="3" Text="{loc:Str Key=Review_ColTitle}" FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}" VerticalAlignment="Bottom"/>
          <TextBlock Grid.Column="4" Text="{loc:Str Key=Review_ColArtist}" FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}" VerticalAlignment="Bottom"/>
          <TextBlock Grid.Column="5" Text="{loc:Str Key=Split_ColStart}" FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}" VerticalAlignment="Bottom"/>
          <TextBlock Grid.Column="6" Text="{loc:Str Key=Split_ColEnd}" FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}" VerticalAlignment="Bottom"/>
          <TextBlock Grid.Column="7" x:Name="HeaderAlbumLabel" Text="{loc:Str Key=Split_ColAlbumHint}"
                     FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}" VerticalAlignment="Bottom"/>
        </Grid>
        <!-- An ItemsControl, on purpose, not a ListView.

             These rows are editable forms, not a list to pick from. They hold text boxes, a tick and a
             play button. There are tens of them, not thousands. A ListView virtualises: it RECYCLES row
             containers as the collection changes. A recycled container that keeps part of what it
             showed before is a fault this screen has had twice: a row that played the wrong track
             after a re-detect, and a row left without its number and its play button after tracks were
             deleted. An ItemsControl makes one container per item and destroys it with the item, so
             there is nothing to recycle. The scrolling is the ScrollViewer's job, and it is set
             explicitly here. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                      Padding="0,0,12,0">
          <ItemsControl x:Name="TrackList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:SplitTrackVm">
              <!-- The row lights up when its stretch of the waveform is the current one. Touching
                   anything in the row makes it current. So the grid and the picture always agree on
                   which track is being worked on. -->
              <Grid ColumnSpacing="8" Background="{Binding RowBrush}" Padding="4,1" Margin="8,1"
                    CornerRadius="3"
                    PointerPressed="Row_PointerPressed" GotFocus="Row_GotFocus">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28"/>
                  <ColumnDefinition Width="24"/>
                  <ColumnDefinition Width="32"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="0.7*"/>
                  <ColumnDefinition Width="60"/>
                  <ColumnDefinition Width="60"/>
                  <ColumnDefinition Width="{x:Bind AlbumColWidth, Mode=OneWay}"/>
                  <ColumnDefinition Width="18"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="0"
                          MinHeight="0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding NumberText}" FontSize="11.5" Foreground="#CCFFFFFF"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="5,0"
                        MinWidth="0" MinHeight="0" Click="Preview_Click" ToolTipService.ToolTip="{Binding PlayTooltip}" AutomationProperties.Name="{Binding PlayTooltip}"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding PlayGlyph}" FontSize="11" Foreground="#CCFFFFFF"
                             FontFamily="{StaticResource Fa}"/>
                </Button>
                <TextBox Grid.Column="3" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>
                <TextBox Grid.Column="4" Text="{Binding Artist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>
                <TextBox Grid.Column="5" Text="{Binding StartText, Mode=OneWay}" Tag="start"
                         LostFocus="Start_Commit" KeyDown="TimeBox_KeyDown"
                         VerticalAlignment="Center"/>
                <TextBox Grid.Column="6" Text="{Binding EndText, Mode=OneWay}" Tag="end"
                         LostFocus="End_Commit" KeyDown="TimeBox_KeyDown"
                         VerticalAlignment="Center"/>

                <!-- Album hint: the release's length for this track, and the button that snaps the row
                     to it. Blank when no release is adopted. -->
                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Button Padding="3,0" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                          Click="ApplyHint_Click"
                          Visibility="{Binding ApplyHintVisibility}" VerticalAlignment="Center"
                          ToolTipService.ToolTip="{loc:Str Key=Split_ApplyTimingTooltip}"
                          AutomationProperties.Name="{loc:Str Key=Split_ApplyTimingTooltip}">
                    <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf061;" FontSize="10" Foreground="#99FFFFFF"/>
                  </Button>
                  <TextBlock Text="{Binding AlbumHintText}" FontSize="11.5" Foreground="#88FFFFFF"
                             VerticalAlignment="Center"
                             ToolTipService.ToolTip="{loc:Str Key=Split_AlbumHintTooltip}"/>
                </StackPanel>

                <Ellipse Grid.Column="8" Width="8" Height="8" Fill="{Binding SourceBrush}"
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         ToolTipService.ToolTip="{Binding SourceTooltip}"/>
              </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- The status line and the dot legend, on the right at the well's edge. The wait itself is not
           here. It is the record turning over the middle of the card, below. -->
      <Grid Grid.Row="6" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="StatusText" FontSize="11.5"
                   Foreground="{StaticResource DenseLabelInkBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <ItemsControl Grid.Column="1" x:Name="LegendList" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:LegendEntry">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{Binding Dot}"/>
                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#88FFFFFF"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <!-- The wait, over the whole card. Detection reads the file and the catalogues, and it leaves
           both panes with nothing in them. So the mark belongs in the middle, where the user is already
           looking, not in a corner. It does not hit-test, and it hides itself when it stops turning. -->
      <!-- Dims the body while the record turns. The wait then reads as a wait, and the spinner stands
           out from the panes behind it. It uses the same black as the dialog's own backdrop. It does
           not hit-test, so edits during a recognition run are allowed. They go to the track by identity
           (see RecognizeSelectedAsync). It is shown and hidden with the spinner, in SetBusy. -->
      <Border x:Name="BusyDim" Grid.Row="0" Grid.RowSpan="7" Background="#66000000" CornerRadius="4"
              IsHitTestVisible="False" Visibility="Collapsed"/>
      <ctl:RecordSpinner x:Name="BusySpinner" Grid.Row="0" Grid.RowSpan="7"
                         Width="64" Height="64"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

    <ctl:ResizableDialogShell.FooterLeading>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- Both glass keys carry their mark to the left of the word, at the size and spacing the other
             dialogs' footers use. So this footer looks like the same row of buttons they have. -->
        <Button x:Name="CancelButton" Click="Cancel_Click"
                Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="RedetectButton" Click="Redetect_Click"
                Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- The redo arrow. This runs the detection that has already run, again. The scissors
                 belong to Split, which is the button that actually cuts. -->
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf01e;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Split_Redetect}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ctl:RpmPrimaryButton x:Name="RecognizeButton" Click="RecognizeSelected_Click" IsEnabled="False"
                        Padding="16,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf577;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Split_RecognizeSelected}" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </ctl:ResizableDialogShell.FooterLeading>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <!-- Vinyl only. A recording has no format of its own yet, so the format is chosen here, at the
             cut. It sits inline with Split, no taller than the button, with the label to the left. -->
        <StackPanel x:Name="FormatPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    Visibility="Collapsed">
          <TextBlock Text="{loc:Str Key=Split_FormatLabel}" FontSize="11.5" Foreground="#CCFFFFFF"
                     VerticalAlignment="Center"/>
          <ComboBox x:Name="FormatCombo" SelectedIndex="0" MinWidth="150" VerticalAlignment="Center">
            <ComboBoxItem Content="{loc:Str Key=AddMusic_FormatFlac}"/>
            <ComboBoxItem Content="{loc:Str Key=AddMusic_FormatAlac}"/>
            <ComboBoxItem Content="{loc:Str Key=AddMusic_FormatMp3}"/>
          </ComboBox>
        </StackPanel>
        <ctl:RpmPrimaryButton x:Name="SplitButton" Click="Split_Click" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- Scissors on the button that cuts. The chevron, on the far side of the word, shows that
                 it is the way on. The scissors say what happens. -->
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0c4;" FontSize="11"
                      Foreground="#F5FFFFFF" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Split_Split}" FontWeight="Bold" VerticalAlignment="Center"/>
            <!-- No colour of its own. The chevron is part of the word, so it takes the button's text
                 colour and does not sit on the fill in a second green. -->
            <TextBlock Text="&#x276F;" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
