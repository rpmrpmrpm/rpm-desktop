<UserControl x:Class="RPM.Desktop.Presentation.Dialogs.Controls.PeakMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:RPM.Desktop.Strings">

  <StackPanel Spacing="6">
    <!-- L / R level bars. The fill and peak-hold marker are sized in code from the track width. -->
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{loc:Str Key=Meter_Left}" FontSize="11" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
      <Border x:Name="LTrack" Grid.Column="1" Height="14" CornerRadius="3" Background="#22FFFFFF">
        <Grid>
          <Rectangle x:Name="LFill" HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                     Fill="#04C8FF" Width="0"/>
          <Rectangle x:Name="LPeak" HorizontalAlignment="Left" Width="2" Fill="#F2FFFFFF"/>
        </Grid>
      </Border>
      <Border x:Name="LClip" Grid.Column="2" Width="10" Height="10" CornerRadius="5"
              Background="#33FFFFFF" VerticalAlignment="Center"/>
    </Grid>

    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{loc:Str Key=Meter_Right}" FontSize="11" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
      <Border x:Name="RTrack" Grid.Column="1" Height="14" CornerRadius="3" Background="#22FFFFFF">
        <Grid>
          <Rectangle x:Name="RFill" HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                     Fill="#04C8FF" Width="0"/>
          <Rectangle x:Name="RPeak" HorizontalAlignment="Left" Width="2" Fill="#F2FFFFFF"/>
        </Grid>
      </Border>
      <Border x:Name="RClip" Grid.Column="2" Width="10" Height="10" CornerRadius="5"
              Background="#33FFFFFF" VerticalAlignment="Center"/>
    </Grid>

    <!-- dBFS scale under the bars. -->
    <Grid Grid.Column="1" Margin="24,0,14,0">
      <TextBlock Text="-60" FontSize="9" Foreground="#66FFFFFF" HorizontalAlignment="Left"/>
      <TextBlock Text="-24" FontSize="9" Foreground="#66FFFFFF" HorizontalAlignment="Center"/>
      <TextBlock Text="-6" FontSize="9" Foreground="#66FFFFFF" HorizontalAlignment="Right" Margin="0,0,40,0"/>
      <TextBlock Text="0" FontSize="9" Foreground="#66FFFFFF" HorizontalAlignment="Right"/>
    </Grid>
  </StackPanel>
</UserControl>
