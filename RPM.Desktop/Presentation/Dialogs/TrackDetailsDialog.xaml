<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.TrackDetailsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
        <!-- The data-entry form sizing: 24 px inputs and 12 pt text. It is merged here, not app-wide,
             so that only the form windows get smaller. -->
        <ResourceDictionary Source="ms-appx:///Themes/DenseForm.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- The dialog scrim is lighter than the framework default. The dialog card is translucent,
               so the artwork behind it shows through the dim instead of being blacked out. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- The dialog scrim is lighter than the framework default. The dialog card is translucent,
               so the artwork behind it shows through the dim instead of being blacked out. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <!-- The body does its own vertical layout, because its tabs need different things. The lyrics and the
       artwork fill the card to whatever height it is dragged to. A scrolling body would measure them
       against infinity and collapse them to one line. The three form tabs are long enough to need a
       scroller, so each of them has its own. The shell's scroller stays off.

       Each form scroller puts the bar's space in PADDING, not margin. A ScrollViewer draws its bar at
       its own right edge, outside its padding. As a margin, the bar would sit on top of the inputs at
       the far right. As padding, the content stops short of it. Same reasoning as the shell's own body
       scroller. -->
  <ctl:ResizableDialogShell x:Name="Shell" Title="{loc:Str Key=Details_Title}" TitleGlyph="&#xf001;"
                            ScrollBody="False">

    <Grid RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Tab chips, and the release lookup beside them. The lookup fills this window's boxes, as it
           does in the mass edit, so it belongs to the whole form and not to one tab. It is hidden when
           the caller has no catalogue to offer. -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- The tab strip: the left pane's function rail laid on its side. It is built in code, so the
             three metadata editors share one. See RailTabStrip, which also decides which panel is
             shown. -->
        <Border x:Name="TabStripHost" Grid.Column="0" HorizontalAlignment="Left"/>

        <!-- Aligned to the top, so it lines up with the top edge of the tab strip. -->
        <Button x:Name="LookupButton" Grid.Column="1" Click="LookUpRelease_Click"
                Style="{StaticResource DenseButtonStyle}" Padding="12,0" Visibility="Collapsed"
                VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- The release lookup's own search glyph, so the button wears the icon of the window it
                 opens. -->
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf002;" FontSize="11"/>
            <TextBlock Text="{loc:Str Key=MassEdit_LookUpRelease}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- Basic: the fields are built in code into two columns, grouped by topic. -->
      <ScrollViewer x:Name="PanelBasic" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" Padding="0,0,14,0">
        <Grid ColumnSpacing="{StaticResource DenseColumnSpacing}" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="BasicLeft"  Grid.Column="0" Spacing="{StaticResource DenseGroupSpacing}"/>
          <StackPanel x:Name="BasicRight" Grid.Column="1" Spacing="{StaticResource DenseGroupSpacing}"/>
        </Grid>
      </ScrollViewer>

      <!-- Credits & publishing -->
      <ScrollViewer x:Name="PanelCredits" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" Padding="0,0,14,0" Visibility="Collapsed">
        <Grid ColumnSpacing="{StaticResource DenseColumnSpacing}" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="CreditsLeft"  Grid.Column="0" Spacing="{StaticResource DenseGroupSpacing}"/>
          <StackPanel x:Name="CreditsRight" Grid.Column="1" Spacing="{StaticResource DenseGroupSpacing}"/>
        </Grid>
      </ScrollViewer>

      <!-- Work, sorting, pressing, identifiers -->
      <ScrollViewer x:Name="PanelWork" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" Padding="0,0,14,0" Visibility="Collapsed">
        <Grid ColumnSpacing="{StaticResource DenseColumnSpacing}" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="WorkLeft"  Grid.Column="0" Spacing="{StaticResource DenseGroupSpacing}"/>
          <StackPanel x:Name="WorkRight" Grid.Column="1" Spacing="{StaticResource DenseGroupSpacing}"/>
        </Grid>
      </ScrollViewer>

      <!-- Sound: what the app measured from the audio itself, as against what anybody wrote on the
           sleeve. The two editable fields (tempo and key) are tags like any other. Everything beside
           them is a reading, shown so that the numbers in the boxes can be judged rather than guessed
           at. -->
      <ScrollViewer x:Name="PanelSound" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" Padding="0,0,14,0" Visibility="Collapsed">
        <Grid ColumnSpacing="{StaticResource DenseColumnSpacing}" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="SoundLeft"  Grid.Column="0" Spacing="{StaticResource DenseGroupSpacing}"/>
          <StackPanel x:Name="SoundRight" Grid.Column="1" Spacing="{StaticResource DenseGroupSpacing}"/>
        </Grid>
      </ScrollViewer>

      <!-- Lyrics -->
      <Grid x:Name="PanelLyrics" Grid.Row="1" Visibility="Collapsed">
        <TextBox x:Name="LyricsBox" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PlaceholderText="{loc:Str Key=Details_LyricsPlaceholder}"/>
      </Grid>

      <!-- Artwork: the record's two pictures, side by side and edited in the same way. The first is the
           sleeve, which goes inside every file. The second is the label printed on the disc. It cannot
           live in a tag, so it is written beside the tracks as disc.png. The disc half is hidden where
           there is no album folder to put it in, such as a queue row before it is imported. -->
      <!-- The tab is a scroller, like the form tabs. A fill tab cannot be scrolled, because there is
           nothing to scroll to. The picture is a fixed square, so the tab has a real height and a short
           window can reach its bottom. -->
      <ScrollViewer x:Name="PanelArt" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" Padding="0,0,14,0" Visibility="Collapsed">

        <!-- COVER: the only picture at this level. The disc's printed label is the album folder's
             disc.png. It has no meaning per track, so it is edited in the album editor. The layout
             matches the album editor's picture pane: a column as wide as the square, holding the
             square, a caption, then the actions. The size is set in code from the same number as the
             well. -->
        <Grid x:Name="ArtPane" RowSpacing="6" VerticalAlignment="Top" HorizontalAlignment="Left">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Str Key=Details_GroupCover}" Style="{StaticResource DenseGroupHeaderStyle}"/>
            <Border Height="1" Background="{StaticResource DenseRuleBrush}" Margin="0,3,0,8"/>
          </StackPanel>
          <!-- The album editor's picture square. It is built in code, so both windows use the same
               object: a dark rounded well, the record glyph while it is empty, the picture clipped to
               the same corner, and a hairline edge around it. See PictureWell. -->
          <Border x:Name="ArtWellHost" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          <TextBlock x:Name="ArtInfoText" Grid.Row="2" FontSize="11"
                     Foreground="{StaticResource DenseLabelInkBrush}"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          <!-- Change and Remove, side by side in that order. This matches the album editor's pair,
               because it is the same decision in both windows. -->
          <Grid Grid.Row="3" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="ChangeArt_Click"
                    Style="{StaticResource DenseButtonStyle}" HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <!-- image: pick a picture. -->
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf03e;" FontSize="11"/>
                <TextBlock Text="{loc:Str Key=Details_ChangeArt}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="1" x:Name="RemoveArtButton" Click="RemoveArt_Click"
                    Style="{StaticResource DenseButtonStyle}" HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <!-- Trash icon. Plain white, like its neighbour. The glyph already says what the button
                     does. The pair reads as two equal choices, not as one of them marked as a warning. -->
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf2ed;" FontSize="11"/>
                <TextBlock Text="{loc:Str Key=Details_RemoveArt}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock Grid.Row="4" Text="{loc:Str Key=Details_ArtHint}" FontSize="11"
                     Foreground="#66FFFFFF" TextWrapping="Wrap"/>
        </Grid>

      </ScrollViewer>
    </Grid>

    <!-- The file being edited, shown beside the buttons. It is not in the header band: that band is a
         display face over a photograph, and a file name is hard to read on it. The header carries the
         window's own name and nothing else. -->
    <ctl:ResizableDialogShell.FooterLeading>
      <TextBlock x:Name="FileNameText" FontSize="11.5" Foreground="#8CFFFFFF" MaxWidth="420"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </ctl:ResizableDialogShell.FooterLeading>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Click="Cancel_Click" Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ctl:RpmPrimaryButton Click="Save_Click" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0c7;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Details_Save}" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
