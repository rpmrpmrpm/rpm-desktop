<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.AddMusicDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:dlg="using:RPM.Desktop.Presentation.Dialogs"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <!-- The ContentDialog is only a transparent full-screen scrim. The visible card is the Border in
       the shell, which sets its own size and chrome. These theme resources must be set again in
       each dialog, because on Uno they do not pass through merged dictionaries. -->
  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
        <!-- The standard sizing for data-entry forms (24 px inputs, 12 pt text). This window is a
             chooser, not a form, but its list uses the same size as the rest of the import path. -->
        <ResourceDictionary Source="ms-appx:///Themes/DenseForm.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground"
              Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush"
              Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill"
              Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground"
              Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush"
              Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill"
              Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <!-- ScrollBody is off. The pending list fills the card to whatever height it is dragged to. A
       scrolling body would measure it against infinity and collapse it to one line. -->
  <ctl:ResizableDialogShell x:Name="Shell"
      Title="{loc:Str Key=AddMusic_Title}"
      TitleGlyph="&#xf067;"
                            ScrollBody="False">

    <ctl:ResizableDialogShell.FooterLeading>
      <ctl:RpmPrimaryButton x:Name="BackButton"
          Click="Back_Click"
          Padding="16,0"
          Visibility="Collapsed"
                            Background="{StaticResource GlassGhostFaceBrush}"
          Foreground="#F0FFFFFF"
          BorderBrush="#22FFFFFF">
        <StackPanel Orientation="Horizontal"
            Spacing="8">
          <TextBlock Text="&#x276E;"
              FontSize="12"
              FontWeight="Bold"
              VerticalAlignment="Center"/>
          <TextBlock Text="{loc:Str Key=AddMusic_Back}"
              VerticalAlignment="Center"/>
        </StackPanel>
      </ctl:RpmPrimaryButton>
    </ctl:ResizableDialogShell.FooterLeading>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Orientation="Horizontal"
          Spacing="10">
        <Button Click="Cancel_Click"
                Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <!-- Only the pending list needs a Next button. On the source screen each card is the
             choice. -->
        <ctl:RpmPrimaryButton x:Name="ImportButton"
            Click="Import_Click"
            IsEnabled="False"
            Padding="18,0"
                              Visibility="Collapsed">
          <StackPanel Orientation="Horizontal"
              Spacing="8">
            <!-- file-import: take what is already ripped into the library -->
            <FontIcon Style="{StaticResource FaIcon}"
                Glyph="&#xf56f;"
                FontSize="11"
                      Foreground="#F5FFFFFF"
                VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=AddMusic_PendingImport}"
                VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>

    <Grid>

      <!-- Source: where the music is coming from. Each card is the whole choice. A folder opens a
           picker and closes this window. A disc or a record opens its own window, because two
           ContentDialogs cannot be stacked. The pending list is the one branch that stays here. -->
      <Grid x:Name="SourceFace">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SourceKicker"
            Grid.Row="0"
            Text="{loc:Str Key=AddMusic_SourceKicker}"
                   Style="{StaticResource DenseGroupHeaderStyle}"/>
        <Border Grid.Row="1"
            Height="1"
            Background="{StaticResource DenseRuleBrush}"
            Margin="0,3,0,10"/>

        <!-- Source tiles have no well. They are justified across the width as muted glass squares. -->
        <Grid Grid.Row="2"
            ColumnSpacing="10">
          <Grid.Resources>
            <!-- Frosted pane with a thin rim and no glints. It is a quieter version of the button. -->
            <Style x:Key="SourceTileStyle"
                TargetType="Button">
              <Setter Property="Background"
                  Value="{StaticResource GlassButtonBaseFillBrush}"/>
              <Setter Property="BorderBrush"
                  Value="#30FFFFFF"/>
              <Setter Property="BorderThickness"
                  Value="1"/>
              <Setter Property="CornerRadius"
                  Value="10"/>
              <Setter Property="Padding"
                  Value="8,8"/>
              <Setter Property="Height"
                  Value="120"/>
              <Setter Property="MinWidth"
                  Value="0"/>
              <Setter Property="HorizontalAlignment"
                  Value="Stretch"/>
              <Setter Property="HorizontalContentAlignment"
                  Value="Stretch"/>
              <Setter Property="VerticalContentAlignment"
                  Value="Center"/>
              <Setter Property="Foreground"
                  Value="#F2FFFFFF"/>
            </Style>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                Color="#26FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed"
                Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                Color="#45FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                Color="#45FFFFFF"/>
          </Grid.Resources>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Button x:Name="FolderCard"
              Grid.Column="0"
              Style="{StaticResource SourceTileStyle}"
              Click="Folder_Click">
            <Grid VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="1">
                <FontIcon Style="{StaticResource FaIcon}"
                    Glyph="&#xf07b;"
                    FontSize="21"
                    Foreground="#99FFFFFF"/>
                <TextBlock Text="{loc:Str Key=AddMusic_Folder}"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Margin="0,8,0,0"
                           Foreground="#F2FFFFFF"
                    HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Str Key=AddMusic_FolderHint}"
                    FontSize="10.5"
                           Foreground="#88FFFFFF"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Margin="0,2,0,0"
                    Height="32"/>
              </StackPanel>
            </Grid>
          </Button>

          <Button x:Name="CdCard"
              Grid.Column="1"
              Style="{StaticResource SourceTileStyle}"
              Click="Cd_Click">
            <Grid VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="1">
                <FontIcon Style="{StaticResource FaIcon}"
                    Glyph="&#xf51f;"
                    FontSize="21"
                    Foreground="#99FFFFFF"/>
                <TextBlock Text="{loc:Str Key=AddMusic_Cd}"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Margin="0,8,0,0"
                           Foreground="#F2FFFFFF"
                    HorizontalAlignment="Center"/>
                <TextBlock x:Name="CdCardHint"
                    Text="{loc:Str Key=AddMusic_CdHint}"
                    FontSize="10.5"
                           Foreground="#88FFFFFF"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Margin="0,2,0,0"
                    Height="32"/>
              </StackPanel>
            </Grid>
          </Button>

          <Button x:Name="DvdCard"
              Grid.Column="2"
              Style="{StaticResource SourceTileStyle}"
              Click="Dvd_Click">
            <Grid VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="1">
                <FontIcon Style="{StaticResource FaIcon}"
                    Glyph="&#xf008;"
                    FontSize="21"
                    Foreground="#99FFFFFF"/>
                <TextBlock Text="{loc:Str Key=AddMusic_Dvd}"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Margin="0,8,0,0"
                           Foreground="#F2FFFFFF"
                    HorizontalAlignment="Center"/>
                <TextBlock x:Name="DvdCardHint"
                    Text="{loc:Str Key=AddMusic_DvdHint}"
                    FontSize="10.5"
                           Foreground="#88FFFFFF"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Margin="0,2,0,0"
                    Height="32"/>
              </StackPanel>
            </Grid>
          </Button>

          <!-- Record from a turntable or any line-in. This opens its own capture window. Whatever
               it puts into staging joins this flow as a folder. -->
          <Button x:Name="VinylCard"
              Grid.Column="3"
              Style="{StaticResource SourceTileStyle}"
              Click="Vinyl_Click">
            <Grid VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="1">
                <FontIcon Style="{StaticResource FaIcon}"
                    Glyph="&#xf8d9;"
                    FontSize="21"
                    Foreground="#99FFFFFF"/>
                <TextBlock Text="{loc:Str Key=AddMusic_Vinyl}"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Margin="0,8,0,0"
                           Foreground="#F2FFFFFF"
                    HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Str Key=AddMusic_VinylHint}"
                    FontSize="10.5"
                           Foreground="#88FFFFFF"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Margin="0,2,0,0"
                    Height="32"/>
              </StackPanel>
            </Grid>

          </Button>

          <!-- Discs already ripped into .rpm that never reached the library. The disc is finished
               with, so there is nothing to put back in the drive. -->
          <Button x:Name="PendingCard"
              Grid.Column="4"
              Style="{StaticResource SourceTileStyle}"
              Click="Pending_Click">
            <Grid VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="1">
                <FontIcon Style="{StaticResource FaIcon}"
                    Glyph="&#xf1da;"
                    FontSize="21"
                    Foreground="#99FFFFFF"/>
                <TextBlock Text="{loc:Str Key=AddMusic_Pending}"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Margin="0,8,0,0"
                           Foreground="#F2FFFFFF"
                    HorizontalAlignment="Center"/>
                <TextBlock x:Name="PendingCardHint"
                    Text="{loc:Str Key=AddMusic_PendingNone}"
                    FontSize="10.5"
                           Foreground="#88FFFFFF"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Margin="0,2,0,0"
                    Height="32"/>
              </StackPanel>
            </Grid>
          </Button>

        </Grid>
      </Grid>

      <!-- Pending rips: its own branch. There is nothing to read and nothing to rip. -->
      <Grid x:Name="PendingFace"
          Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
            Text="{loc:Str Key=AddMusic_PendingKicker}"
                   Style="{StaticResource DenseGroupHeaderStyle}"/>
        <Border Grid.Row="1"
            Height="1"
            Background="{StaticResource DenseRuleBrush}"
            Margin="0,3,0,8"/>
        <TextBlock Grid.Row="2"
            Text="{loc:Str Key=AddMusic_PendingIntro}"
            FontSize="11.5"
                   Foreground="{StaticResource DenseLabelInkBrush}"
            TextWrapping="Wrap"
            Margin="0,0,0,8"/>

        <ListView x:Name="PendingList"
            Grid.Row="3"
            SelectionMode="Single"
            Background="Transparent"
                  SelectionChanged="Pending_SelectionChanged">
          <!-- The selected row has the same translucent cyan tint as the lookup window and the main
               grid. It is rounded, not a solid accent block. -->
          <ListView.Resources>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected"
                Color="#2404C8FF"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver"
                Color="#3004C8FF"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed"
                Color="#3004C8FF"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled"
                Color="#1404C8FF"/>
          </ListView.Resources>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment"
                  Value="Stretch"/>
              <Setter Property="MinHeight"
                  Value="0"/>
              <Setter Property="Padding"
                  Value="8,1"/>
              <Setter Property="Margin"
                  Value="0,0,0,2"/>
              <Setter Property="CornerRadius"
                  Value="6"/>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="dlg:PendingRipRow">
              <Grid ColumnSpacing="10"
                  Padding="2,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0"
                    Style="{StaticResource FaIcon}"
                    Glyph="{x:Bind Glyph}"
                    FontSize="14"
                          Foreground="#99FFFFFF"
                    VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                    Spacing="1"
                    VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Name}"
                      FontSize="12.5"
                      Foreground="#F2FFFFFF"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{x:Bind Detail}"
                      FontSize="10.5"
                      Foreground="#88FFFFFF"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="2"
                    Click="PendingDelete_Click"
                    Tag="{x:Bind Folder}"
                        Background="Transparent"
                    BorderThickness="0"
                    Padding="8,2"
                        MinWidth="0"
                    MinHeight="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{loc:Str Key=AddMusic_PendingDelete}">
                  <ToolTipService.ToolTip>
                    <ToolTip Content="{loc:Str Key=AddMusic_PendingDelete}"/>
                  </ToolTipService.ToolTip>
                  <FontIcon Style="{StaticResource FaIcon}"
                      Glyph="&#xf2ed;"
                      FontSize="12"
                            Foreground="#99FFFFFF"/>
                </Button>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="PendingErrorText"
            Grid.Row="4"
            FontSize="11"
            Foreground="#FF6B6B"
                   TextWrapping="Wrap"
            Margin="0,8,0,0"
            Visibility="Collapsed"/>
      </Grid>
    </Grid>
  </ctl:ResizableDialogShell>
</ContentDialog>
