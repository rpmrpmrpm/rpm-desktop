<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.MoodPlaylistDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:model="using:RPM.Desktop.Presentation.Dialogs.Models"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/DenseForm.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- A chosen chip wears the azure the cover window lights its choices in; see PaintChip. -->
      <SolidColorBrush x:Key="ChipLitBrush" Color="#0371D0"/>
      <SolidColorBrush x:Key="ChipDarkBrush" Color="#18FFFFFF"/>
      <Style x:Key="TileItemStyle" TargetType="GridViewItem">
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      </Style>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

    </ResourceDictionary>
  </ContentDialog.Resources>

  <!-- Laid out in the space the card has rather than scrolled whole: the cover step is panes (a preview beside
       grids), and each of the other steps scrolls on its own. -->
  <ctl:ResizableDialogShell x:Name="Shell" Title="{loc:Str Key=MoodMaker_Title}" TitleGlyph="&#xf0d0;" ScrollBody="False">

    <Grid RowSpacing="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock x:Name="StepText" Grid.Row="0" FontSize="14" FontWeight="SemiBold"/>

      <Grid Grid.Row="1">

        <!-- ═══ 1: NAME AND MOOD ═══ -->
        <ScrollViewer x:Name="StepMood" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" Padding="0,0,12,0">
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Str Key=MoodMaker_Name}" FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}"/>
              <TextBox x:Name="NameBox" Width="420" HorizontalAlignment="Left" TextChanged="NameBox_TextChanged"/>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Str Key=MoodMaker_Mood}" FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}"/>
              <ctl:ChipWrap x:Name="MoodChips"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- ═══ 2: GENRES AND DECADES ═══ -->
        <ScrollViewer x:Name="StepFilters" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Spacing="14" Padding="0,0,12,0">
            <TextBlock Text="{loc:Str Key=MoodMaker_EmptyMeansAll}" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{StaticResource DenseLabelInkBrush}"/>
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Str Key=MoodMaker_Genres}" FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}"/>
              <ctl:ChipWrap x:Name="GenreChips"/>
              <ctl:RecordSpinner x:Name="GenresSpinner" Width="18" Height="18" HorizontalAlignment="Left" Spinning="True"/>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Str Key=MoodMaker_Decades}" FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}"/>
              <ctl:ChipWrap x:Name="DecadeChips"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- ═══ 3: ARTISTS ═══ -->
        <ScrollViewer x:Name="StepArtists" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Spacing="14" Padding="0,0,12,0">
            <TextBlock Text="{loc:Str Key=MoodMaker_EmptyMeansAll}" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{StaticResource DenseLabelInkBrush}"/>
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Str Key=MoodMaker_Artists}" FontSize="11.5" Foreground="{StaticResource DenseLabelInkBrush}"/>
              <AutoSuggestBox x:Name="ArtistBox" Width="420" HorizontalAlignment="Left"
                              PlaceholderText="{loc:Str Key=MoodMaker_ArtistSearch}"
                              TextChanged="ArtistBox_TextChanged" QuerySubmitted="ArtistBox_QuerySubmitted"/>
              <ctl:ChipWrap x:Name="ArtistChips"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- ═══ 4: COVER ═══ the cover window's layout: the live preview on the left, the tabs on the right. Every
             choice is drawn under the frame the generated lists wear; see MoodCovers. -->
        <Grid x:Name="StepCover" ColumnSpacing="{StaticResource DenseColumnSpacing}" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border x:Name="PreviewHost" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

          <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{loc:Str Key=MoodMaker_CoverHint}" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{StaticResource DenseLabelInkBrush}"/>
            <Border x:Name="TabStripHost" Grid.Row="1" HorizontalAlignment="Left"/>

            <Grid Grid.Row="2">
              <TextBlock x:Name="MoodPanel" Text="{loc:Str Key=MoodMaker_CoverMoodNote}" FontSize="12"
                         TextWrapping="Wrap" Foreground="{StaticResource DenseLabelInkBrush}"/>

              <Grid x:Name="RecordsPanel" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{loc:Str Key=Playlists_CoverPickFour}" FontSize="11.5"
                           Foreground="{StaticResource DenseLabelInkBrush}" TextWrapping="Wrap"/>
                <Grid Grid.Row="1">
                  <GridView x:Name="RecordsGrid" SelectionMode="None" IsItemClickEnabled="True"
                            ItemClick="RecordsGrid_ItemClick" Padding="0,4,0,0"
                            ItemContainerStyle="{StaticResource TileItemStyle}"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemTemplate>
                      <DataTemplate x:DataType="model:CoverChoiceRow">
                        <Grid Width="{Binding Edge}" Height="{Binding Edge}" CornerRadius="4"
                              Background="#18FFFFFF" ToolTipService.ToolTip="{Binding Album}">
                          <Image Source="{Binding Thumb}" Stretch="UniformToFill" Visibility="{Binding ThumbVisibility}"/>
                          <ctl:RecordSpinner Width="20" Height="20" Spinning="{Binding Pending}"/>
                          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf127;" FontSize="14"
                                    Foreground="#66FFFFFF" Visibility="{Binding UnavailableVisibility}"/>
                          <Border Background="#0371D0" CornerRadius="10" Width="20" Height="20"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"
                                  Visibility="{Binding BadgeVisibility}">
                            <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </GridView.ItemTemplate>
                  </GridView>
                  <TextBlock x:Name="NoRecordsText" Text="{loc:Str Key=MoodMaker_CoverNoRecords}" FontSize="12"
                             Foreground="{StaticResource DenseLabelInkBrush}" HorizontalAlignment="Center"
                             VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" Visibility="Collapsed"/>
                </Grid>
              </Grid>

              <StackPanel x:Name="PicturePanel" Spacing="10" Visibility="Collapsed">
                <Button Click="ChooseFile_Click" Style="{StaticResource DenseButtonStyle}" HorizontalAlignment="Left" Padding="14,0">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf07c;" FontSize="11"/>
                    <TextBlock Text="{loc:Str Key=Playlists_CoverChooseFile}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <TextBlock x:Name="CopiedText" Text="{loc:Str Key=Playlists_CoverCopied}" FontSize="11"
                           Foreground="{StaticResource DenseLabelInkBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
              </StackPanel>

              <Grid x:Name="FigurePanel" RowSpacing="10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GridView x:Name="FiguresGrid" Grid.Row="0" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="FiguresGrid_ItemClick" Padding="0,4,0,0"
                          ItemContainerStyle="{StaticResource TileItemStyle}"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <GridView.ItemTemplate>
                    <DataTemplate x:DataType="model:CoverChoiceRow">
                      <Grid Width="{Binding Edge}" Height="{Binding Edge}" CornerRadius="4" Background="#18FFFFFF">
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" Visibility="{Binding ThumbVisibility}"/>
                        <ctl:RecordSpinner Width="20" Height="20" Spinning="{Binding Pending}"/>
                        <Border BorderBrush="#0371D0" BorderThickness="3" CornerRadius="4"
                                Visibility="{Binding SelectionVisibility}"/>
                      </Grid>
                    </DataTemplate>
                  </GridView.ItemTemplate>
                </GridView>
                <Button Grid.Row="1" Click="Colours_Click" Style="{StaticResource DenseButtonStyle}" Padding="12,0"
                        HorizontalAlignment="Left"
                        ToolTipService.ToolTip="{loc:Str Key=Playlists_CoverColours}"
                        AutomationProperties.Name="{loc:Str Key=Playlists_CoverColours}">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf074;" FontSize="11"/>
                </Button>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <ctl:ResizableDialogShell.FooterLeading>
      <StackPanel Spacing="2" VerticalAlignment="Center" MaxWidth="420">
        <TextBlock x:Name="CountText" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock x:Name="MeasuredText" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource DenseLabelInkBrush}"/>
      </StackPanel>
    </ctl:ResizableDialogShell.FooterLeading>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="CancelButton" Click="Cancel_Click" Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="BackButton" Click="Back_Click" Style="{StaticResource GlassButtonStyle}" Padding="18,0" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf053;" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=MoodMaker_Back}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ctl:RpmPrimaryButton x:Name="NextButton" Click="Next_Click" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{loc:Str Key=MoodMaker_Next}" FontWeight="Bold" VerticalAlignment="Center"/>
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf054;" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
        <ctl:RpmPrimaryButton x:Name="SaveButton" Click="Save_Click" Padding="18,0" IsEnabled="False" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0d0;" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="SaveText" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
