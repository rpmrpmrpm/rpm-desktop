<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.SignUpDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0"
               DefaultButton="None"
               TabNavigation="Cycle">

  <!-- Making an rpm account with an email and password, in the app: the accounts service's
       auth/register, then the six-digit code it mails (auth/confirm), then a sign-in with the new
       password. Two faces in one card, the form and the code, so the second is not a new window. The
       card is the sign-in window's, with the same frame. -->

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <ctl:ResizableDialogShell x:Name="Shell"
                            Title="{loc:Str Key=SignUp_Title}"
                            TitleGlyph="&#xf234;">

    <Grid>
      <!-- Face one: who. -->
      <StackPanel x:Name="FormFace" Spacing="12">
        <TextBlock Text="{loc:Str Key=SignUp_Subtitle}" FontSize="13" Foreground="#CCFFFFFF"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"/>

        <TextBox x:Name="NameBox" PlaceholderText="{loc:Str Key=SignUp_Name}" HeaderTemplate="{x:Null}"
                 FontSize="14" KeyDown="Form_KeyDown"/>
        <TextBox x:Name="EmailBox" PlaceholderText="{loc:Str Key=Login_Email}" HeaderTemplate="{x:Null}"
                 FontSize="14" KeyDown="Form_KeyDown"/>
        <PasswordBox x:Name="PasswordBox" PlaceholderText="{loc:Str Key=Login_Password}"
                     HeaderTemplate="{x:Null}" FontSize="14" KeyDown="Form_KeyDown"/>
        <TextBlock Text="{loc:Str Key=SignUp_PasswordRule}" FontSize="12" Foreground="#77FFFFFF"
                   TextWrapping="Wrap" Margin="0,-4,0,0"/>
      </StackPanel>

      <!-- Face two: the code that was mailed. -->
      <StackPanel x:Name="CodeFace" Spacing="12" Visibility="Collapsed">
        <TextBlock x:Name="CodeSentText" FontSize="13" Foreground="#CCFFFFFF" TextWrapping="Wrap"
                   TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"/>
        <TextBox x:Name="CodeBox" PlaceholderText="{loc:Str Key=SignUp_Code}" HeaderTemplate="{x:Null}"
                 FontSize="18" CharacterSpacing="200" MaxLength="6" TextAlignment="Center"
                 InputScope="Number" KeyDown="Code_KeyDown"/>
        <HyperlinkButton x:Name="ResendButton" Click="Resend_Click" Content="{loc:Str Key=SignUp_Resend}"
                         FontSize="12" Padding="2,0" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Spacing="10">
        <TextBlock x:Name="ErrorText" Foreground="#FF8B96" FontSize="13" TextWrapping="Wrap"
                   TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Click="Cancel_Click"
                  Style="{StaticResource GlassButtonStyle}" Padding="18,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <ctl:RpmPrimaryButton x:Name="GoButton" Click="Go_Click" Padding="18,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf234;" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock x:Name="GoText" Text="{loc:Str Key=SignUp_Create}" FontWeight="Bold"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </ctl:RpmPrimaryButton>
        </StackPanel>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
