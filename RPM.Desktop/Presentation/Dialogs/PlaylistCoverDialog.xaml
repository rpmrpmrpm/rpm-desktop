<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.PlaylistCoverDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:model="using:RPM.Desktop.Presentation.Dialogs.Models"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/DenseForm.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- The advisory toggle, lit and unlit. The lit colour is the same azure as the ring on the
           picked tile, so one colour means "this is the one that is on" throughout this window.
           ToolToggleStyle leaves its own Checked state empty on purpose, because the rail that owns
           those keys paints their face itself. So this window paints it too. See ShowMark. -->
      <SolidColorBrush x:Key="MarkLitBrush" Color="#0371D0"/>
      <SolidColorBrush x:Key="MarkDarkBrush" Color="#18FFFFFF"/>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <ctl:ResizableDialogShell x:Name="Shell" Title="{loc:Str Key=Playlists_CoverTitle}" TitleGlyph="&#xf03e;"
                            ScrollBody="False">

    <Grid ColumnSpacing="{StaticResource DenseColumnSpacing}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- The live preview: what Save would produce for the tab that is showing now. It is built in
           code (see PictureWell), and it is hosted here the same way TrackDetailsDialog hosts its
           own well. -->
      <Border x:Name="PreviewHost" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

      <Grid Grid.Column="1" RowSpacing="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The tab strip is the left pane's function rail, turned on its side. It is built in
             code, like every other window that has one (see RailTabStrip). -->
        <Border x:Name="TabStripHost" Grid.Row="0" HorizontalAlignment="Left"/>

        <Grid Grid.Row="1">

          <!-- Records. This is hidden for a folder, which has no list of its own to take four
               records from (see the constructor). -->
          <Grid x:Name="RecordsPanel" RowSpacing="8" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{loc:Str Key=Playlists_CoverPickFour}" FontSize="11.5"
                       Foreground="{StaticResource DenseLabelInkBrush}" TextWrapping="Wrap"/>

            <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="{loc:Str Key=Playlists_CoverSearch}"
                     TextChanged="SearchBox_TextChanged"/>

            <Grid Grid.Row="2">
              <GridView x:Name="RecordsGrid" SelectionMode="None" IsItemClickEnabled="True"
                        ItemClick="RecordsGrid_ItemClick" Padding="0,4,0,0"
                        SizeChanged="RecordsGrid_SizeChanged"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                <GridView.ItemContainerStyle>
                  <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,10,10"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                  </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                  <DataTemplate x:DataType="model:CoverChoiceRow">
                    <!-- The cover alone. Each tile shows only the cover. A name under it would take
                         a line of text on every tile, and most names would be cut short. The name
                         is still in the tile's tooltip, for a record whose cover does not show what
                         it is. -->
                    <Grid Width="{Binding Edge}" Height="{Binding Edge}" CornerRadius="4"
                          Background="#18FFFFFF" ToolTipService.ToolTip="{Binding Album}">
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill"
                               Visibility="{Binding ThumbVisibility}"/>
                        <ctl:RecordSpinner Width="20" Height="20" Spinning="{Binding Pending}"/>
                        <!-- No artwork came back for this folder. It is marked as unavailable, not
                             left spinning, and it cannot be ticked. See RecordsGrid_ItemClick,
                             which does not add a folder that Save has no cover to compose with. -->
                        <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf127;" FontSize="14"
                                  Foreground="#66FFFFFF" Visibility="{Binding UnavailableVisibility}"/>
                        <!-- The pick order. It sits on top of the picture. The number is what makes
                             this tile different from the others beside it. -->
                        <Border Background="#0371D0" CornerRadius="10" Width="20" Height="20"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"
                                Visibility="{Binding BadgeVisibility}">
                          <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold"
                                     Foreground="White" HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                  </DataTemplate>
                </GridView.ItemTemplate>
              </GridView>

              <TextBlock x:Name="NoRecordsText" Text="{loc:Str Key=Playlists_CoverNoRecords}" FontSize="12"
                         Foreground="{StaticResource DenseLabelInkBrush}" HorizontalAlignment="Center"
                         VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280"
                         Visibility="Collapsed"/>
            </Grid>
          </Grid>

          <!-- Picture. -->
          <Grid x:Name="PicturePanel" RowSpacing="10" Visibility="Collapsed" VerticalAlignment="Top">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" x:Name="ChooseFileButton" Click="ChooseFile_Click"
                    Style="{StaticResource DenseButtonStyle}" HorizontalAlignment="Left" Padding="14,0">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf07c;" FontSize="11"/>
                <TextBlock Text="{loc:Str Key=Playlists_CoverChooseFile}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <!-- The chosen picture, shown in the panel it was picked from (see PicturePreview in
                 code-behind). This is a different object from the live preview on the left. It
                 shows the same picture once one has been picked. -->
            <Border Grid.Row="1" x:Name="PicturePreviewHost" HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="2" x:Name="CopiedText" Text="{loc:Str Key=Playlists_CoverCopied}"
                       FontSize="11" Foreground="{StaticResource DenseLabelInkBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
          </Grid>

          <!-- Generated. -->
          <Grid x:Name="FigurePanel" RowSpacing="10" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Padding is 0 on the right, unlike the records grid. This grid is sized to fill the
                 panel exactly (see LayOutTiles), so a gutter here would take space that the tile
                 sizes already use. -->
            <GridView x:Name="FiguresGrid" Grid.Row="0" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="FiguresGrid_ItemClick" Padding="0,4,0,0"
                      SizeChanged="FiguresGrid_SizeChanged"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
              <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                  <Setter Property="Margin" Value="0,0,10,10"/>
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                </Style>
              </GridView.ItemContainerStyle>
              <GridView.ItemTemplate>
                <DataTemplate x:DataType="model:CoverChoiceRow">
                  <Grid Width="{Binding Edge}" Height="{Binding Edge}" CornerRadius="4" Background="#18FFFFFF">
                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"
                           Visibility="{Binding ThumbVisibility}"/>
                    <ctl:RecordSpinner Width="20" Height="20" Spinning="{Binding Pending}"/>
                    <!-- Only one tile in this grid has the ring at a time. It is a ring, not a
                         badge, because there is no order here. The ring shows the one answer. -->
                    <Border BorderBrush="#0371D0" BorderThickness="3" CornerRadius="4"
                            Visibility="{Binding SelectionVisibility}"/>
                  </Grid>
                </DataTemplate>
              </GridView.ItemTemplate>
            </GridView>

            <!-- Two symbols and no words. Both buttons are one symbol wide, which is possible here
                 and nowhere else in this window. They sit directly under the thing they act on, and
                 the eight tiles visibly change when either is pressed. The words are in the
                 tooltips, because a symbol that users may not recognise needs them. -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
              <Button x:Name="ColoursButton" Click="Colours_Click"
                      Style="{StaticResource DenseButtonStyle}" Padding="12,0"
                      ToolTipService.ToolTip="{loc:Str Key=Playlists_CoverColours}"
                      AutomationProperties.Name="{loc:Str Key=Playlists_CoverColours}">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf074;" FontSize="11"/>
              </Button>

              <!-- A toggle, not a button. It shows a state the cover is in. It stays on when the
                   colours change, and the tile grid under it redraws to show the change. -->
              <ToggleButton x:Name="ExplicitToggle" Click="Explicit_Click"
                            Style="{StaticResource ToolToggleStyle}" Padding="12,0"
                            Background="{StaticResource ToolKeyFaceBrush}"
                            ToolTipService.ToolTip="{loc:Str Key=Playlists_CoverExplicit}"
                            AutomationProperties.Name="{loc:Str Key=Playlists_CoverExplicit}">
                <ctl:ExplicitBadge Width="13" Height="13" IsExplicit="True" VerticalAlignment="Center"/>
              </ToggleButton>
            </StackPanel>
          </Grid>

        </Grid>
      </Grid>
    </Grid>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- A plain button beside Save and Close, not a fourth tab. Choosing it is not a fourth
             kind of picture. It means deciding not to choose a picture at all. -->
        <Button x:Name="AutomaticButton" Click="Automatic_Click" Style="{StaticResource GlassButtonStyle}"
                Padding="18,0">
          <TextBlock Text="{loc:Str Key=Playlists_CoverAutomatic}" VerticalAlignment="Center"/>
        </Button>
        <Button x:Name="CancelButton" Click="Cancel_Click" Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ctl:RpmPrimaryButton x:Name="SaveButton" Click="Save_Click" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0c7;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Details_Save}" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
