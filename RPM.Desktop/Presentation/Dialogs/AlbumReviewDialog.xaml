<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.AlbumReviewDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="Fa">ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro Solid</FontFamily>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <ctl:ResizableDialogShell x:Name="Shell" Title="{loc:Str Key=Review_Title}" TitleGlyph="&#xf005;">

    <Grid RowSpacing="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Star rating row: the stars are built in code-behind into StarPanel. -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="{loc:Str Key=Review_RatingLabel}" FontSize="13" FontWeight="SemiBold"
                   Foreground="#E6FFFFFF" VerticalAlignment="Center"/>
        <StackPanel x:Name="StarPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
        <Button x:Name="ClearRatingButton" Click="ClearRating_Click" Background="Transparent"
                BorderThickness="0" Padding="6,2" MinWidth="0" VerticalAlignment="Center">
          <TextBlock Text="{loc:Str Key=Review_ClearRating}" FontSize="12" Foreground="#88FFFFFF"/>
        </Button>
      </StackPanel>

      <!-- Editor on the left, live preview on the right. -->
      <Grid Grid.Row="1" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{loc:Str Key=Review_EditorLabel}" FontSize="12"
                     Foreground="#AAFFFFFF"/>
          <!-- A review is the one long piece of text the app asks users to write, and it is
               published under their name. Spell checking is on here. The app-wide default is off
               (see Themes/Generic.xaml). Right-click a word with a red underline for suggestions. -->
          <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                   IsSpellCheckEnabled="True"
                   TextChanged="Editor_TextChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   PlaceholderText="{loc:Str Key=Review_Placeholder}"/>
        </Grid>

        <Grid Grid.Column="1" RowSpacing="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{loc:Str Key=Review_PreviewLabel}" FontSize="12"
                     Foreground="#AAFFFFFF"/>
          <Border Grid.Row="1" Background="#1AFFFFFF" CornerRadius="6" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="Preview" Foreground="#EEFFFFFF" FontSize="13" TextWrapping="Wrap"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="CancelButton" Click="Cancel_Click"
                Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ctl:RpmPrimaryButton x:Name="SaveButton" Click="Save_Click" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0c7;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Review_Save}" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
