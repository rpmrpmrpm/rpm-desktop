<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.SupporterDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0"
               DefaultButton="None">

  <!-- The one window in the app that asks for money. Every supporter-only refusal is shown here, so the
       offer is written once and every refusal looks the same. A second window with its own wording
       would be one more thing to keep in step.

       It shows the state first and the offer second, in that order. What has just happened is the main
       point, and the price answers it. The state is what differs between the two cases. A store that
       has filled up shows its own numbers. A refused feature shows one sentence. The offer card under
       it is the same card either way.

       It closes on Escape, on the grip's X and on "not now". A window the user cannot get past would
       block access to their own library. -->

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <ctl:ResizableDialogShell x:Name="Shell"
                            Title=""
                            TitleGlyph="&#xf0c2;">

    <StackPanel Spacing="16">

      <!-- What has happened. The meter is only for the storage case. A refused feature has no number to
           show, and a bar at zero would look like an empty store. So the meter is shown or hidden with
           the occasion, and the sentence under it stays and says something else. -->
      <StackPanel Spacing="8">
        <StackPanel x:Name="StoragePanel" Spacing="8" Visibility="Collapsed">
          <TextBlock x:Name="UsageText" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
          <ProgressBar x:Name="UsageBar" Minimum="0" Maximum="1" Value="1" Height="8"
                       Foreground="{StaticResource RpmCyanBrush}" Background="#22FFFFFF"/>
        </StackPanel>

        <TextBlock x:Name="BodyText" FontSize="13"
                   Foreground="#CCFFFFFF" TextWrapping="Wrap"/>

        <!-- What it means for the sync setting. The sentence is different for a user who had "all
             music" on, and for a user who was already choosing albums. Storage only. -->
        <TextBlock x:Name="PausedText" Visibility="Collapsed" FontSize="12"
                   Foreground="#99FFFFFF" TextWrapping="Wrap"/>
      </StackPanel>

      <!-- The offer. -->
      <Border CornerRadius="10" Padding="16,14"
              Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
        <StackPanel Spacing="10">
          <!-- The price comes first, then what it buys. It is the one number on the card, and it is
               what the reader wants to know. It is not placed under a heading, so it does not look like
               a footnote. -->
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf004;" FontSize="13"
                      Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Supporter_Price}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>

          <TextBlock Text="{loc:Str Key=Supporter_OfferTitle}" FontSize="13"
                     Foreground="#CCFFFFFF" TextWrapping="Wrap"/>

          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="10"
                        Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Str Key=Supporter_PerkStorage}" FontSize="12"
                         Foreground="#CCFFFFFF" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="10"
                        Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Str Key=Supporter_PerkBitrate}" FontSize="12"
                         Foreground="#CCFFFFFF" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="10"
                        Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Str Key=Supporter_PerkRecognition}" FontSize="12"
                         Foreground="#CCFFFFFF" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="10"
                        Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Str Key=Supporter_PerkDj}" FontSize="12"
                         Foreground="#CCFFFFFF" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="10"
                        Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Str Key=Supporter_PerkKaraoke}" FontSize="12"
                         Foreground="#CCFFFFFF" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="10"
                        Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Str Key=Supporter_PerkBackdrop}" FontSize="12"
                         Foreground="#CCFFFFFF" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="10"
                        Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Str Key=Supporter_PerkBadge}" FontSize="12"
                         Foreground="#CCFFFFFF" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="10"
                        Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Str Key=Supporter_PerkCommunity}" FontSize="12"
                         Foreground="#CCFFFFFF" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{loc:Str Key=Supporter_PerkMore}" FontSize="12"
                     Foreground="#88FFFFFF" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

    </StackPanel>

    <!-- The way to stop being asked. It is on the same line as the answers, at the far end. It is only
         offered from the second showing on. On the first showing it would turn off a message that the
         user has not finished reading. -->
    <ctl:ResizableDialogShell.FooterLeading>
      <CheckBox x:Name="NeverAgainBox" Visibility="Collapsed"
                Content="{loc:Str Key=CloudFull_NeverAgain}"
                MinWidth="0" FontSize="12" Foreground="#99FFFFFF"/>
    </ctl:ResizableDialogShell.FooterLeading>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="LaterButton" Click="Later_Click"
                Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Supporter_Later}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <ctl:RpmPrimaryButton x:Name="SupportButton" Click="Support_Click" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf004;" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Cloud_BecomeSupporter}" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
