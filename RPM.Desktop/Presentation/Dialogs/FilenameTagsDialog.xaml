<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.FilenameTagsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:local="using:RPM.Desktop.Presentation.Dialogs"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
        <!-- The standard sizing for data-entry forms, as in the tag editors: 24 px inputs, 12 pt
             text. This window shows a pattern and a list of what it would do. Each row that the
             header saves is a file the list can show. -->
        <ResourceDictionary Source="ms-appx:///Themes/DenseForm.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <ctl:ResizableDialogShell x:Name="Shell" Title="{loc:Str Key=FilenameTags_Title}"
                            TitleGlyph="&#xf15b;">

    <Grid RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- The pattern, and the presets to start from. -->
        <RowDefinition Height="*"/>      <!-- what it would do to every ticked file -->
        <RowDefinition Height="Auto"/>   <!-- how much of it matched -->
      </Grid.RowDefinitions>

      <!-- The pattern is the main part of this window. It has a preset to start from, a box to edit
           it in, and field buttons that write their token into the box. So nobody has to know the
           spelling of a token to use one. The label column is 82 px and the rows are 24 px, the
           same as the tag editors, so this window reads as the same kind of form. -->
      <Border Grid.Row="0" Style="{StaticResource ContentBorderStyle}" Padding="12">
        <Grid ColumnSpacing="8" RowSpacing="{StaticResource DenseRowSpacing}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="82"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Each preset describes what it does, using the app's own field names. The pattern is
               kept beside the description, in the box's font, so the list can be read without
               braces. The braces are still shown for users who are learning them. -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Key=FilenameTags_Preset}"
                     Style="{StaticResource DenseFieldLabelStyle}"/>
          <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PresetBox"
                    HorizontalAlignment="Stretch" SelectionChanged="Preset_SelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="local:TagPresetRow">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Pattern}" FontSize="11"
                             Foreground="#66FFFFFF" FontFamily="Consolas,Menlo,monospace"
                             VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Key=FilenameTags_Pattern}"
                     Style="{StaticResource DenseFieldLabelStyle}"/>
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="PatternBox"
                   FontFamily="Consolas,Menlo,monospace"
                   TextChanged="Pattern_TextChanged"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Str Key=Tags_Fields}"
                     Style="{StaticResource DenseFieldLabelStyle}" VerticalAlignment="Top"
                     Margin="0,4,0,0"/>
          <ContentControl Grid.Row="2" Grid.Column="1" x:Name="ChipHost"
                          HorizontalContentAlignment="Stretch"/>
        </Grid>
      </Border>

      <!-- Every ticked file, and the name the pattern would give it. Nothing is written until
           Apply. So a pattern that reads a record's track numbers as titles shows the mistake
           before any file changes. -->
      <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}" Padding="0">
        <Grid RowSpacing="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- The two column names sit above their own hairline, using the same widths as the rows.
               The right-hand column is the new name, and its heading says so. -->
          <Border Grid.Row="0" BorderBrush="{StaticResource DenseRuleBrush}" BorderThickness="0,0,0,1"
                  Padding="12,8,12,5">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.4*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Str Key=Tags_ColFile}"
                         Style="{StaticResource DenseGroupHeaderStyle}"/>
              <TextBlock Grid.Column="1" Text="{loc:Str Key=FilenameTags_ColRead}"
                         Style="{StaticResource DenseGroupHeaderStyle}"/>
            </Grid>
          </Border>

          <ListView Grid.Row="1" x:Name="PreviewList" SelectionMode="None"
                    Background="Transparent" Padding="0,4,0,8">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="12,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:TagPreviewRow">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="11.5"
                             Foreground="#AAFFFFFF" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding Result}" FontSize="11.5"
                             Foreground="{Binding Ink}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <TextBlock Grid.Row="2" x:Name="SummaryText" FontSize="11.5"
                 Foreground="{StaticResource DenseLabelInkBrush}"/>
    </Grid>

    <ctl:ResizableDialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="CancelButton" Click="Cancel_Click"
                Style="{StaticResource GlassButtonStyle}" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ctl:RpmPrimaryButton x:Name="ApplyButton" Click="Apply_Click" Padding="18,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="11"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=FilenameTags_Apply}" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
