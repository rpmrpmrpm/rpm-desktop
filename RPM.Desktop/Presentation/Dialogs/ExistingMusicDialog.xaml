<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.ExistingMusicDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0"
               DefaultButton="None"
               TabNavigation="Cycle">

  <!-- Asked when the folder chosen for the library already holds music: keep the files as they are, or let
       rpm organise them. The same card as the NAS sign-in. Each choice is a button that closes the window
       with its answer. -->

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <ctl:ResizableDialogShell x:Name="Shell" TitleGlyph="&#xf001;">

    <StackPanel Spacing="14">
      <TextBlock x:Name="BodyText"
                 FontSize="13" Foreground="#CCFFFFFF"
                 TextWrapping="Wrap" TextAlignment="Center"
                 HorizontalAlignment="Center" MaxWidth="420"/>

      <!-- Two tiles, as on setup's import step: the frosted pane of AddMusicDialog's source tiles. -->
      <Grid ColumnSpacing="14">
        <Grid.Resources>
          <Style x:Key="ChoiceTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GlassButtonBaseFillBrush}"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,20"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
          </Style>
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26FFFFFF"/>
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FFFFFF"/>
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#45FFFFFF"/>
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#45FFFFFF"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="KeepButton" Style="{StaticResource ChoiceTileStyle}" Click="Keep_Click">
          <StackPanel Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf023;" FontSize="28"
                      Foreground="{StaticResource RpmCyanBrush}"/>
            <TextBlock Text="{loc:Str Key=ExistingMusic_Keep}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=ExistingMusic_KeepBody}" FontSize="12" Foreground="#8CFFFFFF"
                       TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
        </Button>

        <Button x:Name="OrganiseButton" Grid.Column="1" Style="{StaticResource ChoiceTileStyle}" Click="Organise_Click">
          <StackPanel Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf07c;" FontSize="28"
                      Foreground="{StaticResource RpmCyanBrush}"/>
            <TextBlock Text="{loc:Str Key=ExistingMusic_Organise}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="{loc:Str Key=ExistingMusic_OrganiseBody}" FontSize="12" Foreground="#8CFFFFFF"
                       TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>

    <ctl:ResizableDialogShell.Footer>
      <Button Click="Cancel_Click" Style="{StaticResource GlassButtonStyle}" Padding="18,0">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
