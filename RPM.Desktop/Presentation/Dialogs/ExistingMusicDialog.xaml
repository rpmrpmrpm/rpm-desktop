<ContentDialog x:Class="RPM.Desktop.Presentation.Dialogs.ExistingMusicDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0"
               DefaultButton="None"
               TabNavigation="Cycle">

  <!-- Asked when the folder chosen for the library already holds music: keep the files as they are, or let
       rpm organise them. The same card as the NAS sign-in. Each choice is a button that closes the window
       with its answer. -->

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so
               the artwork behind it shows through the dim. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <ctl:ResizableDialogShell x:Name="Shell" TitleGlyph="&#xf001;">

    <StackPanel Spacing="14">
      <TextBlock x:Name="BodyText"
                 FontSize="13" Foreground="#CCFFFFFF"
                 TextWrapping="Wrap" TextAlignment="Center"
                 HorizontalAlignment="Center" MaxWidth="420"/>

      <Button x:Name="KeepButton" Click="Keep_Click"
              Style="{StaticResource GlassButtonStyle}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="18,14">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf023;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{loc:Str Key=ExistingMusic_Keep}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
            <TextBlock Text="{loc:Str Key=ExistingMusic_KeepBody}" FontSize="12" Foreground="#AAFFFFFF" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Button>

      <Button x:Name="OrganiseButton" Click="Organise_Click"
              Style="{StaticResource GlassButtonStyle}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="18,14">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf07c;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{loc:Str Key=ExistingMusic_Organise}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
            <TextBlock Text="{loc:Str Key=ExistingMusic_OrganiseBody}" FontSize="12" Foreground="#AAFFFFFF" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Button>
    </StackPanel>

    <ctl:ResizableDialogShell.Footer>
      <Button Click="Cancel_Click" Style="{StaticResource GlassButtonStyle}" Padding="18,0">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Text="{loc:Str Key=Common_Cancel}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
