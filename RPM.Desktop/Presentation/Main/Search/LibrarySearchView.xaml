<?xml version="1.0" encoding="utf-8"?>
<!-- The library search: everything the collection holds that the words name, whichever view it lives in,
     each kind under its own heading (artists, albums, tracks, playlists, genres), and the recent searches
     while the box is empty. It drops down under the view's heading, from the heading's search box to the
     heading's last control; the words are typed in that box (LibrarySearchBox), not here. -->
<UserControl
    x:Class="RPM.Desktop.Presentation.Main.Search.LibrarySearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

  <UserControl.Resources>
    <FontFamily x:Key="Fa">ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro</FontFamily>
  </UserControl.Resources>

  <Grid>
    <!-- A press anywhere on the card below the heading puts the search away, as a press beside a menu does.
         It starts under the heading (see Place), so the box and the heading's other keys stay in reach. -->
    <Border x:Name="Catcher" Background="#26000000" PointerPressed="Catcher_PointerPressed"/>

    <!-- The surface of the app's flyouts (the deck's cast, view and share pickers): the framework's flyout
         fill and edge, read from the same theme resources the flyout presenter uses, with the 8 px corners
         the deck sets on its flyouts. The panel looks like the flyouts, and follows them if their brushes
         change. -->
    <Grid x:Name="Panel" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="PanelShift"/>
      </Grid.RenderTransform>

      <Border CornerRadius="8" Background="{ThemeResource FlyoutPresenterBackground}"
              BorderBrush="{ThemeResource FlyoutBorderThemeBrush}" BorderThickness="1"/>

      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Margin="1">
        <StackPanel x:Name="Body" Padding="0,4,0,10"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
