<UserControl x:Class="RPM.Desktop.Presentation.Main.Artists.ArtistDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="using:RPM.Desktop.Presentation.Main.Artists.Models"
             xmlns:artists="using:RPM.Desktop.Presentation.Main.Artists"
             xmlns:lib="using:RPM.Desktop.Presentation.Main.Library"
             xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
             xmlns:conv="using:RPM.Desktop.Converters"
             xmlns:loc="using:RPM.Desktop.Strings"
             RequestedTheme="Dark">

  <UserControl.Resources>
    <FontFamily x:Key="Fa">ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro Solid</FontFamily>
    <!-- The regular face, for the outline heart in the record's menu (an unfavourited heart). -->
    <FontFamily x:Key="FaRegular">ms-appx:///Assets/Fonts/fa-regular-400.ttf#Font Awesome 5 Pro Regular</FontFamily>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisible"/>
    <conv:TitleCensorConverter x:Key="Censor"/>
    <conv:SleeveFigureConverter x:Key="SleeveFigure"/>

    <!-- Ink colours. These are the same four weights as the track pane: one for a name, one for a
         sentence, one for a heading, one for a date. They do not change with the theme as the pane's do.
         The artist's colour sits under a heavy black layer (see `PageWeight`), so the text over it is
         white for every artist. -->
    <SolidColorBrush x:Key="InkStrong" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="InkBody" Color="#DDFFFFFF"/>
    <SolidColorBrush x:Key="InkQuiet" Color="#AAFFFFFF"/>
    <SolidColorBrush x:Key="InkFaint" Color="#88FFFFFF"/>

    <!-- One plate for everything on this page that holds text: the biography card, a row in the Elsewhere
         box and the band's line-up. It is the app's frosted glass: a thin white wash over the artist's
         colour. -->
    <SolidColorBrush x:Key="InkPlate" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="InkPlateLit" Color="#2EFFFFFF"/>

    <!-- The two tints for a line on the wall: gold for a verdict on a record, and the page's quiet white
         for something a listener said. The gold is the palette's (`Assets/RpmPalette`). It is repeated
         here because that file is a reference sheet and is not merged into this dictionary. -->
    <SolidColorBrush x:Key="WallStarTint" Color="#FFEFAF12"/>
    <SolidColorBrush x:Key="WallSaidTint" Color="#AAFFFFFF"/>

    <!-- The heading over a shelf. It is bigger than the track pane's heading because this is a page and
         not a column: a shelf runs the width of the panel, and a 12-point heading over it would look like
         a caption. -->
    <Style x:Key="ShelfHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource InkStrong}"/>
    </Style>

    <!-- The heading over a card in the artist column. It matches the track pane's heading. -->
    <Style x:Key="BlockHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource InkQuiet}"/>
    </Style>

    <Style x:Key="Prose" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource InkBody}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="IsTextSelectionEnabled" Value="True"/>
    </Style>

    <!-- A button on the photograph: the back arrow at the top of the band and the slideshow arrows at the
         foot. Only the outline is drawn, with no fill, because no flat colour is readable on every
         photograph. The line is heavier than a hairline because a 15% white line would vanish on a pale
         photograph. The fill appears only under the pointer. -->
    <Style x:Key="HeroChip" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#8CFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- One record on a shelf: its sleeve, its name and its year. Pressing it opens the album page, the
         same page that the wall of covers opens, because an artist's shelf is a way into the collection
         and not a second copy of it.

         One template serves every shelf of records, because a record they made and a record they appear
         on look the same and act the same. The shelf heading tells them apart. -->
    <DataTemplate x:Key="SleeveTemplate" x:DataType="model:ArtistRecord">
      <Button Click="Record_Click" ContextRequested="Record_ContextRequested" Tag="{Binding}"
              Width="{Binding Metrics.Stride}"
              Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="6,6,6,8"
              HorizontalContentAlignment="Stretch" MinWidth="0" MinHeight="0"
              ToolTipService.ToolTip="{Binding Title, Converter={StaticResource Censor}}">
        <!-- No hover or press wash on a sleeve, as on the album wall's cards. A wash is for controls that
             go somewhere. Pressing a sleeve here opens a tracklist under the shelf, and the ring below
             shows which record is open. -->
        <Button.Resources>
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
        </Button.Resources>
        <StackPanel Spacing="8">
          <!-- The sleeve size is the whole number of sleeves that the shelf can hold, from the same live
               measurement that the wall of covers uses (see `ShelfMetrics`). A fixed square would show
               one record and a sliver in a narrow panel and four records in a wide panel at the same
               size, so the shelf would ignore the window size. -->
          <Grid Width="{Binding Metrics.Art}" Height="{Binding Metrics.Art}">
            <Border CornerRadius="6" Background="#26FFFFFF"/>
            <Border CornerRadius="6">
              <Image Source="{Binding Cover}" Stretch="UniformToFill"
                     Visibility="{Binding HasCover, Converter={StaticResource BoolToVisible}}"/>
            </Border>
            <!-- No cover: a generated picture, not a music note. It is a soft blurred form in colours
                 that the palette takes from the record's folder (see `SoftFigure`). It has the same size
                 in both states, so a shelf where some records have artwork does not look as if it has
                 holes.

                 It is bound to `FigureSeed` and not to the folder. The seed is null until the read has
                 come back empty, so the picture is made only for records that need it. The `Visibility`
                 below hides it when a cover arrives. It does not decide whether a picture is drawn.

                 `HasCover` still says that the record has no artwork, so the prompt to add artwork, the
                 editor and the importer still see that. This is a placeholder and not a cover. -->
            <Border CornerRadius="6" Background="{Binding FigureSeed, Converter={StaticResource SleeveFigure}}"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVisible}, ConverterParameter=Invert}"/>
            <!-- The disc over the figure. The figure alone is a plain square. The disc shows that the
                 sleeve is generated and not a photograph. It is the same disc that the wall's tiles and
                 the album page show in this state. It is drawn faint so that it reads as a mark on the
                 sleeve and not as the whole sleeve. -->
            <FontIcon Glyph="&#xf51f;" FontFamily="{StaticResource Fa}" FontSize="32" Foreground="#4DFFFFFF"
                      IsHitTestVisible="False"
                      Visibility="{Binding HasCover, Converter={StaticResource BoolToVisible}, ConverterParameter=Invert}"/>
            <!-- The open sleeve has a ring in its drawer's colour, and the drawer under the shelf points
                 a triangle up at it. As on the album wall, these two marks are all that connect the
                 sleeve to the drawer, because the drawer opens elsewhere on the page. -->
            <Border CornerRadius="6" BorderThickness="2" BorderBrush="{Binding Ring}" IsHitTestVisible="False"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}"/>
          </Grid>
          <StackPanel Spacing="2">
            <!-- The name, then the explicit mark (E) if there is one. The mark comes after the name, as
                 in the drawer heading, so that every name on the shelf starts in the same place.

                 The name takes the room that is left, so that a long title does not push the mark off the
                 end of the sleeve. -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Title, Converter={StaticResource Censor}}" FontSize="12.5" Foreground="{StaticResource InkBody}"
                         TextTrimming="CharacterEllipsis" MaxLines="1"/>
              <ctl:ExplicitBadge Width="12" Height="12" VerticalAlignment="Center"
                                 Visibility="{Binding IsExplicit, Converter={StaticResource BoolToVisible}}"
                                 ToolTipService.ToolTip="{loc:Str Key=Library_Explicit}"/>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource InkFaint}"
                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
          </StackPanel>
        </StackPanel>
      </Button>
    </DataTemplate>

    <!-- One of the listener's playlists that already holds this artist. Its measurements match
         `SleeveTemplate` (6 of padding, two lines of text under the square), because it stands on a shelf
         between shelves of records and a card of another size looks like a mistake.

         The mark in the corner of the picture tells the two apart. It is the glyph that the Playlists tab
         shows on the rail. Without it, a square with an album sleeve and a name would look like an album,
         and pressing it would take the reader somewhere unexpected. -->
    <DataTemplate x:Key="PlaylistTemplate" x:DataType="model:ArtistPlaylist">
      <Button Click="Playlist_Click" Tag="{Binding}"
              Width="{Binding Metrics.Stride}"
              Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="6,6,6,8"
              HorizontalContentAlignment="Stretch" MinWidth="0" MinHeight="0"
              ToolTipService.ToolTip="{Binding Name}">
        <Button.Resources>
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FFFFFF"/>
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#28FFFFFF"/>
        </Button.Resources>
        <StackPanel Spacing="8">
          <Grid Width="{Binding Metrics.Art}" Height="{Binding Metrics.Art}">
            <Border CornerRadius="6" Background="#26FFFFFF"/>
            <Border CornerRadius="6">
              <Image Source="{Binding Cover}" Stretch="UniformToFill"
                     Visibility="{Binding HasCover, Converter={StaticResource BoolToVisible}}"/>
            </Border>
            <!-- No sleeve to borrow: the same generated picture that a record without artwork gets, made
                 from the playlist's name so that it belongs to this playlist. -->
            <Border CornerRadius="6" Background="{Binding FigureSeed, Converter={StaticResource SleeveFigure}}"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVisible}, ConverterParameter=Invert}"/>
            <!-- The mark is on dark glass so that it is readable on bright and dark sleeves. The reason
                 is the same as for `HeroChip`. -->
            <Border CornerRadius="5" Background="#99000000" Margin="0,0,6,6" Padding="6,3"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
              <TextBlock Text="&#xf8c9;" FontFamily="{StaticResource Fa}" FontSize="10"
                         Foreground="#EEFFFFFF"/>
            </Border>
          </Grid>
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource InkBody}"
                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource InkFaint}"
                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
          </StackPanel>
        </StackPanel>
      </Button>
    </DataTemplate>
    <!-- One song in the listing of all songs: its name and its length. It has one line and not two,
         because the listing is columns of about thirty rows and a second line would halve the number of
         songs on screen. The record that the song is on is in the tooltip, because a fact that is wanted
         only sometimes belongs there. -->
    <DataTemplate x:Key="TrackTemplate" x:DataType="model:ArtistSong">
      <Button Click="Song_Click" ContextRequested="Song_ContextRequested" Tag="{Binding}"
              PointerEntered="Song_PointerEntered" PointerExited="Song_PointerExited"
              HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
              Background="Transparent" BorderThickness="0" Padding="9,5" MinHeight="0" CornerRadius="6"
              ToolTipService.ToolTip="{Binding Subtitle}">
        <Button.Resources>
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FFFFFF"/>
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#28FFFFFF"/>
        </Button.Resources>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <!-- The heart's column is always reserved, whether or not a heart is shown. A heart that
                 appears under the pointer must not move the lengths as the pointer moves down the list. -->
            <ColumnDefinition Width="18"/>
          </Grid.ColumnDefinitions>
          <!-- The name, with the equaliser in front of it on the song that is playing. The mark belongs
               to the name, so it is directly against it and not in a separate column at the far side of
               the row, where it would look like another field. It is the same three bars as a line inside
               an opened record.

               A `TrimRow` is used and not a horizontal `StackPanel`, so a long title ends in an ellipsis
               and is not cut in the middle of a letter. -->
          <ctl:TrimRow Grid.Column="0" Spacing="6" VerticalAlignment="Center">
            <!-- No offset is needed: the mark has its own baseline offset, so centring it here is enough. -->
            <ctl:PlayingBars Active="{Binding IsPlaying}" Foreground="{StaticResource InkStrong}"
                             VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Title, Converter={StaticResource Censor}}" FontSize="12.5"
                       Foreground="{StaticResource InkBody}" ctl:TrimRow.Shrinks="True"
                       TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"/>
          </ctl:TrimRow>
          <TextBlock Grid.Column="1" Text="{Binding Duration}" FontSize="11.5"
                     Foreground="{StaticResource InkFaint}" VerticalAlignment="Center"/>
          <Button Grid.Column="2" Click="SongFavorite_Click" Tag="{Binding}"
                  Background="Transparent" BorderThickness="0" CornerRadius="4"
                  Width="18" Height="18" MinWidth="0" MinHeight="0" Padding="0"
                  VerticalAlignment="Center"
                  Visibility="{Binding ShowHeart, Converter={StaticResource BoolToVisible}}"
                  ToolTipService.ToolTip="{loc:Str Key=Track_Favorite}"
                  AutomationProperties.Name="{loc:Str Key=Track_Favorite}">
            <Button.Resources>
              <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22FFFFFF"/>
              <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FFFFFF"/>
            </Button.Resources>
            <Grid>
              <FontIcon Glyph="&#xf004;" FontFamily="{StaticResource Fa}" FontSize="11"
                        Foreground="{StaticResource FavoriteMarkBrush}"
                        Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisible}}"/>
              <FontIcon Glyph="&#xf004;" FontFamily="{StaticResource FaRegular}" FontSize="11"
                        Foreground="{StaticResource FavoriteMarkIdleBrush}"
                        Visibility="{Binding IsNotFavorite, Converter={StaticResource BoolToVisible}}"/>
            </Grid>
          </Button>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- The heading over one group under All tracks: a letter or a year. `ArtistTrackLayout` gives it the
         full width and a fixed height of 40. The text and its rule sit at the bottom, so the space above
         is the gap after the previous songs. The text lines up with the song titles, which are 9 from the
         row's edge. -->
    <DataTemplate x:Key="TrackHeadingTemplate" x:DataType="model:ArtistSongHeading">
      <StackPanel Spacing="4" Margin="9,0,9,4" VerticalAlignment="Bottom">
        <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource InkFaint}"/>
        <Rectangle Height="1" Fill="#22FFFFFF"/>
      </StackPanel>
    </DataTemplate>

    <!-- A song or a heading. This comes after both templates, because a `StaticResource` looks up the
         dictionary and not down it. -->
    <artists:ArtistTrackTemplates x:Key="TrackTemplates"
                                  Song="{StaticResource TrackTemplate}"
                                  Heading="{StaticResource TrackHeadingTemplate}"/>
  </UserControl.Resources>

  <Grid x:Name="Page" Background="{StaticResource GridSurfaceBrush}" SizeChanged="Page_SizeChanged">

    <!-- The page colour. The artist's colour covers the whole panel, not only the band at the top: the
         two columns are one page about one artist, and a coloured photograph over a flat grey surface
         looks pasted onto a different app. It is worked out in the same way as the artist's box on the
         wall, so opening a box looks like the box growing.

         It is not shown until the answer about the artist arrives, and never for an artist with no
         photograph and no sleeve to take a colour from. It stands in for the panel's surface and does not
         cover it. -->
    <Rectangle x:Name="PageGround" Visibility="Collapsed"/>

    <!-- The photograph as the page background. The artist's picture, blurred until it is no longer a
         picture, fills the panel behind everything. What remains is the light and dark of the picture in
         the artist's colour, which stops the area under the text from being a flat gradient.

         It is a `Border` that uses the picture as its `Background`, and not an `Image`. A background is
         painted inside the element's own bounds, so a wide photograph is cropped by the panel and cannot
         paint outside it. An `Image` would rely on the control to clip its overflow. (Uno's Skia renderer
         draws an `ImageBrush` as a background, but draws nothing for one used as a `Shape` fill. The
         track pane's wash is built in the same way, see `PaneWash`.)

         The blur is done once, off the UI thread, when the picture is first fetched, and never here. A
         composition blur runs on every frame while the page is shown and needs an effect pipeline that
         some machines do not have. What is drawn here is an ordinary picture. See `ArtScaler.Wash`.

         This layer is under the weight layer. The black layer above it lowers the bright parts of the
         picture, and the same guarantee that keeps the text white for every artist lets the picture be
         strong enough to be seen. If it were over the weight, it would have to carry its own readability
         and could only be used at very low opacity. -->
    <Border x:Name="PageWash" Opacity="0.55" Visibility="Collapsed" IsHitTestVisible="False">
      <Border.Background>
        <ImageBrush x:Name="PageWashArt" Stretch="UniformToFill"/>
      </Border.Background>
    </Border>

    <!-- The weight over both layers. A palette accent at full strength has the colour of the largest area
         of a photograph at its original exposure, and a blurred photograph keeps that exposure.
         Paragraphs and track listings on either would be unreadable. Under this layer the page is lit by
         the picture, which is what the four inks above assume: white text for every artist. -->
    <Rectangle x:Name="PageWeight" Fill="#6B000000" Visibility="Collapsed"/>


    <Grid>
      <Grid.ColumnDefinitions>
        <!-- Who they are. The width is fixed on purpose: this column holds a photograph and a paragraph,
             and both have a width they need. A share of the panel would make the biography four words
             wide in a narrow window and forty in a wide one. When there is no room for it, the column
             closes and its contents move to the top of the shelves (see `Page_SizeChanged`). -->
        <!-- Set on every resize by `AboutWidthFor` in the code behind: a share of the panel between a
             minimum and a maximum. The value here is only the width before the first pass. -->
        <ColumnDefinition x:Name="AboutColumn" Width="440"/>
        <!-- What they made: a shelf that takes the remaining width. -->
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- The artist column scrolls separately. One scroller for the whole page would mean reading a
           listing of four hundred songs next to a photograph that left the screen after the first thirty. -->
      <ScrollViewer x:Name="AboutScroll" Grid.Column="0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                    Padding="0,0,0,20">
        <StackPanel x:Name="AboutPanel" Spacing="16">

          <!-- The band across the top: their photograph, with its colour removed and washed in their
               colour, as their box on the wall is. It scrolls with the column and does not stay over it,
               because it is the top of the content and not a title bar. -->
          <!-- The picture height is a share of its width and not a fixed number. The column is a share of
               the panel and folds into the shelves on a narrow panel, so a fixed height would be too flat
               in one state and too small in the other. It is set from the band's width in
               `HeroBand_SizeChanged`. -->
          <!-- Flush with the column on the left, and ending level with the cards on the right. It is not
               centred and not full width: the picture runs to the panel's edge, and squaring it against
               the cards below makes the column one piece. The 18 is the cards' own inset. Change it there
               and here. -->
          <!-- A press anywhere on the picture stops the slideshow. The handler is on the `Grid` and not
               on the photograph layers, because those two swap places on every dissolve and a handler on
               the one that is up would miss every other press. Buttons on the band are not affected: a
               `Button` marks `PointerPressed` as handled, so a press on an arrow does not reach here and
               the arrows step without stopping the show. -->
          <!-- The background is `Transparent` and not unset: a `Panel` with no `Background` is not
               hit-tested in WinUI. The grid is outside `HeroLayers`, so the foot fade does not copy it
               and it paints nothing. -->
          <Grid x:Name="HeroBand" Height="360" Margin="0,0,18,0" Background="Transparent"
                SizeChanged="HeroBand_SizeChanged" PointerPressed="HeroBand_PointerPressed">
            <!-- The band and how it ends. The picture does not stop at a line and is not darkened into
                 one. Its own pixels are removed towards the foot, so the page shows through there: the
                 artist's colour, the blurred photograph, or whatever is behind. It is not a bar of colour
                 painted over the last part of the picture.

                 This is the same method as the track pane's photograph (see `PhotoFootFade` there). A
                 ramp to a flat colour works only when there is one flat colour behind it, and here there
                 is not. So a `CompositionVisualSurface` holds a live copy of these layers, a
                 `CompositionMaskBrush` multiplies that copy by a white-to-transparent ramp, and a sprite
                 paints the result in the band at the foot. The live layers are clipped away in the same
                 band, so they are not also visible at full strength underneath.

                 XAML cannot express this because WinUI has no `OpacityMask`. It is set up in
                 `EnsureHeroFade` and sized in `UpdateHeroFade`. -->

            <!-- The wrapper that the clip is applied to. The clip cannot be on the layers themselves: the
                 copy is their rendering, including the clip, so the band would be cut out of the thing
                 that paints it back. -->
            <Grid x:Name="HeroCut">
              <!-- The layers that are copied. Everything that the dissolve should carry is inside.
                   Everything that must stay solid (the name, the back button) is outside. -->
              <Grid x:Name="HeroLayers" SizeChanged="HeroLayers_SizeChanged">
                <!-- The app's dark colour under a photograph, or the colour of their first record when
                     there is no photograph. -->
                <Rectangle x:Name="PortraitGround"/>

                <!-- Their photograph as it was taken. This is the difference from their box on the wall.
                     The wall removes the colour of a picture and lays the artist's colour over it,
                     because many press photographs in different lighting only look like one wall when
                     they share a palette. This page shows one artist, so there is no wall to match, and
                     that treatment would only be a colour cast on the one photograph. -->
                <!-- Used as a `Background` and not shown as an `Image`, for the reason given at
                     `PageWash`. A background is painted inside the element's bounds. A picture of another
                     shape is scaled to cover the band and is centred in it. (An `Image` on Skia draws its
                     scaled copy from the top left corner, so a wide photograph would lose its right side
                     and not an even part of each end.)

                     There are two layers and they are identical on purpose. Paging through the
                     photographs dissolves one into the next: the next picture is put on the layer that is
                     down, and the two swap opacity. One layer with its source changed during a fade would
                     not work: for the frame between the two writes there is no picture, and the ground
                     shows through. The code decides which layer is up (see `Show`), and neither is the
                     main portrait.

                     The picture is anchored to the top, so a picture taller than the band loses its
                     bottom and not an even part of both ends. A square picture in this 4:3 band loses a
                     quarter of its height. If it were centred, an eighth would be cut from the top, where
                     the heads are, and heads in group photographs would be cut off. A wide photograph,
                     shown only for an artist with no square one, is a `RunOff` canvas (the photo with its
                     reflection under it) and also needs the top anchor. The generated figure and the
                     shelf mosaic are drawn at 4:3, so the anchor does not move them. -->
                <Border x:Name="Portrait" Visibility="Collapsed">
                  <Border.Background>
                    <ImageBrush x:Name="PortraitArt" Stretch="UniformToFill"
                                AlignmentX="Center" AlignmentY="Top"/>
                  </Border.Background>
                </Border>
                <Border x:Name="PortraitNext" Visibility="Collapsed" Opacity="0">
                  <Border.Background>
                    <ImageBrush x:Name="PortraitNextArt" Stretch="UniformToFill"
                                AlignmentX="Center" AlignmentY="Top"/>
                  </Border.Background>
                </Border>

                <!-- Their colour over the photograph, in the same arrangement as their box but at a third
                     of its strength (see `ArtistVeil.Page`). The strength of the box suits a postcard
                     with a name across it. On a photograph 400 points tall it looks like a picture
                     printed in one ink. -->
                <Rectangle x:Name="PortraitVeil"/>
              </Grid>
            </Grid>

            <!-- The last part of the picture is painted back here, with its alpha ramped away. It is
                 empty in the markup and ignores the pointer: a composition sprite is put in it, and its
                 height is the depth of the dissolve, set in code. -->
            <Grid x:Name="HeroFootFade" VerticalAlignment="Bottom" Height="0"
                  IsHitTestVisible="False"/>

            <!-- The back button is in the card's own corner, the same corner as the key on the album
                 page. A reader who goes from an artist to a record and back must find the way out in the
                 same place. The offset is the album page's `PageAir` (`AlbumPageDensity`), the space that
                 page keeps at every edge. It is written here and not read, because this page should not
                 ask the album page's layout how wide a column is. -->
            <Button Click="Back_Click" Style="{StaticResource HeroChip}"
                    Margin="28,28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    ToolTipService.ToolTip="{loc:Str Key=Artists_Back}"
                    AutomationProperties.Name="{loc:Str Key=Artists_Back}">
              <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4D000000"/>
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#66000000"/>
              </Button.Resources>
              <TextBlock Text="&#xf060;" FontFamily="{StaticResource Fa}" FontSize="12" Foreground="#EEFFFFFF"/>
            </Button>

            <!-- The name and the picture controls share the foot of the band in one row and are not laid
                 over each other. The name is as long as the artist's name, and buttons floating over the
                 right side of the same corner would sit on top of a long name. -->
            <Grid Margin="18,0,18,16" VerticalAlignment="Bottom" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- Their name, shown in one of two ways. The logo is the act's own lettering from their
                   sleeves. When a catalogue has one, it is the title of this page. The text below is the
                   name that the tags spell, which is whatever the person who ripped the disc typed. Only
                   one of the two is shown at a time, because both would say the same name twice.

                   The text is the one that starts visible. Most artists have no logo, and a logo arrives
                   from the network some seconds after the page opens, so a page that started with a gap
                   would look as if it did not know its own title. -->
              <Grid>
                <TextBlock x:Name="ArtistName" FontSize="28" FontWeight="Bold" Foreground="#FFFFFFFF"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>

                <!-- Uniform and limited in both directions, never stretched: a logo is drawn lettering
                     and must not be squashed. `Uniform` makes two limits safe: a mark that meets the
                     width limit is drawn smaller and not narrower.

                     The height limit is a little more than two lines of 28-point text, which is the most
                     that the text it replaces can use, so a page with a logo and a page without have the
                     same height. It is the maximum here and not the size: the code lowers it for a mark
                     that arrives smaller (see `LogoCap` and `LogoAsync`).

                     The width limit is not set here because it is a share of the band: see
                     `ArtistPageLayout.LogoWidthShare`, applied in `HeroBand_SizeChanged` and read by
                     `LogoAsync`, so the picture is cut to the size at which it is drawn. Height alone
                     cannot limit a mark, because the width depends on the length of the act's name, and a
                     long name set as one word can cross the whole band at a height that suits a short
                     name.

                     Left-aligned, so that wide and narrow marks start where the text starts. This works
                     only because the picture arrives cut to its lettering (see `ArtistLogos`). As the
                     catalogues publish them, every logo is the same 800 by 310 canvas, and aligning the
                     canvas would put a short mark a third of the way across the page with nothing to its
                     left. -->
                <Image x:Name="ArtistLogo" Visibility="Collapsed"
                       Stretch="Uniform" MaxHeight="72"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
              </Grid>

              <!-- Back, play and forward through the artist's photographs. Hidden until there is more
                   than one picture. An artist with one photograph, or with a generated figure for a band,
                   would see three buttons that do nothing. -->
              <StackPanel x:Name="PhotoControls" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Bottom" Visibility="Collapsed">
                <Button Click="PhotoPrevious_Click" Style="{StaticResource HeroChip}"
                        ToolTipService.ToolTip="{loc:Str Key=Artists_PhotoPrevious}"
                        AutomationProperties.Name="{loc:Str Key=Artists_PhotoPrevious}">
                  <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4D000000"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#66000000"/>
                  </Button.Resources>
                  <TextBlock Text="&#xf053;" FontFamily="{StaticResource Fa}" FontSize="12" Foreground="#EEFFFFFF"/>
                </Button>

                <!-- The slideshow switch. It is hidden and kept in the tree: the slideshow starts itself
                     when there is more than one photograph and stops on a press anywhere on the picture,
                     so this button has no state to show. `Slideshow` still sets its glyph and tooltip, so
                     showing it again needs only one line. -->
                <Button x:Name="PhotoAuto" Click="PhotoAuto_Click" Style="{StaticResource HeroChip}"
                        Visibility="Collapsed">
                  <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4D000000"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#66000000"/>
                  </Button.Resources>
                  <TextBlock x:Name="PhotoAutoGlyph" Text="&#xf04b;" FontFamily="{StaticResource Fa}"
                             FontSize="11" Foreground="#EEFFFFFF"/>
                </Button>

                <Button Click="PhotoNext_Click" Style="{StaticResource HeroChip}"
                        ToolTipService.ToolTip="{loc:Str Key=Artists_PhotoNext}"
                        AutomationProperties.Name="{loc:Str Key=Artists_PhotoNext}">
                  <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4D000000"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#66000000"/>
                  </Button.Resources>
                  <TextBlock Text="&#xf054;" FontFamily="{StaticResource Fa}" FontSize="12" Foreground="#EEFFFFFF"/>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- Still asking. MusicBrainz answers one request a second and a cold lookup makes several, so
               the wait is real and the column should not look finished while it runs.

               This is the same turning record that the track pane shows for the same wait. It is the
               app's mark for "a catalogue is being read", and a second one would be two answers to one
               question. The area below it is empty while it is shown, because the cards are what is
               awaited.

               It is not shown for an artist whose data is already in hand. That data is painted on the
               frame the page opens (see `PapersCached`), and a spinner for one frame over a card that is
               already there would be a visible pop. -->
          <ctl:RecordSpinner x:Name="PapersBusy" Width="52" Height="52" Margin="18,10,18,10"
                             HorizontalAlignment="Center"/>

          <!-- Shelf note. This is the only card that is shown for one name: the name at the top of the
               page is not a person there. "Various Artists" is where every record by more than one act is
               filed (see `ArtistWall.Compilations`). Everything else in this column is a fact about
               someone (a biography, a line-up, a link to their page), and for this shelf all of those are
               blank, so the reader would see a name, a photograph of nothing and no explanation.

               It is tied to the compilations shelf only. It is not a general "about this page" card, and
               an artist with no biography must not get it. It is shown in `Load`, from
               `ArtistCredit.IsVariousArtists`, which is the same test that the loaders use to not ask the
               catalogues about this name. -->
          <StackPanel x:Name="ShelfNoteBlock" Spacing="8" Margin="18,0,18,0" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Artists_AboutCompilations}" Style="{StaticResource BlockHeading}"/>
            <Border Background="{StaticResource InkPlate}" CornerRadius="8" Padding="14">
              <TextBlock Text="{loc:Str Key=Artists_CompilationsNote}" Style="{StaticResource Prose}"/>
            </Border>
          </StackPanel>

          <!-- What the encyclopedias say about them. Everything in this card arrives from the network
               some seconds after the shelves are full, so it stays hidden until it has content: a heading
               over an empty card would look like a gap in a database. See `PapersAsync`. -->
          <StackPanel x:Name="AboutBlock" Spacing="8" Margin="18,0,18,0" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=TrackInfo_AboutArtist}" Style="{StaticResource BlockHeading}"/>
            <Border Background="{StaticResource InkPlate}" CornerRadius="8" Padding="14">
              <StackPanel Spacing="8">
                <!-- The catalogue's name for them, and not the collection's. The two often differ, so
                     both are shown: the band at the top shows what the tags spell, and this shows who
                     MusicBrainz says it is. -->
                <TextBlock x:Name="AboutName" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource InkStrong}" TextWrapping="Wrap"/>
                <TextBlock x:Name="AboutFacts" FontSize="11" Foreground="{StaticResource InkFaint}"
                           TextWrapping="Wrap"/>
                <!-- The whole article is shown. The track pane shows a lead paragraph with "Show more",
                     because that column is 300 points wide and has a fact sheet, a tracklist and two more
                     cards, so a long biography would push everything off the pane. This is a page about
                     the artist, in a column that scrolls separately and has only the wall behind it. The
                     reason for the fold does not apply here. -->
                <TextBlock x:Name="AboutProse" Style="{StaticResource Prose}"/>

                <!-- Wikipedia asks to be named, and the reader should know the source. -->
                <ctl:RpmLink x:Name="AboutSourceButton"
                             Click="AboutSource_Click" FontSize="11"/>
                <!-- The licence of the Wikipedia text above (CC BY-SA 4.0), shown when the source link is. -->
                <ctl:CcBySaLink Visibility="{Binding Visibility, ElementName=AboutSourceButton}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Where else they are written about. One link per line and not a wrapped row of pills: in a
               column the links have one left edge for the eye, in a meaningful order. Filled in code,
               because the length of the list depends on the catalogues. -->
          <StackPanel x:Name="LinksBlock" Spacing="8" Margin="18,0,18,0" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=TrackInfo_Elsewhere}" Style="{StaticResource BlockHeading}"/>
            <StackPanel x:Name="LinksRow" Spacing="4"/>
          </StackPanel>

          <!-- The records of theirs that most people own, from Discogs. Filled in code, because the
               number depends on the answer of the catalogue. The whole block is hidden when there is no
               answer. That includes every user who has not connected a Discogs account, because the data
               is read with their account. -->
          <StackPanel x:Name="PopularBlock" Spacing="8" Margin="18,0,18,0" Visibility="Collapsed">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Str Key=Artists_Popular}" Style="{StaticResource BlockHeading}"/>
              <!-- The source of the order, said once and quietly. A ranking with no source must be taken
                   on trust, and this one has a specific meaning: how many collectors own the record. -->
              <TextBlock Text="{loc:Str Key=Artists_PopularSource}" FontSize="10.5"
                         Foreground="{StaticResource InkFaint}"/>
            </StackPanel>
            <!-- Eight and not fourteen, on purpose: the rows in this card can be pressed and have their
                 own padding of 6, so eight plus six is the fourteen that every other card on the page
                 uses to inset its text. This gives one left edge down the column. -->
            <Border Background="{StaticResource InkPlate}" CornerRadius="8" Padding="8">
              <StackPanel Spacing="2">
                <StackPanel x:Name="PopularList" Spacing="2"/>
                <!-- The one reason for an empty card that the reader can act on, so it is the one that is
                     printed. All the others (no Discogs page for this artist, a rate limit, no network)
                     hide the whole card, because a card that explains a condition nobody can fix is in
                     the way. -->
                <TextBlock x:Name="PopularConnect" Text="{loc:Str Key=Artists_PopularConnect}"
                           FontSize="11.5" Foreground="{StaticResource InkFaint}"
                           TextWrapping="Wrap" Margin="6,2,6,2" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Who is in the band, under the card about the band. Only for a group, and only when the
               catalogue has the data. -->
          <StackPanel x:Name="MembersBlock" Spacing="8" Margin="18,0,18,0" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=TrackInfo_Members}" Style="{StaticResource BlockHeading}"/>
            <Border Background="{StaticResource InkPlate}" CornerRadius="8" Padding="14,10,14,10">
              <StackPanel x:Name="MembersList" Spacing="6"/>
            </Border>
          </StackPanel>

          <!-- The wall. What listeners have said about this artist, and what they have done to their
               records. There are two kinds of line in one list: a post, which is a listener's own words,
               and a line that the server writes when a listener reviews or rates a record filed under
               this artist. Nothing private is shown: what a listener added to their collection, marked as
               a favourite or put in a playlist is not public.

               The card is the album page's comment, read as one column: the same avatar, name and date,
               and the same overflow menu with a delete on your own line and a report on the lines of
               others. A review line shows its verdict in stars under the sentence and not beside it,
               because the sentence wraps and a rating at the end of a wrapped line would be in a
               different place at each column width.

               Reading needs no account and writing does. When signed out, the wall is still drawn, and
               the banner under the box says why the send key does nothing. -->
          <StackPanel x:Name="WallBlock" Spacing="8" Margin="18,0,18,0">
            <TextBlock Text="{loc:Str Key=Artists_Wall}" Style="{StaticResource BlockHeading}"/>

            <!-- One card holds the feed over the box, because they are one thing: what is on the wall and
                 the line you would add to it. -->
            <Border Background="{StaticResource InkPlate}" CornerRadius="8" Padding="14,10,14,10">
              <StackPanel Spacing="10">

                <!-- Square at any column width: the height follows the width in `WallFeed_SizeChanged`. A
                     feed that must be scrolled reads as a feed. -->
                <Grid>
                  <ScrollViewer x:Name="WallFeed" SizeChanged="WallFeed_SizeChanged"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="WallFeedList" Margin="0,0,10,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="model:WallRow">
                          <Grid ColumnSpacing="10" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Their picture, or the first letter of their name on the tinted disc that
                                 the album page's comments use. -->
                            <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Top">
                              <Border CornerRadius="14" Background="#2604C8FF"
                                      Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisible}, ConverterParameter=Invert}">
                                <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#04C8FF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <ctl:AvatarPicture CornerRadius="14" Source="{Binding AvatarUrl}"
                                                 Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisible}}"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Spacing="2">
                              <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding AuthorName}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#FF6FD3FF"/>

                                <!-- The mark for the kind of line: a bubble for something said, a star
                                     for a verdict on a record. -->
                                <FontIcon Grid.Column="1" Glyph="&#xf075;" FontSize="10"
                                          FontFamily="{StaticResource Fa}"
                                          Foreground="{StaticResource WallSaidTint}"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding IsPost, Converter={StaticResource BoolToVisible}}"/>
                                <FontIcon Grid.Column="1" Glyph="&#xf005;" FontSize="10"
                                          FontFamily="{StaticResource Fa}"
                                          Foreground="{StaticResource WallStarTint}"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding IsReview, Converter={StaticResource BoolToVisible}}"/>

                                <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="11"
                                           Foreground="{StaticResource InkFaint}" VerticalAlignment="Center"/>
                              </Grid>

                              <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                         Foreground="{StaticResource InkBody}"/>

                              <ctl:StarRating Value="{Binding Stars}" GlyphSize="11"
                                              HorizontalAlignment="Left" Margin="0,2,0,0"
                                              Visibility="{Binding HasStars, Converter={StaticResource BoolToVisible}}"/>
                            </StackPanel>

                            <!-- Delete what is yours, report what is not. It uses the same corner and
                                 glyph as a comment on the album page. -->
                            <Button Grid.Column="2" Click="WallMenu_Click" Tag="{Binding}"
                                    Background="Transparent" BorderThickness="0" Padding="6,2"
                                    MinWidth="0" MinHeight="0" VerticalAlignment="Top"
                                    AutomationProperties.Name="{loc:Str Key=Common_MoreOptions}">
                              <FontIcon Glyph="&#xf142;" FontFamily="{StaticResource Fa}" FontSize="11"
                                        Foreground="#66FFFFFF"/>
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <!-- What is here and how to fill it. It is over the empty list and not instead of it,
                       so the card keeps its square size and the cards under it do not move when the wall
                       fills. -->
                  <TextBlock x:Name="WallEmpty" Text="{loc:Str Key=Artists_WallEmpty}"
                             FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource InkFaint}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             TextAlignment="Center" Margin="12,0,12,0"
                             Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>

                <!-- What is on the wall, and under the rule, what you would add to it. -->
                <Border Height="1" Background="#18FFFFFF"/>

                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <TextBox x:Name="WallEntry" Grid.Column="0" FontSize="12" MinHeight="0"
                           Background="Transparent" BorderThickness="0" Padding="0"
                           Foreground="{StaticResource InkStrong}"
                           TextWrapping="Wrap" AcceptsReturn="True" MaxLength="2000"
                           IsSpellCheckEnabled="True" TextChanged="WallEntry_TextChanged"
                           VerticalAlignment="Center"
                           PlaceholderText="{loc:Str Key=Artists_WallPlaceholder}">
                    <!-- The theme's filled box and focus underline are removed, as for the two search
                         fields on this page. -->
                    <TextBox.Resources>
                      <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                      <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                      <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                  </TextBox>

                  <ctl:RpmPrimaryButton x:Name="WallSend" Grid.Column="1" Click="WallSend_Click"
                                        IsEnabled="False" Height="30" Padding="14,0"
                                        VerticalAlignment="Bottom">
                    <TextBlock Text="{loc:Str Key=Album_Send}" FontSize="12" FontWeight="SemiBold"/>
                  </ctl:RpmPrimaryButton>
                </Grid>

                <!-- Signed out, or the API did not answer: the wall is still shown, and this says why the
                     send key does nothing. -->
                <Grid x:Name="WallBannerBlock" ColumnSpacing="12" Visibility="Collapsed">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="WallBannerText" Grid.Column="0" FontSize="11" TextWrapping="Wrap"
                             Foreground="{StaticResource InkQuiet}" VerticalAlignment="Center"/>
                  <Button x:Name="WallSignIn" Grid.Column="1" Click="WallSignIn_Click" Height="26"
                          Padding="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Str Key=Album_SignIn}" FontSize="11"/>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- What of theirs is here. How much of this artist the collection holds. This is a fact about
               the library and not about the artist, so it is in the column of cards with the other facts,
               and the band shows only their name and picture.

               It is last on purpose: everything above is what the catalogues say, and this is the one
               card that is true whether or not anything answered. -->
          <StackPanel x:Name="LibraryBlock" Spacing="8" Margin="18,0,18,0">
            <TextBlock Text="{loc:Str Key=Artists_InLibrary}" Style="{StaticResource BlockHeading}"/>
            <Border Background="{StaticResource InkPlate}" CornerRadius="8" Padding="14,10,14,10">
              <TextBlock x:Name="ArtistStats" FontSize="12" Foreground="{StaticResource InkStrong}"
                         TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- What they made. Seven shelves and a listing: their own records, records of other artists that
           they appear on, records made with someone else, and then records by what their titles say: a
           live record, music for the screen, a compilation, a single. The scroller has no side padding.
           Each shelf has its own left margin and runs off the right edge of the panel, which shows that a
           shelf continues past the screen.

           Every shelf is a `KeyedRow`, as on the home screen: stepped by a key at each end and by nothing
           else, with no bar and no mouse wheel. `KeyBand` puts the keys on the sleeve: 6 of card padding
           above the picture, and 50 of text and padding under it (8 + 17 + 2 + 15 + 8). -->
      <ScrollViewer x:Name="BodyScroll" Grid.Column="1" SizeChanged="BodyScroll_SizeChanged"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                    Padding="0,0,0,24">
        <StackPanel x:Name="Body" Spacing="22" Margin="0,18,0,0">

          <!-- Their own records. -->
          <StackPanel x:Name="RecordsSection" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Artists_Albums}" Style="{StaticResource ShelfHeading}"
                       Margin="18,0,18,0"/>
            <ctl:KeyedRow CardPadding="12,0,12,0" KeyBand="0,6,0,50">
              <ItemsRepeater x:Name="Records" ItemTemplate="{StaticResource SleeveTemplate}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="2"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </ctl:KeyedRow>

            <!-- The record opened on this shelf. It is the album wall's own drawer, the control itself
                 and not a copy (see `AlbumBandView`), so a record opened here is the record opened there:
                 the same tracklist, the same three ways to play it, the same heart. It points a triangle
                 up at its sleeve, as the wall's drawer does, and names the record at its top.

                 The `Grid` is the drawer and not the control inside it: the triangle and the tracklist
                 open as one, so the animation that opens them owns this element, and the mark cannot
                 appear on the shelf before its drawer.

                 The wall places that mark by a fixed stride. A shelf scrolls sideways, so here the
                 position is the sleeve's index read against the shelf's current offset. It is asked again
                 each time the shelf moves, and the mark is hidden when its sleeve has scrolled off either
                 end. See `ArtistDetailView.PointAtOpenSleeve` and `BandPointer.Ramp`. -->
            <!-- The top margin of -2 is arithmetic. The space between a card's text and the drawer's
                 plate is 8 of card padding + 10 of section spacing + the drawer's own 10, which is 28.
                 The home screen uses 26 (8 + 8 + 10) and the album wall 22. With -2 the space is 26, as
                 on the home screen, so a record opened on any of the three sits the same distance under
                 its card. -->
            <Grid x:Name="RecordsDrawer" Margin="0,-2,0,0" Visibility="Collapsed">
              <Polygon x:Name="RecordsPoint" Points="0,12 10,0 20,12" Width="20" Height="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
              <lib:AlbumBandView x:Name="RecordsBand" Margin="18,10,18,0"/>
            </Grid>
          </StackPanel>

          <!-- The records of other artists that they appear on: the other half of what a featured credit
               means, and the reason one album is on two artists' pages. It is a shelf and not a list of
               songs: it shows which records those are, and the songs are all together in the listing
               below. -->
          <StackPanel x:Name="GuestSection" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Artists_AppearsOn}" Style="{StaticResource ShelfHeading}"
                       Margin="18,0,18,0"/>
            <ctl:KeyedRow CardPadding="12,0,12,0" KeyBand="0,6,0,50">
              <ItemsRepeater x:Name="Guest" ItemTemplate="{StaticResource SleeveTemplate}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="2"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </ctl:KeyedRow>

            <!-- The record opened on this shelf: the album wall's drawer, the control itself and not a
                 copy (see `AlbumBandView`), so a record opened here is the record opened there: the same
                 tracklist, the same three ways to play it, the same heart. The drawer and its triangle
                 are as on the shelf above. -->
            <Grid x:Name="GuestDrawer" Margin="0,-2,0,0" Visibility="Collapsed">
              <Polygon x:Name="GuestPoint" Points="0,12 10,0 20,12" Width="20" Height="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
              <lib:AlbumBandView x:Name="GuestBand" Margin="18,10,18,0"/>
            </Grid>
          </StackPanel>

          <!-- The records they made with someone: a split single, a collaboration album, a mixtape with
               two names on it. These are neither records filed under them alone nor records of someone
               else that they appear on. It is under the appearances because it is the rarest of the
               three, and a page whose first shelf is the records the artist made answers the first
               question first. -->
          <StackPanel x:Name="TogetherSection" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Artists_Collaborations}" Style="{StaticResource ShelfHeading}"
                       Margin="18,0,18,0"/>
            <ctl:KeyedRow CardPadding="12,0,12,0" KeyBand="0,6,0,50">
              <ItemsRepeater x:Name="Together" ItemTemplate="{StaticResource SleeveTemplate}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="2"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </ctl:KeyedRow>

            <!-- The record opened on this shelf: the album wall's drawer, the control itself and not a
                 copy (see `AlbumBandView`), so a record opened here is the record opened there: the same
                 tracklist, the same three ways to play it, the same heart. The drawer and its triangle
                 are as on the shelf above. -->
            <Grid x:Name="TogetherDrawer" Margin="0,-2,0,0" Visibility="Collapsed">
              <Polygon x:Name="TogetherPoint" Points="0,12 10,0 20,12" Width="20" Height="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
              <lib:AlbumBandView x:Name="TogetherBand" Margin="18,10,18,0"/>
            </Grid>
          </StackPanel>

          <!-- Their EPs: shorter records that are not singles. Only a release type puts a record here,
               set at import or in the album editor. No title identifies an EP reliably. -->
          <StackPanel x:Name="EpsSection" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Artists_Eps}" Style="{StaticResource ShelfHeading}"
                       Margin="18,0,18,0"/>
            <ctl:KeyedRow CardPadding="12,0,12,0" KeyBand="0,6,0,50">
              <ItemsRepeater x:Name="Eps" ItemTemplate="{StaticResource SleeveTemplate}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="2"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </ctl:KeyedRow>
            <Grid x:Name="EpsDrawer" Margin="0,-2,0,0" Visibility="Collapsed">
              <Polygon x:Name="EpsPoint" Points="0,12 10,0 20,12" Width="20" Height="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
              <lib:AlbumBandView x:Name="EpsBand" Margin="18,10,18,0"/>
            </Grid>
          </StackPanel>

          <!-- The records they played live. They are detected from the record's name, because nothing in
               the collection carries the fact (see `AlbumKind.IsLive`, which lists the words used and the
               records it knowingly gets wrong). They are apart from their albums because a live record is
               a different thing to look for: someone who wants the album wants the studio one, and a
               mixed shelf would make them read titles to tell the two apart. Live records are taken out
               of their own records and out of the collaborations above, so the question "which of these
               was played live" has one answer on this page. -->
          <StackPanel x:Name="LiveSection" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Artists_LiveAlbums}" Style="{StaticResource ShelfHeading}"
                       Margin="18,0,18,0"/>
            <ctl:KeyedRow CardPadding="12,0,12,0" KeyBand="0,6,0,50">
              <ItemsRepeater x:Name="Live" ItemTemplate="{StaticResource SleeveTemplate}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="2"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </ctl:KeyedRow>

            <!-- The record opened on this shelf: the album wall's drawer, the control itself and not a
                 copy (see `AlbumBandView`), so a record opened here is the record opened there: the same
                 tracklist, the same three ways to play it, the same heart. The drawer and its triangle
                 are as on the shelf above. -->
            <Grid x:Name="LiveDrawer" Margin="0,-2,0,0" Visibility="Collapsed">
              <Polygon x:Name="LivePoint" Points="0,12 10,0 20,12" Width="20" Height="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
              <lib:AlbumBandView x:Name="LiveBand" Margin="18,10,18,0"/>
            </Grid>
          </StackPanel>

          <!-- Their mixtapes, after the live records: released outside the album run, often free. Only a
               release type puts a record here. -->
          <StackPanel x:Name="MixtapesSection" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Artists_Mixtapes}" Style="{StaticResource ShelfHeading}"
                       Margin="18,0,18,0"/>
            <ctl:KeyedRow CardPadding="12,0,12,0" KeyBand="0,6,0,50">
              <ItemsRepeater x:Name="Mixtapes" ItemTemplate="{StaticResource SleeveTemplate}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="2"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </ctl:KeyedRow>
            <Grid x:Name="MixtapesDrawer" Margin="0,-2,0,0" Visibility="Collapsed">
              <Polygon x:Name="MixtapesPoint" Points="0,12 10,0 20,12" Width="20" Height="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
              <lib:AlbumBandView x:Name="MixtapesBand" Margin="18,10,18,0"/>
            </Grid>
          </StackPanel>

          <!-- The music they wrote for something that is watched: a film, a game, a stage show. It is
               detected from the name like the shelves around it, because no tag says that a record is a
               soundtrack (see `AlbumKind.IsSoundtrack`, which lists the phrases used and the soundtracks
               that are named only for their film). It is under the live shelf and above the compilations.
               A soundtrack is a record they made, so it goes with the records and not after them, but
               nobody who opens an artist wants the film they scored first, and a discography that opens
               with two of them looks like an artist who stopped making albums. -->
          <StackPanel x:Name="SoundtracksSection" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Artists_Soundtracks}" Style="{StaticResource ShelfHeading}"
                       Margin="18,0,18,0"/>
            <ctl:KeyedRow CardPadding="12,0,12,0" KeyBand="0,6,0,50">
              <ItemsRepeater x:Name="Soundtracks" ItemTemplate="{StaticResource SleeveTemplate}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="2"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </ctl:KeyedRow>

            <!-- The record opened on this shelf: the album wall's drawer, the control itself and not a
                 copy (see `AlbumBandView`), so a record opened here is the record opened there: the same
                 tracklist, the same three ways to play it, the same heart. The drawer and its triangle
                 are as on the shelf above. -->
            <Grid x:Name="SoundtracksDrawer" Margin="0,-2,0,0" Visibility="Collapsed">
              <Polygon x:Name="SoundtracksPoint" Points="0,12 10,0 20,12" Width="20" Height="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
              <lib:AlbumBandView x:Name="SoundtracksBand" Margin="18,10,18,0"/>
            </Grid>
          </StackPanel>

          <!-- Their records gathered after the fact: greatest hits, essentials, collections. They are
               detected from the name like the shelves above, for the same reason: no tag says that a
               record is a compilation, and only the words that the industry sells them under do (see
               `AlbumKind.IsCompilation`). It has its own shelf because a compilation is not a record that
               someone made: among the albums it would put a hits package before the album that the hits
               come from, which is the wrong order for a discography. -->
          <StackPanel x:Name="CompilationsSection" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Artists_Compilations}" Style="{StaticResource ShelfHeading}"
                       Margin="18,0,18,0"/>
            <ctl:KeyedRow CardPadding="12,0,12,0" KeyBand="0,6,0,50">
              <ItemsRepeater x:Name="Compilations" ItemTemplate="{StaticResource SleeveTemplate}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="2"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </ctl:KeyedRow>

            <!-- The record opened on this shelf: the album wall's drawer, the control itself and not a
                 copy (see `AlbumBandView`), so a record opened here is the record opened there: the same
                 tracklist, the same three ways to play it, the same heart. The drawer and its triangle
                 are as on the shelf above. -->
            <Grid x:Name="CompilationsDrawer" Margin="0,-2,0,0" Visibility="Collapsed">
              <Polygon x:Name="CompilationsPoint" Points="0,12 10,0 20,12" Width="20" Height="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
              <lib:AlbumBandView x:Name="CompilationsBand" Margin="18,10,18,0"/>
            </Grid>
          </StackPanel>

          <!-- The songs released on their own. They are on this page for completeness and are not what
               most people open it to see: a prolific artist has more singles than albums, and mixed in
               they bury the records. They are recognised by the trailing note that every store writes,
               for example "Runaway - Single" (see `AlbumKind.IsSingle`, which explains the dash that is
               half of the rule). Last, under everything that is a record. -->
          <StackPanel x:Name="SinglesSection" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Artists_Singles}" Style="{StaticResource ShelfHeading}"
                       Margin="18,0,18,0"/>
            <ctl:KeyedRow CardPadding="12,0,12,0" KeyBand="0,6,0,50">
              <ItemsRepeater x:Name="Singles" ItemTemplate="{StaticResource SleeveTemplate}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="2"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </ctl:KeyedRow>

            <!-- The record opened on this shelf: the album wall's drawer, the control itself and not a
                 copy (see `AlbumBandView`), so a record opened here is the record opened there: the same
                 tracklist, the same three ways to play it, the same heart. The drawer and its triangle
                 are as on the shelf above. -->
            <Grid x:Name="SinglesDrawer" Margin="0,-2,0,0" Visibility="Collapsed">
              <Polygon x:Name="SinglesPoint" Points="0,12 10,0 20,12" Width="20" Height="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
              <lib:AlbumBandView x:Name="SinglesBand" Margin="18,10,18,0"/>
            </Grid>
          </StackPanel>

          <!-- Where this artist already is in the listener's own music. The shelves above are the
               collection read under this artist's name. This one is the listener's own filing read the
               same way, and it is the one shelf that says something about the listener and not the
               artist. It is after everything the artist made and before the listing of every song, which
               is where the page changes from a discography to a collection.

               A playlist is here because it holds one of their songs, and not because it is named after
               them: see `LibraryDatabase.PlaylistsHolding`, which also lists the two things it does not
               do: it does not follow a nested playlist, and it does not count the Now playing queue.

               There is no drawer under it, unlike the shelves above: a playlist is not a record and does
               not unfold into a tracklist here. Pressing one opens it in the Playlists view, the one
               place where a playlist is edited, reordered and played. Two such places would be two
               answers to one question. -->
          <StackPanel x:Name="PlaylistsSection" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Artists_InPlaylists}" Style="{StaticResource ShelfHeading}"
                       Margin="18,0,18,0"/>
            <ctl:KeyedRow CardPadding="12,0,12,0" KeyBand="0,6,0,50">
              <ItemsRepeater x:Name="Playlists" ItemTemplate="{StaticResource PlaylistTemplate}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="2"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </ctl:KeyedRow>
          </StackPanel>
          <!-- Every song of theirs that the collection holds, from both shelves at once, in columns.
               Columns because this listing is the one long thing on the page: one column of four hundred
               names would be four hundred one-line rows beside an empty half of the panel. -->
          <StackPanel x:Name="TracksSection" Spacing="10" Margin="9,0,9,0" Visibility="Collapsed">
            <!-- The heading, and at the far end of its line the search field for the list under it. It is
                 on the heading line and not above it, because the field belongs to this list only: a
                 search box floating over an artist would look like a search of the artist. -->
            <Grid Margin="9,0,9,0" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Str Key=Artists_AllTracks}"
                         Style="{StaticResource ShelfHeading}" VerticalAlignment="Center"/>

              <!-- Group by letter or by year. Shown only while the listing is grouped, which is above 20
                   songs (see `ArtistSongListing.Changed`). It is the same two-key switch as the library's
                   view switch: 26 high inside the hairline, 28 in all, the height of the search field. -->
              <Border x:Name="TrackGroupingSwitch" Grid.Column="1" Visibility="Collapsed"
                      CornerRadius="6" Padding="0" VerticalAlignment="Center"
                      Background="#22000000" BorderBrush="#22FFFFFF" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="0">
                  <StackPanel.Resources>
                    <Style x:Key="GroupingKey" TargetType="Button">
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderThickness" Value="0"/>
                      <Setter Property="Width" Value="32"/>
                      <Setter Property="Height" Value="26"/>
                      <Setter Property="MinWidth" Value="0"/>
                      <Setter Property="MinHeight" Value="0"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="FontFamily" Value="{StaticResource Fa}"/>
                      <Setter Property="FontSize" Value="12"/>
                      <Setter Property="HorizontalContentAlignment" Value="Center"/>
                      <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#28FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF"/>
                  </StackPanel.Resources>
                  <Button x:Name="TracksByLetter" Style="{StaticResource GroupingKey}" Content="&#xf15d;"
                          CornerRadius="5,0,0,5" Click="TracksByLetter_Click"
                          ToolTipService.ToolTip="{loc:Str Key=Artists_TracksByLetter}"
                          AutomationProperties.Name="{loc:Str Key=Artists_TracksByLetter}"/>
                  <Button x:Name="TracksByYear" Style="{StaticResource GroupingKey}" Content="&#xf073;"
                          CornerRadius="0,5,5,0" Click="TracksByYear_Click"
                          ToolTipService.ToolTip="{loc:Str Key=Artists_TracksByYear}"
                          AutomationProperties.Name="{loc:Str Key=Artists_TracksByYear}"/>
                </StackPanel>
              </Border>

              <!-- The same field that the wall of artists has, including the glyph and the clear button:
                   two searches on one screen that look different would look like two kinds of search. -->
              <Border Grid.Column="2" Width="200" Height="28" CornerRadius="6" Padding="9,0"
                      Background="#22000000" BorderBrush="#22FFFFFF" BorderThickness="1"
                      VerticalAlignment="Center">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="&#xf002;" FontSize="12" Foreground="#99FFFFFF"
                             VerticalAlignment="Center" FontFamily="{StaticResource Fa}"/>
                  <!-- The `TextBox` centres itself and does not stretch: if it were stretched, its
                       template would pin the text and the placeholder to the top of the box. -->
                  <TextBox Grid.Column="1" x:Name="TrackSearchBox" FontSize="12"
                           VerticalAlignment="Center" VerticalContentAlignment="Center"
                           Background="Transparent" BorderThickness="0" Padding="0"
                           MinHeight="0" Height="18"
                           PlaceholderText="{loc:Str Key=Artists_SearchTracks}"
                           TextChanged="TrackSearch_TextChanged"
                           KeyDown="TrackSearch_KeyDown">
                    <!-- Remove all the default `TextBox` chrome, as the wall's field does: the template
                         paints a filled box, a rounded border, and on focus an accent-blue bottom line
                         that `BorderThickness=0` on the control cannot remove. -->
                    <TextBox.Resources>
                      <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                      <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                      <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                  </TextBox>

                  <!-- The way to clear the search, shown only while there is something to clear. A search
                       that can be cleared only by selecting the text and deleting it is easy to leave on. -->
                  <Button x:Name="TrackSearchClear" Grid.Column="2" Click="TrackSearchClear_Click"
                          Visibility="Collapsed"
                          Background="Transparent" BorderThickness="0" CornerRadius="4"
                          Width="16" Height="16" MinWidth="0" MinHeight="0" Padding="0"
                          VerticalAlignment="Center"
                          ToolTipService.ToolTip="{loc:Str Key=Artists_SearchClear}"
                          AutomationProperties.Name="{loc:Str Key=Artists_SearchClear}">
                    <Button.Resources>
                      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22FFFFFF"/>
                      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FFFFFF"/>
                    </Button.Resources>
                    <TextBlock Text="&#xf00d;" FontSize="10" Foreground="#99FFFFFF"
                               FontFamily="{StaticResource Fa}"/>
                  </Button>
                </Grid>
              </Border>
            </Grid>
            <!-- Songs, and group headings when there are more than 20 (see `ArtistSongListing`), in one
                 repeater. There is not one repeater per letter: repeaters that share a `DataTemplate`
                 share its recycle pool, and a `UniformGridLayout` creates, measures and recycles its
                 first element on every pass to learn the item size. With twenty-seven repeaters they took
                 that element from each other and layout never finished. `ArtistTrackLayout` places
                 headings and songs by arithmetic and guards its own column count, so a zero width cannot
                 divide by zero. -->
            <ItemsRepeater x:Name="Tracks" ItemTemplate="{StaticResource TrackTemplates}">
              <ItemsRepeater.Layout>
                <artists:ArtistTrackLayout MinItemWidth="290" ColumnSpacing="6"
                                           RowHeight="30" RowSpacing="1" HeaderHeight="40"/>
              </ItemsRepeater.Layout>
            </ItemsRepeater>

            <TextBlock x:Name="NoTrackMatch" Text="{loc:Str Key=Artists_NoTrackMatch}"
                       FontSize="12.5" Foreground="{StaticResource InkFaint}"
                       Margin="18,6,18,10" Visibility="Collapsed"/>
          </StackPanel>

          <!-- The record spinner for the shelves being read, the same as in the column beside. It is the
               app's mark for a record being read. It only spins: it shows and hides itself. -->
          <ctl:RecordSpinner x:Name="Busy" Width="52" Height="52"
                             HorizontalAlignment="Center" Margin="0,26,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
