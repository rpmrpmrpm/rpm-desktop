<UserControl x:Class="RPM.Desktop.Presentation.Main.RightPane.RightRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:RPM.Desktop.Strings">

  <UserControl.Resources>
    <FontFamily x:Key="Fa">ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro Solid</FontFamily>
  </UserControl.Resources>

  <!-- The library pane's function rail. It has the same frosted strip as the left pane's rail,
       mirrored onto the right edge of the card. Only the border and the corners face the other way.
       The two rails work the same way (pick one of these) at either end of the window, so a
       different look for the same action would read as a different kind of control. -->
  <Border Width="82" Background="#22000000"
          BorderBrush="#18FFFFFF" BorderThickness="1,0,0,0" CornerRadius="0,7,7,0">
    <Border.Resources>
      <Style x:Key="RailButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <!-- The value matches RightRail.OneTab in RightRail.xaml.cs. It is written here too because a
             style setter cannot read a constant. A test keeps the two equal. -->
        <Setter Property="Height" Value="71"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Foreground" Value="#CCFFFFFF"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FFFFFF"/>
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#26FFFFFF"/>
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF"/>
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF"/>
    </Border.Resources>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- The tabs have their own translate. The spinning record hangs off the right edge of the window,
           and its lower arc covers this corner and takes the clicks there. So the stack ducks: it
           slides down out of the disc's reach while a record is showing, and slides back into the
           corner when the deck is idle (see MainPage.RightPane.DuckRailForRecord). The rail's strip
           itself does not move. It is the pane's edge, and an edge that slid down would make the
           card look broken. -->
      <StackPanel x:Name="TabStack" Grid.Row="0" Spacing="0" Margin="0" VerticalAlignment="Top">
        <StackPanel.RenderTransform>
          <TranslateTransform x:Name="TabDuck"/>
        </StackPanel.RenderTransform>
        <!-- The one rounded corner in the stack, at the rail's top right (radius 7). It is set in the code
             that ducks, not here. A first tab that has slid down is no longer in the corner, and a
             background cut to a corner it has left would show as a notch in the middle of the rail. -->
        <Button x:Name="RailAlbums" Style="{StaticResource RailButton}" Click="RailAlbums_Click">
          <StackPanel Spacing="5">
            <!-- compact-disc: the record itself. The album editors use the same icon. -->
            <FontIcon Glyph="&#xf51f;" FontFamily="{StaticResource Fa}" FontSize="16"/>
            <TextBlock Text="{loc:Str Key=RightNav_Albums}" FontSize="10" TextAlignment="Center"
                       TextWrapping="Wrap" LineHeight="12"/>
          </StackPanel>
        </Button>
        <Button x:Name="RailArtists" Style="{StaticResource RailButton}" Click="RailArtists_Click">
          <StackPanel Spacing="5">
            <!-- user: a person. The sort and grouping menus use the same icon for artists. -->
            <FontIcon Glyph="&#xf007;" FontFamily="{StaticResource Fa}" FontSize="16"/>
            <TextBlock Text="{loc:Str Key=RightNav_Artists}" FontSize="10" TextAlignment="Center"
                       TextWrapping="Wrap" LineHeight="12"/>
          </StackPanel>
        </Button>
        <Button x:Name="RailGenres" Style="{StaticResource RailButton}" Click="RailGenres_Click">
          <StackPanel Spacing="5">
            <!-- music: a note, as in the grouping menu. -->
            <FontIcon Glyph="&#xf001;" FontFamily="{StaticResource Fa}" FontSize="16"/>
            <TextBlock Text="{loc:Str Key=RightNav_Genres}" FontSize="10" TextAlignment="Center"
                       TextWrapping="Wrap" LineHeight="12"/>
          </StackPanel>
        </Button>
        <Button x:Name="RailPlaylists" Style="{StaticResource RailButton}" Click="RailPlaylists_Click">
          <StackPanel Spacing="5">
            <FontIcon Glyph="&#xf8c9;" FontFamily="{StaticResource Fa}" FontSize="16"/>
            <TextBlock Text="{loc:Str Key=Playlists_Title}" FontSize="10" TextAlignment="Center"
                       TextWrapping="Wrap" LineHeight="12"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- The fold button, mirrored. It points right, into the pane it folds away, and turns round once
           folded. It is collapsed unless folding is allowed. The library only steps aside for the
           import workbench, so anywhere else there is nothing to press. -->
      <Button x:Name="FoldButton" Grid.Row="1" Click="Close_Click" Background="Transparent"
              BorderThickness="0" Width="34" Height="30" MinWidth="0" Padding="0"
              Margin="0,6,0,8" HorizontalAlignment="Center" Visibility="Collapsed"
              ToolTipService.ToolTip="{loc:Str Key=Playlists_Close}"
              AutomationProperties.Name="{loc:Str Key=Playlists_Close}">
        <TextBlock x:Name="FoldChevron" Text="&#xf054;" FontFamily="{StaticResource Fa}" FontSize="12"
                   Foreground="#AAFFFFFF" RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform>
            <RotateTransform x:Name="FoldSpin"/>
          </TextBlock.RenderTransform>
        </TextBlock>
      </Button>
    </Grid>
  </Border>
</UserControl>
