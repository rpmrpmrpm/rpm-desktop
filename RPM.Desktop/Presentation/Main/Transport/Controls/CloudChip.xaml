<UserControl x:Class="RPM.Desktop.Presentation.Main.Transport.Controls.CloudChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:RPM.Desktop.Services.Cloud"
             xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
             xmlns:loc="using:RPM.Desktop.Strings"
             RequestedTheme="Dark"
             Visibility="Collapsed">

  <!-- The cloud upload work, minimised. It is the twin of the rip chip. Adding an album to the
       cloud can take minutes of transcoding and uploading. It starts from a right-click menu, with
       no window to watch, so the deck shows a cloud with a ring around it. The ring is the batch
       progress. The flyout names every track and its stage. The chip is shown only while there is
       work to show. -->
  <UserControl.Resources>
    <FontFamily x:Key="Fa">ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro Solid</FontFamily>
  </UserControl.Resources>

  <Button x:Name="ChipButton" VerticalAlignment="Stretch"
          Background="{StaticResource OnGlassBrush}"
          BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="6"
          Padding="12,0" MinHeight="0" MinWidth="0">
    <Button.Resources>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FFFFFF"/>
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#28FFFFFF"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#33FFFFFF"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#33FFFFFF"/>
    </Button.Resources>

    <!-- Ring around the cloud. It is a Polyline in a Canvas, not an arc Path, because code-built
         geometry draws nothing under Uno-Skia. The points here are plain coordinates. -->
    <Grid Width="24" Height="24">
      <Canvas Width="24" Height="24">
        <Polyline x:Name="RingTrack" Stroke="#2EFFFFFF" StrokeThickness="2"/>
        <Polyline x:Name="RingArc" Stroke="#04C8FF" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
      <TextBlock x:Name="CloudGlyph" Text="&#xf0c2;" FontFamily="{StaticResource Fa}" FontSize="9"
                 Foreground="#F0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

    <Button.Flyout>
      <Flyout x:Name="StatusFlyout" Placement="Top" Opened="Flyout_Opened" Closed="Flyout_Closed">
        <Flyout.FlyoutPresenterStyle>
          <Style TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
          </Style>
        </Flyout.FlyoutPresenterStyle>

        <StackPanel Width="340" RequestedTheme="Dark">
          <!-- The flyout is in a popup outside MainPage's tree. The accent styles are merged here, so its
               ProgressBars and links use the rpm accent colour. -->
          <StackPanel.Resources>
            <ResourceDictionary>
              <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
              </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
          </StackPanel.Resources>

          <!-- Header band: 32 px high, title-bar fill, and a thin line underneath. It matches the album
               wall's header. -->
          <Border Background="{StaticResource CardTitleBarBrush}" CornerRadius="8,8,0,0"
                  Height="32" Padding="14,0"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <TextBlock Text="&#xf0c2;" FontFamily="{StaticResource Fa}" FontSize="11"
                         Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Str Key=CloudChip_Title}" FontSize="12" FontWeight="SemiBold"
                         Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <StackPanel Padding="14,12,14,12" Spacing="10">
            <TextBlock x:Name="SummaryText" FontSize="12" Foreground="#CCFFFFFF" TextWrapping="Wrap"/>

            <!-- Link to the full error reasons. The rows below only say that a track did not finish. The
                 full reasons are on the settings page, which has room for them and a button to send
                 them in. -->
            <ctl:RpmLink x:Name="ErrorsHint" Click="Errors_Click" Padding="0"
                         Visibility="Collapsed">
              <TextBlock Text="{loc:Str Key=CloudChip_ErrorsHint}" MaxWidth="300"
                         FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap"/>
            </ctl:RpmLink>

            <!-- One row per track: what it is, what is being done to it, and its own progress bar. Each
                 track has its own bar on purpose. The ring on the chip already shows how much of the
                 batch is done. A total such as "8 of 40" does not help when track 9 is a 300 MB
                 transcode. -->
            <ListView x:Name="JobList" SelectionMode="None" Background="Transparent"
                      MaxHeight="240"
                      ItemContainerStyle="{StaticResource RipTrackContainerStyle}">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:CloudJobRow">
                  <Grid ColumnSpacing="9" Opacity="{x:Bind RowOpacity, Mode=OneWay}" Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Up, down or removed: the operation is shown as an arrow, not a word, so the line beside it
                         can say what is really happening. -->
                    <FontIcon Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                              Style="{StaticResource FaIcon}" FontSize="10"
                              Glyph="{x:Bind OpGlyph}" Foreground="#99FFFFFF"
                              VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind Title}" FontSize="11.5"
                               Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind StageText, Mode=OneWay}"
                               FontSize="10.5" Foreground="{x:Bind StageBrush, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Height="3"
                                 Margin="0,4,0,0"
                                 Value="{x:Bind Fraction, Mode=OneWay}"
                                 Foreground="{x:Bind StageBrush, Mode=OneWay}"
                                 Background="#22FFFFFF"/>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button x:Name="PauseButton" Click="Pause_Click"
                      Style="{StaticResource GlassButtonStyle}" Padding="12,0"
                      ToolTipService.ToolTip="{loc:Str Key=CloudChip_PauseTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf04c;" FontSize="10"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="{loc:Str Key=CloudChip_Pause}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="ResumeButton" Click="Resume_Click"
                      Style="{StaticResource GlassButtonStyle}" Padding="12,0"
                      Visibility="Collapsed"
                      ToolTipService.ToolTip="{loc:Str Key=CloudChip_ResumeTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf04b;" FontSize="10"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="{loc:Str Key=CloudChip_Resume}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="DismissButton" Click="Dismiss_Click"
                      Style="{StaticResource GlassButtonStyle}" Padding="12,0"
                      Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00c;" FontSize="10"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="{loc:Str Key=CloudChip_Dismiss}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
