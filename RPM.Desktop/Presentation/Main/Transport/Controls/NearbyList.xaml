<UserControl x:Class="RPM.Desktop.Presentation.Main.Transport.Controls.NearbyList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:RPM.Desktop.Strings"
             RequestedTheme="Dark">

  <!-- "On this network": every computer that can be asked, and every pairing in progress or just
       ended. One control in two places, the deck's share chip and the sharing card in library
       settings, both reading the same board, so an answer given in one is shown in the other at the
       same moment. -->
  <StackPanel Spacing="8">
    <TextBlock Text="{loc:Str Key=Share_OnNetwork}" FontSize="11" FontWeight="SemiBold"
               Foreground="#88FFFFFF"/>
    <StackPanel x:Name="RowsPanel" Spacing="6"/>
  </StackPanel>
</UserControl>
