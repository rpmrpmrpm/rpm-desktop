<UserControl x:Class="RPM.Desktop.Presentation.Main.Transport.Controls.ViewPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:RPM.Desktop.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             RequestedTheme="Dark">

  <!-- The view chooser: the three ways RPM shows itself, drawn as three pictures of themselves.

       A menu is the wrong shape for this. A menu is a list of actions that is read once and then
       closed. This is a choice between three places to be, and the one you are in is part of the answer.

       A glyph is the wrong picture too. Three icons in a column only make sense to someone who already
       knows them. The shape of each view says what it is at once: a picture that fills the screen, a
       narrow tall panel stack, and a window with a library in it. So each card shows a scale model of the
       view, not a symbol. The model is drawn the way PositionArtworkDialog draws the header: the app's
       own rectangles at one common size (260 x 164), which the card scales down. The three shapes are the
       whole message. Library and RPaMp are windows and sit side by side. Pegasus takes the whole screen,
       so it takes the width. -->

  <UserControl.Resources>
    <FontFamily x:Key="Fa">ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro Solid</FontFamily>

    <!-- The card. Transparent at rest, so the flyout's own dark shows through. A faint white under the
         pointer, and a little more when pressed. No border: three bordered boxes would look like a table,
         and this should look like three things on a shelf. -->
    <Style x:Key="ViewCard" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,8,8,7"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="UseSystemFocusVisuals" Value="False"/>
    </Style>

    <!-- The frame around a model. Its edge is the one thing SetCurrent repaints, so everything else about
         a card is the same whether you are in it or not. -->
    <Style x:Key="ViewGlass" TargetType="Border">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="BorderBrush" Value="#26FFFFFF"/>
    </Style>

    <Style x:Key="ViewLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,7,0,0"/>
    </Style>

    <!-- The mark under the name of the view you are in: the app's azure, running up to its cyan. It is the
         same pair used for lit things in rpm. It is the only colour in the flyout, so "you are here"
         is seen before a word is read. -->
    <LinearGradientBrush x:Key="ViewLit" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Offset="0" Color="#0371D0"/>
      <GradientStop Offset="1" Color="#04C8FF"/>
    </LinearGradientBrush>

    <!-- The ground a model stands on: the desk behind the window, which the full-screen view has none of. -->
    <LinearGradientBrush x:Key="ModelGround" StartPoint="0,0" EndPoint="0.6,1">
      <GradientStop Offset="0" Color="#12181F"/>
      <GradientStop Offset="1" Color="#080B10"/>
    </LinearGradientBrush>

    <!-- A panel's title bar, in miniature: the lit lip of a glass pane, darkening to its foot. RPaMp's
         three panels each use one. -->
    <LinearGradientBrush x:Key="ModelTitleBar" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Offset="0" Color="#26FFFFFF"/>
      <GradientStop Offset="1" Color="#59000000"/>
    </LinearGradientBrush>
  </UserControl.Resources>

  <StackPanel Width="340">

    <!-- The band the cast picker uses. The two flyouts off this deck share one design. -->
    <Border Background="{StaticResource CardTitleBarBrush}" CornerRadius="8,8,0,0"
            Height="32" Padding="16,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <TextBlock Text="{loc:Str Key=View_Heading}" VerticalAlignment="Center"
                 FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF"/>
    </Border>

    <StackPanel Padding="8,8,8,10" Spacing="4">

      <!-- ═══ The two windows, side by side ═══ -->
      <Grid ColumnSpacing="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Library ═══ a window with the header across its top: the picture on the left, the record
             half off the right edge of it, the panes and the deck below. -->
        <Button x:Name="LibraryCard" Grid.Column="0" Style="{StaticResource ViewCard}" Click="Library_Click">
          <StackPanel>
            <Border x:Name="LibraryFrame" Style="{StaticResource ViewGlass}" Height="90">
              <Viewbox x:Name="LibraryArt" Stretch="Fill">
                <Canvas Width="260" Height="164">

                  <!-- the desk -->
                  <Rectangle Width="260" Height="164" RadiusX="6" RadiusY="6"
                             Fill="{StaticResource ModelGround}"/>

                  <!-- the window -->
                  <Rectangle Canvas.Left="6" Canvas.Top="6" Width="248" Height="152"
                             RadiusX="5" RadiusY="5" Fill="#131A23"
                             Stroke="#40FFFFFF" StrokeThickness="1.5"/>

                  <!-- everything inside it is cut at the window's edge, which is what makes half a record
                       half a record. -->
                  <Canvas>
                    <Canvas.Clip>
                      <RectangleGeometry Rect="6,6,248,152"/>
                    </Canvas.Clip>

                    <!-- ── the header band ── -->
                    <Rectangle Canvas.Left="6" Canvas.Top="6" Width="248" Height="46" Fill="#0F151D"/>

                    <!-- the picture, fading into the band's own ground rather than ending on a sharp edge -->
                    <Rectangle Canvas.Left="6" Canvas.Top="6" Width="150" Height="46">
                      <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Offset="0" Color="#FF3E5C78"/>
                          <GradientStop Offset="0.55" Color="#FF2A3E52"/>
                          <GradientStop Offset="1" Color="#000F151D"/>
                        </LinearGradientBrush>
                      </Rectangle.Fill>
                    </Rectangle>

                    <!-- the scrim the words stand on -->
                    <Rectangle Canvas.Left="6" Canvas.Top="6" Width="150" Height="46">
                      <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Offset="0" Color="#A6000000"/>
                          <GradientStop Offset="0.85" Color="#00000000"/>
                        </LinearGradientBrush>
                      </Rectangle.Fill>
                    </Rectangle>

                    <!-- the cover square, and the three lines beside it -->
                    <Rectangle Canvas.Left="14" Canvas.Top="15" Width="28" Height="28"
                               RadiusX="3" RadiusY="3" Fill="#3D000000"
                               Stroke="#59FFFFFF" StrokeThickness="1"/>
                    <Rectangle Canvas.Left="50" Canvas.Top="17" Width="66" Height="6"
                               RadiusX="3" RadiusY="3" Fill="#D9FFFFFF"/>
                    <Rectangle Canvas.Left="50" Canvas.Top="28" Width="46" Height="4.5"
                               RadiusX="2" RadiusY="2" Fill="#8CFFFFFF"/>
                    <Rectangle Canvas.Left="50" Canvas.Top="37" Width="32" Height="4"
                               RadiusX="2" RadiusY="2" Fill="#59FFFFFF"/>

                    <!-- the record, centred on the window's right edge -->
                    <Ellipse Canvas.Left="227" Canvas.Top="13" Width="54" Height="54"
                             Fill="#0D0D10" Stroke="#26FFFFFF" StrokeThickness="1"/>
                    <Ellipse Canvas.Left="234" Canvas.Top="20" Width="40" Height="40"
                             Stroke="#1AFFFFFF" StrokeThickness="1"/>
                    <Ellipse Canvas.Left="246" Canvas.Top="32" Width="16" Height="16" Fill="#4D6A7480"/>
                    <Ellipse Canvas.Left="252.5" Canvas.Top="38.5" Width="3" Height="3" Fill="#131A23"/>

                    <!-- where the band ends -->
                    <Rectangle Canvas.Left="6" Canvas.Top="52" Width="248" Height="1" Fill="#1FFFFFFF"/>

                    <!-- ── the left pane: the rail, and what it is showing ── -->
                    <Rectangle Canvas.Left="12" Canvas.Top="58" Width="80" Height="66"
                               RadiusX="4" RadiusY="4" Fill="#14FFFFFF"/>
                    <Rectangle Canvas.Left="12" Canvas.Top="58" Width="12" Height="66"
                               RadiusX="4" RadiusY="4" Fill="#1FFFFFFF"/>
                    <Ellipse Canvas.Left="15.5" Canvas.Top="65" Width="5" Height="5" Fill="#8CFFFFFF"/>
                    <Ellipse Canvas.Left="15.5" Canvas.Top="76" Width="5" Height="5" Fill="#59FFFFFF"/>
                    <Ellipse Canvas.Left="15.5" Canvas.Top="87" Width="5" Height="5" Fill="#59FFFFFF"/>
                    <Rectangle Canvas.Left="30" Canvas.Top="64" Width="52" Height="4"
                               RadiusX="2" RadiusY="2" Fill="#A6FFFFFF"/>
                    <Rectangle Canvas.Left="30" Canvas.Top="74" Width="44" Height="3.5"
                               RadiusX="1.75" RadiusY="1.75" Fill="#59FFFFFF"/>
                    <Rectangle Canvas.Left="30" Canvas.Top="83" Width="48" Height="3.5"
                               RadiusX="1.75" RadiusY="1.75" Fill="#59FFFFFF"/>
                    <Rectangle Canvas.Left="30" Canvas.Top="92" Width="38" Height="3.5"
                               RadiusX="1.75" RadiusY="1.75" Fill="#59FFFFFF"/>
                    <Rectangle Canvas.Left="30" Canvas.Top="101" Width="46" Height="3.5"
                               RadiusX="1.75" RadiusY="1.75" Fill="#59FFFFFF"/>
                    <Rectangle Canvas.Left="30" Canvas.Top="110" Width="34" Height="3.5"
                               RadiusX="1.75" RadiusY="1.75" Fill="#59FFFFFF"/>

                    <!-- ── the wall of records ── -->
                    <Rectangle Canvas.Left="102" Canvas.Top="58" Width="28" Height="28"
                               RadiusX="3" RadiusY="3" Fill="#26FFFFFF"/>
                    <Rectangle Canvas.Left="139" Canvas.Top="58" Width="28" Height="28"
                               RadiusX="3" RadiusY="3" Fill="#26FFFFFF"/>
                    <Rectangle Canvas.Left="176" Canvas.Top="58" Width="28" Height="28"
                               RadiusX="3" RadiusY="3" Fill="#26FFFFFF"/>
                    <Rectangle Canvas.Left="213" Canvas.Top="58" Width="28" Height="28"
                               RadiusX="3" RadiusY="3" Fill="#26FFFFFF"/>
                    <Rectangle Canvas.Left="105" Canvas.Top="88" Width="22" Height="3"
                               RadiusX="1.5" RadiusY="1.5" Fill="#40FFFFFF"/>
                    <Rectangle Canvas.Left="142" Canvas.Top="88" Width="22" Height="3"
                               RadiusX="1.5" RadiusY="1.5" Fill="#40FFFFFF"/>
                    <Rectangle Canvas.Left="179" Canvas.Top="88" Width="22" Height="3"
                               RadiusX="1.5" RadiusY="1.5" Fill="#40FFFFFF"/>
                    <Rectangle Canvas.Left="216" Canvas.Top="88" Width="22" Height="3"
                               RadiusX="1.5" RadiusY="1.5" Fill="#40FFFFFF"/>

                    <Rectangle Canvas.Left="102" Canvas.Top="96" Width="28" Height="28"
                               RadiusX="3" RadiusY="3" Fill="#26FFFFFF"/>
                    <Rectangle Canvas.Left="139" Canvas.Top="96" Width="28" Height="28"
                               RadiusX="3" RadiusY="3" Fill="#26FFFFFF"/>
                    <Rectangle Canvas.Left="176" Canvas.Top="96" Width="28" Height="28"
                               RadiusX="3" RadiusY="3" Fill="#26FFFFFF"/>
                    <Rectangle Canvas.Left="213" Canvas.Top="96" Width="28" Height="28"
                               RadiusX="3" RadiusY="3" Fill="#26FFFFFF"/>

                    <!-- ── the deck along the foot ── -->
                    <Rectangle Canvas.Left="6" Canvas.Top="130" Width="248" Height="28" Fill="#1FFFFFFF"/>
                    <Rectangle Canvas.Left="6" Canvas.Top="130" Width="248" Height="1" Fill="#33FFFFFF"/>
                    <Rectangle Canvas.Left="14" Canvas.Top="136" Width="16" Height="16"
                               RadiusX="3" RadiusY="3" Fill="#3D000000"
                               Stroke="#59FFFFFF" StrokeThickness="1"/>
                    <Rectangle Canvas.Left="36" Canvas.Top="138" Width="40" Height="4"
                               RadiusX="2" RadiusY="2" Fill="#A6FFFFFF"/>
                    <Rectangle Canvas.Left="36" Canvas.Top="146" Width="28" Height="3"
                               RadiusX="1.5" RadiusY="1.5" Fill="#59FFFFFF"/>
                    <Ellipse Canvas.Left="112" Canvas.Top="140" Width="8" Height="8" Fill="#B3FFFFFF"/>
                    <Ellipse Canvas.Left="126" Canvas.Top="140" Width="8" Height="8" Fill="#FFFFFFFF"/>
                    <Ellipse Canvas.Left="140" Canvas.Top="140" Width="8" Height="8" Fill="#B3FFFFFF"/>
                    <Rectangle Canvas.Left="182" Canvas.Top="137" Width="14" Height="14"
                               RadiusX="3" RadiusY="3" Fill="#24FFFFFF" Stroke="#33FFFFFF" StrokeThickness="1"/>
                    <Rectangle Canvas.Left="200" Canvas.Top="137" Width="14" Height="14"
                               RadiusX="3" RadiusY="3" Fill="#24FFFFFF" Stroke="#33FFFFFF" StrokeThickness="1"/>
                    <Rectangle Canvas.Left="218" Canvas.Top="137" Width="14" Height="14"
                               RadiusX="3" RadiusY="3" Fill="#24FFFFFF" Stroke="#33FFFFFF" StrokeThickness="1"/>
                    <Rectangle Canvas.Left="236" Canvas.Top="137" Width="14" Height="14"
                               RadiusX="3" RadiusY="3" Fill="#24FFFFFF" Stroke="#33FFFFFF" StrokeThickness="1"/>
                  </Canvas>
                </Canvas>
              </Viewbox>
            </Border>

            <TextBlock x:Name="LibraryName" Text="{loc:Str Key=View_Library}"
                       Style="{StaticResource ViewLabel}" Foreground="#B3FFFFFF"/>
            <Rectangle x:Name="LibraryMark" Width="22" Height="2.5" RadiusX="1.25" RadiusY="1.25"
                       Margin="0,5,0,0" HorizontalAlignment="Center" Opacity="0"
                       Fill="{StaticResource ViewLit}"/>
          </StackPanel>
        </Button>

        <!-- ═══ RPaMp ═══ the narrow tall stack of panels, standing on the desk: the player, the
             equaliser, the playlist. -->
        <Button x:Name="AmpCard" Grid.Column="1" Style="{StaticResource ViewCard}" Click="Amp_Click">
          <StackPanel>
            <Border x:Name="AmpFrame" Style="{StaticResource ViewGlass}" Height="90">
              <Viewbox x:Name="AmpArt" Stretch="Fill">
                <Canvas Width="260" Height="164">

                  <Rectangle Width="260" Height="164" RadiusX="6" RadiusY="6"
                             Fill="{StaticResource ModelGround}"/>

                  <!-- the window: eighty-eight wide against a hundred and forty-eight tall, which is the
                       whole of what makes this card unmistakable at thumbnail size. -->
                  <Rectangle Canvas.Left="86" Canvas.Top="8" Width="88" Height="148"
                             RadiusX="4" RadiusY="4" Fill="#131A23"
                             Stroke="#40FFFFFF" StrokeThickness="1.5"/>

                  <!-- ── the player ── -->
                  <Rectangle Canvas.Left="90" Canvas.Top="12" Width="80" Height="62"
                             RadiusX="3" RadiusY="3" Fill="#0F151D"/>
                  <Rectangle Canvas.Left="90" Canvas.Top="12" Width="80" Height="9"
                             RadiusX="3" RadiusY="3" Fill="{StaticResource ModelTitleBar}"/>

                  <!-- the ticker, on its own dark plate -->
                  <Rectangle Canvas.Left="95" Canvas.Top="25" Width="70" Height="9"
                             RadiusX="1.5" RadiusY="1.5" Fill="#080C10"/>
                  <Rectangle Canvas.Left="98" Canvas.Top="28" Width="44" Height="3.5"
                             RadiusX="1.75" RadiusY="1.75" Fill="#A6D8FF"/>

                  <!-- the analyser -->
                  <Rectangle Canvas.Left="96" Canvas.Top="40" Width="3" Height="10" Fill="#66FFFFFF"/>
                  <Rectangle Canvas.Left="102" Canvas.Top="36" Width="3" Height="14" Fill="#66FFFFFF"/>
                  <Rectangle Canvas.Left="108" Canvas.Top="42" Width="3" Height="8" Fill="#66FFFFFF"/>
                  <Rectangle Canvas.Left="114" Canvas.Top="34" Width="3" Height="16" Fill="#8C04C8FF"/>
                  <Rectangle Canvas.Left="120" Canvas.Top="38" Width="3" Height="12" Fill="#66FFFFFF"/>
                  <Rectangle Canvas.Left="126" Canvas.Top="32" Width="3" Height="18" Fill="#8C04C8FF"/>
                  <Rectangle Canvas.Left="132" Canvas.Top="41" Width="3" Height="9" Fill="#66FFFFFF"/>
                  <Rectangle Canvas.Left="138" Canvas.Top="37" Width="3" Height="13" Fill="#66FFFFFF"/>
                  <Rectangle Canvas.Left="144" Canvas.Top="43" Width="3" Height="7" Fill="#66FFFFFF"/>
                  <Rectangle Canvas.Left="150" Canvas.Top="35" Width="3" Height="15" Fill="#66FFFFFF"/>
                  <Rectangle Canvas.Left="156" Canvas.Top="39" Width="3" Height="11" Fill="#66FFFFFF"/>
                  <Rectangle Canvas.Left="162" Canvas.Top="44" Width="3" Height="6" Fill="#66FFFFFF"/>

                  <!-- the keys -->
                  <Rectangle Canvas.Left="96" Canvas.Top="54" Width="9" Height="8"
                             RadiusX="1.5" RadiusY="1.5" Fill="#24FFFFFF" Stroke="#33FFFFFF" StrokeThickness="1"/>
                  <Rectangle Canvas.Left="108" Canvas.Top="54" Width="9" Height="8"
                             RadiusX="1.5" RadiusY="1.5" Fill="#24FFFFFF" Stroke="#33FFFFFF" StrokeThickness="1"/>
                  <Rectangle Canvas.Left="120" Canvas.Top="54" Width="9" Height="8"
                             RadiusX="1.5" RadiusY="1.5" Fill="#24FFFFFF" Stroke="#33FFFFFF" StrokeThickness="1"/>
                  <Rectangle Canvas.Left="132" Canvas.Top="54" Width="9" Height="8"
                             RadiusX="1.5" RadiusY="1.5" Fill="#24FFFFFF" Stroke="#33FFFFFF" StrokeThickness="1"/>
                  <Rectangle Canvas.Left="144" Canvas.Top="54" Width="9" Height="8"
                             RadiusX="1.5" RadiusY="1.5" Fill="#24FFFFFF" Stroke="#33FFFFFF" StrokeThickness="1"/>

                  <!-- the position bar, and the square handle standing on it -->
                  <Rectangle Canvas.Left="95" Canvas.Top="66" Width="70" Height="3"
                             RadiusX="1.5" RadiusY="1.5" Fill="#33000000"/>
                  <Rectangle Canvas.Left="95" Canvas.Top="66" Width="38" Height="3"
                             RadiusX="1.5" RadiusY="1.5" Fill="#B0FFFFFF"/>
                  <Rectangle Canvas.Left="131" Canvas.Top="63.5" Width="5" Height="8"
                             RadiusX="1" RadiusY="1" Fill="#EAF0F3"/>

                  <!-- ── the equaliser ── -->
                  <Rectangle Canvas.Left="90" Canvas.Top="78" Width="80" Height="34"
                             RadiusX="3" RadiusY="3" Fill="#0F151D"/>
                  <Rectangle Canvas.Left="90" Canvas.Top="78" Width="80" Height="7"
                             RadiusX="3" RadiusY="3" Fill="{StaticResource ModelTitleBar}"/>

                  <Rectangle Canvas.Left="97" Canvas.Top="88" Width="2" Height="20" Fill="#33000000"/>
                  <Rectangle Canvas.Left="105" Canvas.Top="88" Width="2" Height="20" Fill="#33000000"/>
                  <Rectangle Canvas.Left="113" Canvas.Top="88" Width="2" Height="20" Fill="#33000000"/>
                  <Rectangle Canvas.Left="121" Canvas.Top="88" Width="2" Height="20" Fill="#33000000"/>
                  <Rectangle Canvas.Left="129" Canvas.Top="88" Width="2" Height="20" Fill="#33000000"/>
                  <Rectangle Canvas.Left="137" Canvas.Top="88" Width="2" Height="20" Fill="#33000000"/>
                  <Rectangle Canvas.Left="145" Canvas.Top="88" Width="2" Height="20" Fill="#33000000"/>
                  <Rectangle Canvas.Left="153" Canvas.Top="88" Width="2" Height="20" Fill="#33000000"/>
                  <Rectangle Canvas.Left="161" Canvas.Top="88" Width="2" Height="20" Fill="#33000000"/>

                  <Rectangle Canvas.Left="95" Canvas.Top="96" Width="6" Height="3"
                             RadiusX="1" RadiusY="1" Fill="#DDE6EE"/>
                  <Rectangle Canvas.Left="103" Canvas.Top="92" Width="6" Height="3"
                             RadiusX="1" RadiusY="1" Fill="#DDE6EE"/>
                  <Rectangle Canvas.Left="111" Canvas.Top="99" Width="6" Height="3"
                             RadiusX="1" RadiusY="1" Fill="#DDE6EE"/>
                  <Rectangle Canvas.Left="119" Canvas.Top="94" Width="6" Height="3"
                             RadiusX="1" RadiusY="1" Fill="#DDE6EE"/>
                  <Rectangle Canvas.Left="127" Canvas.Top="102" Width="6" Height="3"
                             RadiusX="1" RadiusY="1" Fill="#DDE6EE"/>
                  <Rectangle Canvas.Left="135" Canvas.Top="97" Width="6" Height="3"
                             RadiusX="1" RadiusY="1" Fill="#DDE6EE"/>
                  <Rectangle Canvas.Left="143" Canvas.Top="91" Width="6" Height="3"
                             RadiusX="1" RadiusY="1" Fill="#DDE6EE"/>
                  <Rectangle Canvas.Left="151" Canvas.Top="98" Width="6" Height="3"
                             RadiusX="1" RadiusY="1" Fill="#DDE6EE"/>
                  <Rectangle Canvas.Left="159" Canvas.Top="95" Width="6" Height="3"
                             RadiusX="1" RadiusY="1" Fill="#DDE6EE"/>

                  <!-- ── the playlist ── -->
                  <Rectangle Canvas.Left="90" Canvas.Top="116" Width="80" Height="36"
                             RadiusX="3" RadiusY="3" Fill="#0F151D"/>
                  <Rectangle Canvas.Left="90" Canvas.Top="116" Width="80" Height="7"
                             RadiusX="3" RadiusY="3" Fill="{StaticResource ModelTitleBar}"/>
                  <Rectangle Canvas.Left="95" Canvas.Top="127" Width="56" Height="3"
                             RadiusX="1.5" RadiusY="1.5" Fill="#73FFFFFF"/>
                  <Rectangle Canvas.Left="95" Canvas.Top="133" Width="44" Height="3"
                             RadiusX="1.5" RadiusY="1.5" Fill="#04C8FF"/>
                  <Rectangle Canvas.Left="95" Canvas.Top="139" Width="60" Height="3"
                             RadiusX="1.5" RadiusY="1.5" Fill="#73FFFFFF"/>
                  <Rectangle Canvas.Left="95" Canvas.Top="145" Width="38" Height="3"
                             RadiusX="1.5" RadiusY="1.5" Fill="#73FFFFFF"/>
                </Canvas>
              </Viewbox>
            </Border>

            <TextBlock x:Name="AmpName" Text="{loc:Str Key=View_RPaMp}"
                       Style="{StaticResource ViewLabel}" Foreground="#B3FFFFFF"/>
            <Rectangle x:Name="AmpMark" Width="22" Height="2.5" RadiusX="1.25" RadiusY="1.25"
                       Margin="0,5,0,0" HorizontalAlignment="Center" Opacity="0"
                       Fill="{StaticResource ViewLit}"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- ═══ Pegasus ═══ no window at all: the record out of its sleeve in the middle of the screen, the
           words down the left, the analyser along the foot. It gets the width because that is what it
           takes. -->
      <Button x:Name="PegasusCard" Style="{StaticResource ViewCard}" Click="Pegasus_Click">
        <StackPanel>
          <Border x:Name="PegasusFrame" Style="{StaticResource ViewGlass}"
                  Width="208" Height="131" HorizontalAlignment="Center">
            <Viewbox x:Name="PegasusArt" Stretch="Fill">
              <Canvas Width="260" Height="164">

                <!-- the room, edge to edge -->
                <Rectangle Width="260" Height="164" RadiusX="6" RadiusY="6">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Offset="0" Color="#1B2836"/>
                      <GradientStop Offset="0.55" Color="#111925"/>
                      <GradientStop Offset="1" Color="#080B10"/>
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>

                <!-- the light the record stands in: three passes of the app's cyan, each smaller and a
                     little stronger, which is a glow without a blur to pay for. -->
                <Ellipse Canvas.Left="76" Canvas.Top="0" Width="148" Height="148" Fill="#0F04C8FF"/>
                <Ellipse Canvas.Left="96" Canvas.Top="20" Width="108" Height="108" Fill="#1204C8FF"/>
                <Ellipse Canvas.Left="116" Canvas.Top="40" Width="68" Height="68" Fill="#1604C8FF"/>

                <!-- the record, behind and pushed right, so a quarter of it shows past the sleeve -->
                <Ellipse Canvas.Left="124" Canvas.Top="40" Width="68" Height="68"
                         Fill="#0D0D10" Stroke="#33FFFFFF" StrokeThickness="1"/>
                <Ellipse Canvas.Left="133" Canvas.Top="49" Width="50" Height="50"
                         Stroke="#1AFFFFFF" StrokeThickness="1"/>
                <Ellipse Canvas.Left="148" Canvas.Top="64" Width="20" Height="20" Fill="#59708090"/>
                <Ellipse Canvas.Left="156.5" Canvas.Top="72.5" Width="3" Height="3" Fill="#0D0D10"/>

                <!-- the sleeve over it -->
                <Rectangle Canvas.Left="93" Canvas.Top="43" Width="62" Height="62"
                           RadiusX="3" RadiusY="3" Stroke="#66FFFFFF" StrokeThickness="1.5">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
