<UserControl x:Class="RPM.Desktop.Presentation.Main.Transport.Controls.NearbyRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
             xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             RequestedTheme="Dark">

  <!-- One computer under "On this network": its name, where a pairing with it stands, and the one or
       two things that can be done about it. Everything here is set by NearbyRow.Apply from a fresh
       read of the board; the row keeps no state about the pairing except the digits being typed. -->
  <UserControl.Resources>
    <FontFamily x:Key="Fa">ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro Solid</FontFamily>
  </UserControl.Resources>

  <Border CornerRadius="8" Background="#0AFFFFFF" Padding="10,9">
    <StackPanel Spacing="10">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The first letter of the name, in the tile the shelves list uses. -->
        <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Top">
          <Border CornerRadius="7" Background="#14FFFFFF"/>
          <TextBlock x:Name="InitialText" FontSize="16" FontWeight="SemiBold" Foreground="#F2FFFFFF"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="NameText" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="StatusText" FontSize="11" Foreground="#AAFFFFFF" TextWrapping="Wrap"/>
          <TextBlock x:Name="TimeText" FontSize="11" Foreground="#88FFFFFF" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <!-- The six digits, on the computer that was asked. Big enough to read across a room. -->
      <TextBlock x:Name="CodeText" FontSize="26" FontWeight="SemiBold" Foreground="#F2FFFFFF"
                 CharacterSpacing="120" HorizontalAlignment="Center" Visibility="Collapsed"/>

      <!-- The box, on the computer that asked. win:CharacterSpacing because Uno's TextBox has none. -->
      <StackPanel x:Name="EntryPanel" Spacing="6" Visibility="Collapsed">
        <TextBox x:Name="CodeBox" MaxLength="6" InputScope="Number"
                 FontSize="26" FontWeight="SemiBold" win:CharacterSpacing="120"
                 HorizontalContentAlignment="Center" TextAlignment="Center"
                 KeyDown="CodeBox_KeyDown" TextChanged="CodeBox_TextChanged"/>
        <TextBlock x:Name="EntryError" FontSize="11" Foreground="#FFB4A8" TextWrapping="Wrap"
                   Visibility="Collapsed"/>
      </StackPanel>

      <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="SecondaryButton" Click="Secondary_Click"
                Style="{StaticResource GlassButtonStyle}" Padding="12,0">
          <TextBlock x:Name="SecondaryText" VerticalAlignment="Center"/>
        </Button>
        <ctl:RpmPrimaryButton x:Name="PrimaryButton" Click="Primary_Click" Padding="12,0">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf5db;" FontSize="10"
                      VerticalAlignment="Center"/>
            <TextBlock x:Name="PrimaryText" VerticalAlignment="Center"/>
          </StackPanel>
        </ctl:RpmPrimaryButton>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
