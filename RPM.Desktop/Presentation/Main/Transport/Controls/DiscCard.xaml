<UserControl x:Class="RPM.Desktop.Presentation.Main.Transport.Controls.DiscCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
             xmlns:loc="using:RPM.Desktop.Strings"
             RequestedTheme="Dark"
             Visibility="Collapsed">

  <!-- The card that comes up when an audio CD goes into the drive: what the disc is, once it has been read and
       looked up, and the two things to do with it. It rises from the bottom of the window and sinks back into
       it. See DiscCard.xaml.cs. -->
  <Border x:Name="Card" Width="440" CornerRadius="12" Padding="16,12,16,16"
          Background="#F2121A26" BorderBrush="#2BFFFFFF" BorderThickness="1">
    <Border.RenderTransform>
      <TranslateTransform x:Name="Rise"/>
    </Border.RenderTransform>

    <Grid RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- The heading and the way out. -->
      <Grid>
        <TextBlock Text="{loc:Str Key=Rip_CardTitle}" FontSize="14" FontWeight="SemiBold" Foreground="White"
                   VerticalAlignment="Center"/>
        <Button x:Name="CloseButton" Click="Close_Click" HorizontalAlignment="Right"
                Width="28" Height="28" Padding="0" CornerRadius="6"
                Background="Transparent" BorderThickness="0"
                ToolTipService.ToolTip="{loc:Str Key=Window_Close}"
                AutomationProperties.Name="{loc:Str Key=Window_Close}">
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="12" Foreground="#CCFFFFFF"/>
        </Button>
      </Grid>

      <Grid Grid.Row="1" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="132"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The sleeve: the record turning while the disc is read and looked up, then the cover, or the
             library's empty-cover glyph for a disc nobody knows. -->
        <Border Width="132" Height="132" CornerRadius="8" Background="#26000000">
          <Grid>
            <ctl:RecordSpinner x:Name="Spinner" Width="56" Height="56"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <FontIcon x:Name="NoCover" Style="{StaticResource FaIcon}" Glyph="&#xf51f;" FontSize="40"
                      Foreground="#44FFFFFF" Visibility="Collapsed"/>
            <Image x:Name="Cover" Stretch="UniformToFill" Opacity="0"/>
          </Grid>
        </Border>

        <Grid Grid.Column="1" RowSpacing="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="AlbumText" Grid.Row="1" FontSize="17" FontWeight="SemiBold" Foreground="White"
                     TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="ArtistText" Grid.Row="2" FontSize="13" Foreground="#CCFFFFFF"
                     TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>

          <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="PlayButton" Click="Play_Click" IsEnabled="False"
                    Style="{StaticResource GlassButtonStyle}" Padding="14,0">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf04b;" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Str Key=Rip_CardPlay}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <ctl:RpmPrimaryButton x:Name="RipButton" Click="Rip_Click" Padding="14,0">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf51f;" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Str Key=Rip_CardRip}" VerticalAlignment="Center"/>
              </StackPanel>
            </ctl:RpmPrimaryButton>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
