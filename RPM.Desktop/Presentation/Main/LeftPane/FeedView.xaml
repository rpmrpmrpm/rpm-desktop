<UserControl x:Class="RPM.Desktop.Presentation.Main.LeftPane.FeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:RPM.Desktop.Strings">

  <UserControl.Resources>
    <FontFamily x:Key="Fa">ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro</FontFamily>

    <!-- The keys on the cards draw no plate (FeedCards.Key), so hover and press leave it clear. -->
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/>
  </UserControl.Resources>

  <!-- The Feed: everyone's posts and album reviews, newest first, as on the phone's Feed tab, and the
       pages it opens (a person's page, a review read in full). The cards run from the heading's left
       edge to the same 16 px margin at the right, so the column grows with the pane. The space inside a
       card is the phone's. The cards are built in code (FeedCards), because a review card runs its text
       round the cover, which a template cannot do.

       There is no subtitle strip under the heading here: the list starts 7 px under the heading box. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- The heading row. The key at the right is the reader's own page on the feed, and the way back on
         every page the feed opens. Both end on the cards' right edge. -->
    <Grid Grid.Row="0" Margin="16,12,16,0" Style="{StaticResource RpmPaneHeadingBox}">
      <TextBlock Text="{loc:Str Key=Rpm_Tab_Feed}" Style="{StaticResource RpmPaneHeading}"/>

      <!-- The round plate is drawn inside the key, not as its Background: the brushes above clear a
           key's background on hover, and the plate would vanish under the pointer. -->
      <Button x:Name="ProfileKey" Click="ProfileKey_Click" HorizontalAlignment="Right"
              Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0"
              Background="Transparent" BorderThickness="0" Visibility="Collapsed"
              ToolTipService.ToolTip="{loc:Str Key=Rpm_Feed_MyProfile}"
              AutomationProperties.Name="{loc:Str Key=Rpm_Feed_MyProfile}">
        <Grid Width="32" Height="32">
          <Ellipse Fill="#1FFFFFFF"/>
          <FontIcon Glyph="&#xf007;" FontFamily="{StaticResource Fa}" FontSize="14" Foreground="#EEFFFFFF"/>
          <!-- Notifications wait: a red dot on the key's corner, as on the phones. -->
          <Ellipse x:Name="ProfileDot" Width="10" Height="10" Fill="#FF3B30" HorizontalAlignment="Right"
                   VerticalAlignment="Top" Margin="0,-1,-1,0" Visibility="Collapsed"/>
        </Grid>
      </Button>

      <!-- The menu of a person's page, left of the close key: notifications and the edit page on the
           reader's own page; friendship and blocking on someone else's. -->
      <Button x:Name="MenuKey" Click="MenuKey_Click" HorizontalAlignment="Right" Margin="0,0,40,0"
              Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0"
              Background="Transparent" BorderThickness="0" Visibility="Collapsed"
              ToolTipService.ToolTip="{loc:Str Key=Rpm_Profile_Menu}"
              AutomationProperties.Name="{loc:Str Key=Rpm_Profile_Menu}">
        <Grid Width="32" Height="32">
          <Ellipse Fill="#1FFFFFFF"/>
          <FontIcon Glyph="&#xf141;" FontFamily="{StaticResource Fa}" FontSize="14" Foreground="#EEFFFFFF"/>
          <Ellipse x:Name="MenuDot" Width="10" Height="10" Fill="#FF3B30" HorizontalAlignment="Right"
                   VerticalAlignment="Top" Margin="0,-1,-1,0" Visibility="Collapsed"/>
        </Grid>
      </Button>

      <Button x:Name="BackKey" Click="BackKey_Click" HorizontalAlignment="Right"
              Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0"
              HorizontalContentAlignment="Right"
              Background="Transparent" BorderThickness="0" Visibility="Collapsed"
              ToolTipService.ToolTip="{loc:Str Key=Window_Close}"
              AutomationProperties.Name="{loc:Str Key=Window_Close}">
        <FontIcon Glyph="&#xf00d;" FontFamily="{StaticResource Fa}" FontSize="15" Foreground="#DDFFFFFF"/>
      </Button>
    </Grid>

    <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Column" Spacing="12" Padding="16,7,16,40">
        <TextBlock x:Name="QuietLine" FontSize="13" Foreground="#88FFFFFF" TextWrapping="Wrap"
                   Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>

    <!-- The pages the feed opens: a person's page, a post with its replies, a review read in full, the
         notifications, the edit page. They are built in code, stacked here, and only the top one is
         shown; the ones under it keep their scroll position. -->
    <Grid x:Name="PageHost" Grid.Row="1" Visibility="Collapsed"/>
  </Grid>
</UserControl>
