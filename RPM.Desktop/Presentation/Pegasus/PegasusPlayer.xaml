<UserControl x:Class="RPM.Desktop.Presentation.Pegasus.PegasusPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:RPM.Desktop.Strings"
             xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
             mc:Ignorable="d">

  <UserControl.Resources>
    <FontFamily x:Key="PegasusPlayerFa">ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro Solid</FontFamily>
  </UserControl.Resources>

  <!-- Pegasus: the full-screen player. It is one of the app's three views (see ViewModeService).

       It is not a visualizer drawn over a picture of what is playing. The record, the cover and the words
       are the picture, and the room behind them is lit by the record's own colours. This view has its own
       host, not the gallery's (Viz/VizFullScreen), because the gallery's chrome is a strip along the foot
       of the picture. This view has no foot chrome.

       IsTabStop lets the view hold keyboard focus. Escape and the remote's Back do not depend on focus: the
       shell hands them to PegasusPlayer.TakeBack. XYFocusKeyboardNavigation is on, so the arrow keys move
       the focus to the nearest item in that direction. This is how a TV remote drives the view (see
       PegasusPlayer.Remote). The view is Collapsed until Show() shows it. -->
  <Grid x:Name="Root" Background="#000000" Visibility="Collapsed"
        IsTabStop="True" UseSystemFocusVisuals="False" XYFocusKeyboardNavigation="Enabled"
        PreviewKeyDown="Root_PreviewKeyDown" PreviewKeyUp="Root_PreviewKeyUp"
        PointerMoved="Root_PointerActivity" PointerPressed="Root_PointerActivity">

    <!-- The room: the figures and the spectrum, in GL. Sized in code (SizeStage) to fill this host. -->
    <Grid x:Name="StageHost" SizeChanged="StageHost_SizeChanged"/>

    <!-- The focus glow. It shows where the remote's focus is: a soft light behind the focused item, which
         fades out past its edges. It sits under the screens and over the room, so it is behind whatever has
         focus. A cover hides the middle of the glow and shows the rest as a halo. A line or a key with
         nothing painted behind it is lit from behind. The layers are built in code (see
         PegasusPlayer.Remote, BuildGlow). While keys are in use, the glow is placed and eased onto the
         focused item every frame, and the item itself is enlarged. It is never hit-testable. -->
    <Canvas x:Name="FocusLayer" IsHitTestVisible="False">
      <Grid x:Name="FocusRing" Opacity="0">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="FocusRingShift"/>
        </Grid.RenderTransform>
      </Grid>
    </Canvas>

    <!-- The composition over it: the record half out of its cover, the cover, the words and the lyric. It
         is outside the chrome that fades. This is not something laid over the picture. It is the picture.
         -->
    <Grid x:Name="ChromeHost"/>

    <!-- The greeting. It is shown one night a year over the bare room, in place of the composition the
         listener chose (see NewYear and PegasusPlayer.ShowNewYear). It is Collapsed and at zero opacity on
         every other night of the year.

         It is outside the keys, because it is not a control and must not hide with them. Five seconds
         without mouse movement is likely at midnight. It is above the chrome host, because while it is
         shown the chrome is drawn as the empty room, so there is nothing for it to sit behind. -->
    <StackPanel x:Name="Greeting" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                MaxWidth="900" Margin="40,0">
      <TextBlock Text="{loc:Str Key=NewYear_Greeting}" FontSize="72" FontWeight="SemiBold"
                 Foreground="#FFFFFFFF" TextAlignment="Center" TextWrapping="Wrap" LineHeight="82"/>
      <TextBlock Text="{loc:Str Key=NewYear_From}" FontSize="22" FontWeight="Normal"
                 Foreground="#B3FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- This only shows when GL could not start. The renderer text stays out of the way. It is outside the
         chrome that fades, so a failure stays readable. -->
    <TextBlock x:Name="StatusText" FontSize="11" Foreground="#EEFF6B6B" MaxWidth="620" TextWrapping="Wrap"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,14,0,0"
               Visibility="Collapsed" IsHitTestVisible="False"/>

    <!-- The flash message: one sentence along the foot of the screen, for key presses that have nothing
         else on this screen to show their result.

         The full-screen view has no line to watch fill in and no menu that closes. So a key that writes
         something must show its own result. Otherwise it looks like a key that did nothing. The message
         names the song, not just "done". By the time it is read, the record may have changed. A message
         about a song the reader cannot identify would be about the wrong song.

         It is outside the keys, which hide after five quiet seconds. This is not a control, and it has its
         own two and a half seconds to run. It is never hit-testable. It is over the middle of the picture,
         and a message that took a click would block the screen while it was up. -->
    <Border x:Name="Flash" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,44"
            Background="#D8000000" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="16"
            Padding="18,9,18,9" MaxWidth="640">
      <TextBlock x:Name="FlashText" FontSize="14" Foreground="#F2FFFFFF"
                 TextWrapping="Wrap" TextAlignment="Center"/>
    </Border>

    <!-- The keys: everything that is not the picture. They hide five seconds after the last pointer move,
         so the record is alone on the screen. They come back on the next move. The pin keeps them visible.
         They fade as one layer (set in code-behind), never element by element. -->
    <Grid x:Name="Keys">

      <!-- The censor button. It appears ONLY on the lyric view, because it is a key about the words, and
           the other views have no words for it to act on. It is the rightmost key of this row. The other
           keys keep their own margins, so showing and hiding this key does not move them. The lyric key
           and the layout key are not in this row. They are in the row under the record and in the lyric
           view's foot (see PegasusChrome.LyricViewButton and LayoutButton).

           It hides the SWEARING and the DRUG NAMES, not the slurs. The slurs are always masked. It applies
           to every record, and the advisory flag in the file has no effect on it. The icon is an asterisk,
           because that is what the key does to a word. -->
      <!-- Whether the words are placed by listening to the record, or shared out evenly across the line.

           When this is off, the words in a line are spread across it by how long each word is. This is
           right most of the time, but it drifts on a held note, because an LRC file stamps lines and never
           words. When this is on, a model reads the record itself and finds where each word is sung. That
           needs a decode and a model while the music plays, so the user asks for it. A machine that cannot
           keep up turns it off by itself after one line, rather than running behind the singer.

           The icon is a microphone, because this switch decides whether anything listens to the record. -->
      <!-- Another sheet for this record, for when the one on screen has the wrong timing.

           A sheet whose words run early all the way through is not broken. It is the right words timed
           against a different version of the record. LRCLIB has several sheets for any record that has been
           covered or remastered. Nothing in the timing data tells the app which version it is looking at.
           Someone watching the words go past is the only check that settles it. That is why this key is on
           this screen, and not only in the pane next to it.

           It is the leftmost key in the row, with the two keys that also only affect the words. The reload
           icon is the same one the pane's own button uses. -->
      <Button x:Name="LyricAnotherButton" Click="LyricAnother_Click" Visibility="Collapsed"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,90,0"
              Width="30" Height="30" Padding="0" MinWidth="0" MinHeight="0" CornerRadius="15"
              Background="#55000000" BorderBrush="#22FFFFFF" BorderThickness="1" Foreground="#E6FFFFFF"
              ToolTipService.ToolTip="{loc:Str Key=TrackInfo_LyricsTryAnother}"
              AutomationProperties.Name="{loc:Str Key=TrackInfo_LyricsTryAnother}">
        <TextBlock Text="&#xf021;" FontFamily="{StaticResource PegasusPlayerFa}" FontSize="12"/>
      </Button>

      <Button x:Name="AlignButton" Click="Align_Click" Visibility="Collapsed"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,52,0"
              Width="30" Height="30" Padding="0" MinWidth="0" MinHeight="0" CornerRadius="15"
              Background="#55000000" BorderBrush="#22FFFFFF" BorderThickness="1" Foreground="#E6FFFFFF"
              ToolTipService.ToolTip="{loc:Str Key=Viz_AlignOff}"
              AutomationProperties.Name="{loc:Str Key=Viz_AlignOff}">
        <TextBlock x:Name="AlignGlyph" Text="&#xf130;" FontFamily="{StaticResource PegasusPlayerFa}" FontSize="12"/>
      </Button>

      <Button x:Name="CensorButton" Click="Censor_Click" Visibility="Collapsed"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0"
              Width="30" Height="30" Padding="0" MinWidth="0" MinHeight="0" CornerRadius="15"
              Background="#55000000" BorderBrush="#22FFFFFF" BorderThickness="1" Foreground="#E6FFFFFF"
              ToolTipService.ToolTip="{loc:Str Key=Viz_CensorOff}"
              AutomationProperties.Name="{loc:Str Key=Viz_CensorOff}">
        <TextBlock x:Name="CensorGlyph" Text="&#xf069;" FontFamily="{StaticResource PegasusPlayerFa}" FontSize="12"/>
      </Button>


      <!-- Pin: keeps the keys visible instead of letting them fade. It is Collapsed. The top right controls
           are hidden, so the only way to leave the view is to press Escape twice. -->
      <Button x:Name="PinButton" Click="Pin_Click" Visibility="Collapsed"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,52,0"
              Width="30" Height="30" Padding="0" MinWidth="0" MinHeight="0" CornerRadius="15"
              Background="#55000000" BorderBrush="#22FFFFFF" BorderThickness="1" Foreground="#E6FFFFFF"
              ToolTipService.ToolTip="{loc:Str Key=Viz_Pin}"
              AutomationProperties.Name="{loc:Str Key=Viz_Pin}">
        <TextBlock x:Name="PinGlyph" Text="&#xf08d;" FontFamily="{StaticResource PegasusPlayerFa}" FontSize="12"/>
      </Button>

      <!-- Leave. It is Collapsed (see the pin above). Escape pressed twice is the way out (see
           PegasusPlayer.TakeBack). Either way the app returns to the library. This is a view, and closing a
           view means going back to the screen that everything else is done from. -->
      <Button x:Name="CloseButton" Click="Close_Click" Visibility="Collapsed"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0"
              Width="30" Height="30" Padding="0" MinWidth="0" MinHeight="0" CornerRadius="15"
              Background="#55000000" BorderBrush="#22FFFFFF" BorderThickness="1" Foreground="#E6FFFFFF"
              ToolTipService.ToolTip="{loc:Str Key=Viz_Exit}"
              AutomationProperties.Name="{loc:Str Key=Viz_Exit}">
        <TextBlock Text="&#xf00d;" FontFamily="{StaticResource PegasusPlayerFa}" FontSize="12"/>
      </Button>
    </Grid>

    <!-- The loading screen: what is shown between the press that opens this view and the screen being ready
         to look at.

         Opening the view takes time. A GL context is created, two shaders are compiled for the machine's
         driver, and the window goes full screen. Where the collection is the opening screen, a few thousand
         records are read from the database. None of these steps is slow enough to need a progress bar, but
         each one is slow enough to see. Without this screen, the user sees a black rectangle and then the
         room appears in pieces. That looks like the app stumbled, not like it is getting ready.

         It is over EVERYTHING, the keys included. It is the one thing that is ready immediately, and a way
         out shown over an empty screen would invite a press that cancels the wait. It is taken down when
         the room has answered and the first screen has content (see TryEndLoading). TryEndLoading also
         gives up after a few seconds, so nobody is left under a spinner on a machine with no GL at all. -->
    <Grid x:Name="Loading" Background="#FF000000" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <!-- The app's turning record (see RecordSpinner), at the size of the wait on every main screen
             (ShelfLoader), not the platform's ring. -->
        <ctl:RecordSpinner x:Name="LoadingRecord" Width="64" Height="64" HorizontalAlignment="Center"/>

        <!-- How far the collection has got. It is empty until there is a figure to show. The room standing
             up has no percentage, and a counter at 0% while a shader compiles would suggest progress that
             has not started. It is centred and has a fixed width, so the text does not move sideways when
             the number gains a digit. -->
        <TextBlock x:Name="LoadingCount" Text="" FontSize="12.5" Foreground="#8CFFFFFF"
                   Width="64" HorizontalAlignment="Center" TextAlignment="Center"
                   Visibility="Collapsed"/>
      </StackPanel>
    </Grid>

  </Grid>
</UserControl>
