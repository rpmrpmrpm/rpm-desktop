<Page x:Class="RPM.Desktop.Presentation.Settings.CloudSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:loc="using:RPM.Desktop.Strings"
      xmlns:settings="using:RPM.Desktop.Presentation.Settings"
      Background="Transparent"
      mc:Ignorable="d">

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
    <StackPanel Spacing="24" Margin="20,0,20,0">
      <StackPanel.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </StackPanel.Resources>

      <StackPanel Spacing="6">
        <TextBlock Text="{loc:Str Key=Cloud_Heading}"
                   FontSize="22" FontWeight="SemiBold" Foreground="White" />
        <TextBlock Text="{loc:Str Key=Cloud_Intro}"
                   FontSize="13" Foreground="#99FFFFFF" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Signed out: the cloud is a rpm account feature, so say so instead of showing dead controls. -->
      <Border x:Name="SignInPanel"
              Style="{StaticResource ContentBorderStyle}"
              Padding="16"
              Visibility="Collapsed">
        <!-- A Grid, not a horizontal StackPanel. A horizontal stack gives each child infinite width, so
             the sentence never wraps. A longer translation would then run off the card, not onto a
             second line. -->
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <FontIcon Grid.Column="0" Style="{StaticResource FaIcon}" Glyph="&#xf2f6;" FontSize="16"
                    Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{loc:Str Key=Cloud_SignInNeeded}"
                     VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#CCFFFFFF" />
          <ctl:RpmPrimaryButton Grid.Column="2" x:Name="SignInButton" Click="OnSignIn"
                               VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf2f6;" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Cloud_SignIn}" VerticalAlignment="Center" />
              </StackPanel>
          </ctl:RpmPrimaryButton>
        </Grid>
      </Border>

      <!-- Everything below is meaningless without an account. -->
      <StackPanel x:Name="CloudPanel" Spacing="24">

        <!-- The storage this account has, and the one way to change it. It sits above the mode choices
             on purpose: the amount of room decides what the modes below can mean. -->
        <Border Style="{StaticResource ContentBorderStyle}" Padding="18">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0c2;" FontSize="12"
                        Foreground="#66FFFFFF" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Str Key=Cloud_SupporterHeading}" FontSize="15" FontWeight="SemiBold"
                         Foreground="White" VerticalAlignment="Center" />
              <!-- Shown only to a supporter. The control decides this itself: it reads the standing, so
                   this page does not show or hide it. See SupporterBadge. -->
              <ctl:SupporterBadge />
            </StackPanel>

            <TextBlock x:Name="SupporterText" FontSize="12" Foreground="#CCFFFFFF" TextWrapping="Wrap" />

            <ctl:RpmPrimaryButton x:Name="SupportButton" Click="OnBecomeSupporter"
                                  HorizontalAlignment="Left" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf004;" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Cloud_BecomeSupporter}" VerticalAlignment="Center" />
              </StackPanel>
            </ctl:RpmPrimaryButton>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource ContentBorderStyle}" Padding="18">
          <StackPanel Spacing="14">
            <RadioButton x:Name="ModeNone" GroupName="CloudMode" Checked="OnModeChanged" Tag="None">
              <StackPanel Spacing="1">
                <TextBlock Text="{loc:Str Key=Cloud_ModeNone}" Foreground="White" />
                <TextBlock Text="{loc:Str Key=Cloud_ModeNoneHint}" FontSize="12" Foreground="#88FFFFFF" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ModeSelected" GroupName="CloudMode" Checked="OnModeChanged" Tag="Selected">
              <StackPanel Spacing="1">
                <TextBlock Text="{loc:Str Key=Cloud_ModeSelected}" Foreground="White" />
                <TextBlock Text="{loc:Str Key=Cloud_ModeSelectedHint}" FontSize="12" Foreground="#88FFFFFF" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ModeAll" GroupName="CloudMode" Checked="OnModeChanged" Tag="All">
              <StackPanel Spacing="1">
                <TextBlock Text="{loc:Str Key=Cloud_ModeAll}" Foreground="White" />
                <TextBlock Text="{loc:Str Key=Cloud_ModeAllHint}" FontSize="12" Foreground="#88FFFFFF" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>

        <!-- What is in the cloud and not on this disk. Nothing here is a setting. rpm never removes a
             local file, so this is the user's own deletion, read back to them with a way to undo it. -->
        <Border Style="{StaticResource ContentBorderStyle}" Padding="18">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf381;" FontSize="12"
                        Foreground="#66FFFFFF" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Str Key=Cloud_OnlyInCloud}" FontSize="15" FontWeight="SemiBold"
                         Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{loc:Str Key=Cloud_OnlyInCloudHint}"
                       FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />

            <TextBlock x:Name="OffloadStateText"
                       FontSize="12" Foreground="#CCFFFFFF" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock x:Name="OffloadElsewhereText"
                       FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <Button x:Name="BringBackButton"
                    Content="{loc:Str Key=Cloud_BringBackButton}"
                    Click="OnBringBack"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <!-- What is in the cloud, and what the uploader is doing about it. The storage belongs beside
             the engine that fills it, not beside the account name. -->
        <Border Style="{StaticResource ContentBorderStyle}" Padding="18">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0c2;" FontSize="12"
                        Foreground="#66FFFFFF" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Str Key=Rpm_Profile_Storage}" FontSize="15" FontWeight="SemiBold"
                         Foreground="White" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="UsageText" FontSize="17" Foreground="White" />
            <ProgressBar x:Name="UsageBar"
                         Minimum="0" Maximum="1" Height="8"
                         Foreground="{StaticResource RpmCyanBrush}"
                         Background="#22FFFFFF" />

            <!-- What is actually in the cloud: synced tracks, plus tracks whose local copy has been
                 removed and whose cloud copy is now the only one. -->
            <TextBlock x:Name="UsageTracksText" FontSize="12" Foreground="#88FFFFFF" />

            <!-- Shown before the limit is reached, not after. An account with under 2 GB left is one
                 album away from the uploader stopping. That is worth knowing while there is still room
                 to decide something. -->
            <TextBlock x:Name="AlmostFullText" FontSize="12" Foreground="#FFD466"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <!-- A setting that changed itself has to say so where the setting lives. -->
            <TextBlock x:Name="SyncAllPausedText" Text="{loc:Str Key=Cloud_SyncAllPaused}"
                       FontSize="12" Foreground="#99FFFFFF"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel x:Name="ProgressPanel" Spacing="4" Visibility="Collapsed">
              <TextBlock x:Name="ProgressText" FontSize="12" Foreground="#CCFFFFFF" TextWrapping="Wrap" />
              <!-- The sweep is switched on with the panel (Render). An idle indeterminate bar animates
                   forever. -->
              <ProgressBar x:Name="BusyBar" IsIndeterminate="False" Height="2"
                           Foreground="{StaticResource RpmCyanBrush}" Background="Transparent" />
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />

            <ctl:RpmPrimaryButton x:Name="RetryButton" Click="OnRetry"
                                 HorizontalAlignment="Left"
                                 Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf021;" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Cloud_Retry}" VerticalAlignment="Center" />
              </StackPanel>
            </ctl:RpmPrimaryButton>
          </StackPanel>
        </Border>

        <!-- What went wrong, in full. The deck's chip says only that a track did not go through. A
             failure's own words run to four lines, and four lines under every row of a batch make a
             panel that nobody reads. The full text lives here, where there is room for it, and a button
             to send a report. -->
        <Border Style="{StaticResource ContentBorderStyle}" Padding="18">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf071;" FontSize="12"
                          Foreground="#66FFFFFF" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Cloud_Errors}" FontSize="15" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{loc:Str Key=Cloud_ErrorsHint}" FontSize="12" Foreground="#88FFFFFF"
                         TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="ErrorEmptyText" Text="{loc:Str Key=Cloud_ErrorsEmpty}"
                       FontSize="12" Foreground="#88FFFFFF" Visibility="Collapsed" />

            <ItemsControl x:Name="ErrorList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="settings:CloudErrorRow">
                  <Border Background="#0DFFFFFF" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="1">
                          <TextBlock Text="{x:Bind Title}" FontSize="12" Foreground="#F2FFFFFF"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{x:Bind Line}" FontSize="11" Foreground="#88FFFFFF"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnReportError"
                                IsEnabled="{x:Bind CanReport, Mode=OneWay}"
                                VerticalAlignment="Top"
                                Style="{StaticResource GlassButtonStyle}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf1d8;" FontSize="10"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ReportLabel, Mode=OneWay}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Grid>

                      <!-- Selectable: the first thing anyone does with an error is copy it. -->
                      <TextBlock Text="{x:Bind Detail}" FontSize="11" Foreground="#FFFF6B6B"
                                 TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                      <TextBlock Text="{x:Bind RefusedText, Mode=OneWay}"
                                 Visibility="{x:Bind RefusedVisibility, Mode=OneWay}"
                                 FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- The log book. The deck's chip shows what is happening now. This shows what happened, which
             is the question asked after a restart, when the chip has gone. It covers a rolling month. -->
        <Border Style="{StaticResource ContentBorderStyle}" Padding="18">
          <StackPanel Spacing="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf1da;" FontSize="12"
                            Foreground="#66FFFFFF" VerticalAlignment="Center" />
                  <TextBlock Text="{loc:Str Key=Cloud_History}" FontSize="15" FontWeight="SemiBold"
                             Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="HistoryHint" FontSize="12" Foreground="#88FFFFFF"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" x:Name="ClearHistoryButton"
                      Click="OnClearHistory" VerticalAlignment="Top"
                      Style="{StaticResource GlassButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf1f8;" FontSize="10"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Cloud_HistoryClear}" VerticalAlignment="Center" />
              </StackPanel>
              </Button>
            </Grid>

            <TextBlock x:Name="HistoryEmptyText" Text="{loc:Str Key=Cloud_HistoryEmpty}"
                       FontSize="12" Foreground="#88FFFFFF" Visibility="Collapsed" />

            <ItemsControl x:Name="HistoryList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="settings:CloudHistoryRow">
                  <Grid ColumnSpacing="10" Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Style="{StaticResource FaIcon}" FontSize="10"
                              Glyph="{x:Bind Glyph}" Foreground="{x:Bind Ink}"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{x:Bind Title}" FontSize="12" Foreground="#F2FFFFFF"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind Line}" FontSize="11" Foreground="{x:Bind Ink}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind When}" FontSize="11"
                               Foreground="#77FFFFFF" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Debug only. This walks both sides of the supporter gate without buying support, and then
           cancels it again. The card is shown from code-behind under #if DEBUG and is collapsed here.
           XAML has no conditional compilation, and a card that shipped would let a user give themselves
           the tier.

           The strings are hardcoded English on purpose. A control that never reaches a release build
           does not belong in scripts/strings.json, where every key costs five translations. -->
      <Border x:Name="SupporterDebugCard" Visibility="Collapsed"
              Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf188;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="Debug: pretend" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="18">
            <RadioButton x:Name="PretendReal" GroupName="Pretend" Content="Real account"
                         FontSize="12" Foreground="#CCFFFFFF" Checked="OnPretendChanged" />
            <RadioButton x:Name="PretendSupporter" GroupName="Pretend" Content="Supporter"
                         FontSize="12" Foreground="#CCFFFFFF" Checked="OnPretendChanged" />
            <RadioButton x:Name="PretendFree" GroupName="Pretend" Content="Not a supporter"
                         FontSize="12" Foreground="#CCFFFFFF" Checked="OnPretendChanged" />
          </StackPanel>

          <TextBlock FontSize="11" Foreground="#88FFFFFF" TextWrapping="Wrap"
                     Text="Moves DJ mode, karaoke, the gold backdrop and the standing shown above, straight away and across restarts. Cloud streaming rate is decided by the server from the real token, so it does not follow this." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
