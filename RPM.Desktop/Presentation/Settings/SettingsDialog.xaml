<ContentDialog x:Class="RPM.Desktop.Presentation.Settings.SettingsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
               xmlns:loc="using:RPM.Desktop.Strings"
               RequestedTheme="Dark"
               Background="Transparent"
               BorderThickness="0">

  <ContentDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so the
               artwork behind it reads through the dim layer rather than being blacked out. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="ContentDialogPadding">0</Thickness>
          <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
          <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
          <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
          <x:Double x:Key="ContentDialogMaxHeight">4096</x:Double>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
          <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
          <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
          <!-- A lighter modal scrim than the framework default. The dialog card is live glass, so the
               artwork behind it reads through the dim layer rather than being blacked out. -->
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ContentDialog.Resources>

  <!-- The body does not scroll. It is a rail beside a page, and each settings page brings its own
       ScrollViewer. A scrolling body would measure the rail without a limit, and the two would scroll
       as one. -->
  <ctl:ResizableDialogShell x:Name="Shell" Title="{loc:Str Key=Settings_Title}" TitleGlyph="&#xf013;"
                            ScrollBody="False">

    <!-- Rail on the left, the chosen page on the right. This is the layout that both macOS System
         Settings and Windows 11 Settings use. A new section is one ListViewItem here, plus one branch
         in OnRailSelectionChanged. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ListView x:Name="RailList"
                Grid.Column="0"
                SelectionMode="Single"
                SelectionChanged="OnRailSelectionChanged"
                Padding="0,0,10,0"
                Background="Transparent">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                  <Border x:Name="ItemRoot"
                          Background="{TemplateBinding Background}"
                          CornerRadius="8">
                    <ContentPresenter Padding="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    <VisualStateManager.VisualStateGroups>
                      <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                          <VisualState.Setters>
                            <Setter Target="ItemRoot.Background" Value="{StaticResource DmCardItemBrush}"/>
                          </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                          <VisualState.Setters>
                            <Setter Target="ItemRoot.Background" Value="{StaticResource DmCardItemBrush}"/>
                          </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Selected">
                          <VisualState.Setters>
                            <Setter Target="ItemRoot.Background" Value="#240371D0"/>
                          </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOverSelected">
                          <VisualState.Setters>
                            <Setter Target="ItemRoot.Background" Value="#300371D0"/>
                          </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PressedSelected">
                          <VisualState.Setters>
                            <Setter Target="ItemRoot.Background" Value="#300371D0"/>
                          </VisualState.Setters>
                        </VisualState>
                      </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListView.ItemContainerStyle>

        <ListView.Items>
          <ListViewItem Tag="Profile">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf007;" FontSize="14"
                        VerticalAlignment="Center" Foreground="White"/>
              <TextBlock Text="{loc:Str Key=Settings_Profile}" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
          </ListViewItem>
          <ListViewItem Tag="Library">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf001;" FontSize="14"
                        VerticalAlignment="Center" Foreground="White"/>
              <TextBlock Text="{loc:Str Key=Settings_Library}" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
          </ListViewItem>
          <ListViewItem Tag="Display">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf53f;" FontSize="14"
                        VerticalAlignment="Center" Foreground="White"/>
              <TextBlock Text="{loc:Str Key=Settings_Display}" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
          </ListViewItem>
          <ListViewItem Tag="Sound">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf028;" FontSize="14"
                        VerticalAlignment="Center" Foreground="White"/>
              <TextBlock Text="{loc:Str Key=Settings_Sound}" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
          </ListViewItem>
          <ListViewItem Tag="Cloud">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0c2;" FontSize="14"
                        VerticalAlignment="Center" Foreground="White"/>
              <TextBlock Text="{loc:Str Key=Settings_Cloud}" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
          </ListViewItem>
          <ListViewItem Tag="Catalog">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf02d;" FontSize="14"
                        VerticalAlignment="Center" Foreground="White"/>
              <TextBlock Text="{loc:Str Key=Settings_Catalog}" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
          </ListViewItem>
        </ListView.Items>
      </ListView>

      <Border Grid.Column="1" Width="1" Background="{StaticResource DmCardBorderBrush}"/>

      <ContentPresenter x:Name="PageHost" Grid.Column="2" HorizontalContentAlignment="Stretch"/>
    </Grid>

    <ctl:ResizableDialogShell.Footer>
      <Button x:Name="CloseButton" Click="Close_Click"
              Style="{StaticResource GlassButtonStyle}" Padding="18,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf00d;" FontSize="11"
                    VerticalAlignment="Center"/>
          <TextBlock Text="{loc:Str Key=Settings_Close}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </ctl:ResizableDialogShell.Footer>
  </ctl:ResizableDialogShell>
</ContentDialog>
