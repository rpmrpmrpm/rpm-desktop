<Page x:Class="RPM.Desktop.Presentation.Settings.LibrarySettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:loc="using:RPM.Desktop.Strings"
      xmlns:settings="using:RPM.Desktop.Presentation.Settings"
      xmlns:transport="using:RPM.Desktop.Presentation.Main.Transport.Controls"
      Background="Transparent"
      mc:Ignorable="d">

  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="0">
    <StackPanel Spacing="24" Margin="20,0,20,0">
      <StackPanel.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </StackPanel.Resources>

      <StackPanel Spacing="6">
        <TextBlock Text="{loc:Str Key=Settings_Library}"
                   FontSize="22" FontWeight="SemiBold" Foreground="White" />
        <TextBlock Text="{loc:Str Key=Settings_LibraryIntro}"
                   FontSize="13" Foreground="#99FFFFFF" TextWrapping="Wrap" />

        <!-- The page has nine cards, which is more than a screen. This is its table of contents. The
             links are built in code (BuildJumpLinks) from the same list that the handler scrolls to. So
             a card added there cannot end up with a link that goes nowhere, or with no link at all. -->
        <Grid x:Name="JumpLinks" ColumnSpacing="18" RowSpacing="2" Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
        </Grid>
      </StackPanel>

      <Border x:Name="FolderCard" Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf07b;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Settings_MusicFolder}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{loc:Str Key=Settings_MusicFolderHint}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />

          <Grid ColumnSpacing="12" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PathText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#CCFFFFFF"
                       FontFamily="Consolas,Menlo,monospace"
                       FontSize="12" />

            <ctl:RpmPrimaryButton Grid.Column="1" Click="OnChangeFolder">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf07b;" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Settings_Change}" VerticalAlignment="Center" />
              </StackPanel>
            </ctl:RpmPrimaryButton>
          </Grid>

          <!-- Why a folder was refused, or why one could not be opened. Empty the rest of the time. -->
          <TextBlock x:Name="FolderStatus" FontSize="12" Foreground="#FFD466" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Sharing over the local network. The switch is the only part of the machinery the user has to
           think about. Below it are the name of this computer and the list of computers it shares with. -->
      <Border x:Name="SharingCard" Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf5db;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Share_Title}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>
          <!-- Sharing is arranged between accounts. The beacon carries an account, and the grant that
               lets a borrower reach the cloud part of this shelf is written against one. So the whole
               card below means nothing without a sign-in. It says so, rather than sitting there holding
               settings that nothing will act on. The layout matches the cloud page. -->
          <Border x:Name="ShareSignInPanel"
                  Background="#14FFFFFF" CornerRadius="8" Padding="14"
                  Visibility="Collapsed">
            <!-- A Grid, not a horizontal StackPanel. A horizontal stack gives each child infinite
                 width, so TextWrapping is never reached. A long sentence, or a longer translation of a
                 short one, would run off the card. The * column gives the text a width to wrap into.
                 The icon and the button keep their own widths. -->
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Style="{StaticResource FaIcon}" Glyph="&#xf2f6;" FontSize="16"
                        Foreground="{StaticResource RpmCyanBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{loc:Str Key=Share_SignInNeeded}"
                         VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#CCFFFFFF" />
              <ctl:RpmPrimaryButton Grid.Column="2" Click="OnShareSignIn" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf2f6;" FontSize="11"
                            VerticalAlignment="Center" />
                  <TextBlock Text="{loc:Str Key=Cloud_SignIn}" VerticalAlignment="Center" />
                </StackPanel>
              </ctl:RpmPrimaryButton>
            </Grid>
          </Border>

          <StackPanel x:Name="SharePanel" Spacing="14">
          <ToggleSwitch x:Name="ShareToggle"
                        Header="{loc:Str Key=Settings_ShareLibrary}"
                        Toggled="OnShareToggled" />
          <TextBlock Text="{loc:Str Key=Settings_ShareLibraryHint}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Str Key=Settings_ShareName}" FontSize="12" Foreground="#CCFFFFFF" />
            <TextBox x:Name="ShareNameBox" LostFocus="OnShareNameChanged" />
            <TextBlock Text="{loc:Str Key=Settings_ShareNameHint}"
                       FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />
          </StackPanel>

          <TextBlock x:Name="ShareCountText" FontSize="12" Foreground="#88FFFFFF" />
          <TextBlock x:Name="ShareEmptyText" Text="{loc:Str Key=Settings_ShareNobody}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />

          <!-- Something went wrong while serving this collection to someone, or while reading theirs.
               It is shown here because the other machine cannot see it. To a borrower, a failure and a
               closed laptop look the same. Their shelf just stops changing. -->
          <TextBlock x:Name="ShareFaultText" FontSize="12" Foreground="#FFB4A8"
                     TextWrapping="Wrap" Visibility="Collapsed" />

          <!-- Windows Firewall is blocking rpm on this network. This applies on Windows only, and only
               while sharing is on. Other computers cannot reach this library. The replies that would
               list theirs are dropped too, and nothing else reports the fault. -->
          <StackPanel x:Name="ShareFirewallPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="ShareFirewallText" FontSize="12" Foreground="#FFB4A8"
                       TextWrapping="Wrap" />
            <Button x:Name="ShareFirewallButton" Click="OnShareFirewall"
                    Style="{StaticResource GlassButtonStyle}" Padding="12,0"
                    HorizontalAlignment="Left" />
          </StackPanel>

          <ItemsControl x:Name="ShareList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="settings:SharedComputerRow">
                <Grid ColumnSpacing="12" Padding="0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" Foreground="#F2FFFFFF" FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind State}" Foreground="#88FFFFFF" FontSize="11" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                              VerticalAlignment="Center">
                    <!-- Opening someone's collection is not a settings action. It is done from the
                         share button on the deck, which is where the user is when they want it, and
                         where the way back out already is. What is left here is the one thing that
                         belongs on this page: ending the arrangement. -->
                    <Button Click="OnStopSharing" Tag="{x:Bind DeviceId}"
                            Style="{StaticResource GlassButtonStyle}" Padding="12,0">
                      <TextBlock Text="{loc:Str Key=Settings_ShareRemove}" VerticalAlignment="Center" />
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- The same list as the share chip on the deck, read from the same board. A request answered
               there is answered here at the same moment. -->
          <transport:NearbyList x:Name="ShareNearby" Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="NamingCard" Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf044;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Settings_Naming}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{loc:Str Key=Settings_NamingHint}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />

          <ComboBox x:Name="TemplateCombo"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnTemplateSelected" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="NewButton" Click="OnNewTemplate" Style="{StaticResource GlassButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf067;" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Settings_NamingNew}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="DuplicateButton" Click="OnDuplicateTemplate" Style="{StaticResource GlassButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0c5;" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Settings_NamingDuplicate}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="DeleteButton" Click="OnDeleteTemplate" Style="{StaticResource GlassButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf2ed;" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Settings_NamingDelete}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBox x:Name="NameBox"
                   Header="{loc:Str Key=Settings_NamingName}"
                   TextChanged="OnNameChanged" />

          <TextBox x:Name="PatternBox"
                   Header="{loc:Str Key=Settings_NamingPattern}"
                   FontFamily="Consolas,Menlo,monospace"
                   TextChanged="OnPatternChanged" />

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Str Key=Settings_NamingTokens}"
                       FontSize="12" Foreground="#88FFFFFF" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Auto">
              <StackPanel x:Name="TokenPanel" Orientation="Horizontal" Spacing="6" />
            </ScrollViewer>
          </StackPanel>

          <Border CornerRadius="8" Padding="12,10" Background="#22000000"
                  BorderBrush="{StaticResource DmCardBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Str Key=Settings_NamingPreview}"
                         FontSize="11" Foreground="#7FFFFFFF" />
              <TextBlock x:Name="PreviewText"
                         FontFamily="Consolas,Menlo,monospace" FontSize="12"
                         Foreground="#CCFFFFFF" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- One action. The template on show is what Save adopts. Save is also where the app asks
               whether that applies to new files or to the whole collection. -->
          <TextBlock Text="{loc:Str Key=Settings_NamingSaveHint}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ctl:RpmPrimaryButton x:Name="SaveNamingButton" Click="OnSaveNaming">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf0c7;" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Settings_NamingSave}" VerticalAlignment="Center" />
              </StackPanel>
            </ctl:RpmPrimaryButton>
            <TextBlock x:Name="NamingStatus" Foreground="#88FFFFFF" FontSize="12"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="ImportActionCard" Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf56f;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Settings_ImportAction}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{loc:Str Key=Settings_ImportActionHint}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />
          <RadioButtons x:Name="ImportActionRadios" SelectionChanged="OnImportActionChanged">
            <RadioButton Content="{loc:Str Key=Settings_ImportActionMove}" />
            <RadioButton Content="{loc:Str Key=Settings_ImportActionCopy}" />
          </RadioButtons>
        </StackPanel>
      </Border>

      <!-- What a queued file must have before the import pane stops marking it. Some collections cannot
           be used without genres, and others never use them. So the set is the user's choice. -->
      <Border x:Name="RequiredTagsCard" Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf02c;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Settings_RequiredTagsTitle}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{loc:Str Key=Settings_RequiredTagsHint}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />
          <!-- Filled in code-behind: one tick per tag, from the store's own list of tags. A tag added there
               appears here without this page being edited. -->
          <StackPanel x:Name="RequiredTagsList" Spacing="2"/>
        </StackPanel>
      </Border>

      <Border x:Name="MultiDiscCard" Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf5fd;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Settings_MultiDisc}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{loc:Str Key=Settings_MultiDiscHint}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />
          <RadioButtons x:Name="MultiDiscRadios" SelectionChanged="OnMultiDiscModeChanged">
            <RadioButton Content="{loc:Str Key=Settings_MultiDiscMerged}" />
            <RadioButton Content="{loc:Str Key=Settings_MultiDiscSeparate}" />
          </RadioButtons>
        </StackPanel>
      </Border>

      <!-- Which app the machine hands a music CD to. This switch is not a preference that the app
           stores. It writes the system's own setting and reads it back. So it shows what the machine
           will actually do, however that came to be true. -->
      <Border x:Name="DiscsCard" Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf51f;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Settings_Discs}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>
          <ToggleSwitch x:Name="DiscDefaultToggle"
                        Header="{loc:Str Key=Settings_DiscDefault}"
                        Toggled="OnDiscDefaultToggled"
                        OffContent="" OnContent="" />
          <TextBlock Text="{loc:Str Key=Settings_DiscDefaultHint}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />
          <TextBlock x:Name="DiscDefaultStatus"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap"
                     Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <Border x:Name="FingerprintCard" Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf577;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Settings_Fingerprinting}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>
          <ToggleSwitch x:Name="FingerprintToggle"
                        Header="{loc:Str Key=Settings_Fingerprint}"
                        Toggled="OnFingerprintToggled"
                        OffContent="" OnContent="" />
          <TextBlock Text="{loc:Str Key=Settings_FingerprintHint}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />
          <TextBlock x:Name="FingerprintStatus"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />

          <!-- The other thing this computer offers to everybody. It belongs beside the fingerprints:
               both tell the app something so that everyone's copy knows more. This one is about
               listening, not files, so it says plainly what leaves the machine. -->
          <ToggleSwitch x:Name="ShareListeningToggle"
                        Header="{loc:Str Key=Settings_ShareListening}"
                        Toggled="OnShareListeningToggled"
                        OffContent="" OnContent="" />
          <TextBlock Text="{loc:Str Key=Settings_ShareListeningHint}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- What the analyser measured, written into the files it measured. The app works out a tempo and
           a key for every record it plays. This is where those values stop being the app's private note
           and become the file's own tags. -->
      <Border x:Name="AnalysisTagsCard" Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf080;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Settings_AnalysisTags}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>
          <ToggleSwitch x:Name="AnalysisTagsToggle"
                        Header="{loc:Str Key=Settings_AnalysisTagsWrite}"
                        Toggled="OnAnalysisTagsToggled"
                        OffContent="" OnContent="" />
          <TextBlock Text="{loc:Str Key=Settings_AnalysisTagsHint}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />

          <!-- The backfill: the same write, applied to everything analysed before this feature existed. -->
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ctl:RpmPrimaryButton x:Name="BackfillButton" Click="OnBackfillAnalysisTags">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- tags -->
                <FontIcon x:Name="BackfillGlyph" Style="{StaticResource FaIcon}" Glyph="&#xf02c;"
                          FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="BackfillLabel" Text="{loc:Str Key=Settings_AnalysisTagsBackfill}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </ctl:RpmPrimaryButton>
            <CheckBox x:Name="BackfillOverwrite" Content="{loc:Str Key=Settings_AnalysisTagsOverwrite}"
                      Checked="OnBackfillScopeChanged" Unchecked="OnBackfillScopeChanged"
                      VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="AnalysisTagsStatus"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
