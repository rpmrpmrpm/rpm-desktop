<Page x:Class="RPM.Desktop.Presentation.Settings.ProfileSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:loc="using:RPM.Desktop.Strings"
      Background="Transparent"
      mc:Ignorable="d">

  <!-- The account, and the facts about the app that are not choices. This is ported from the phone's
       Profile tab (RPM.Mobile/Presentation/ProfilePage.xaml), so the two heads say the same things, in
       the same order, about the same account.

       What is NOT here is what the phone's tab carries because a phone has no other home for it: the
       stage's opening look, the per-network bitrates, and the on-device cache. Those belong to the
       phone. The sync engine's own controls stay on the Cloud page, which is about the engine rather
       than the account. So does the storage meter it fills. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
    <StackPanel Spacing="24" Margin="20,0,20,0">
      <StackPanel.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Themes/RpmAccentControls.xaml"/>
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </StackPanel.Resources>

      <StackPanel Spacing="6">
        <TextBlock Text="{loc:Str Key=Settings_Profile}"
                   FontSize="22" FontWeight="SemiBold" Foreground="White" />
        <TextBlock Text="{loc:Str Key=Rpm_Profile_Subtitle}"
                   FontSize="13" Foreground="#99FFFFFF" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Account. -->
      <Border Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf007;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Rpm_Profile_Account}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Signed in: who this is, the name and picture everybody else sees, and the way out. It is
               one card, because to the user it is one thing: who you are. The address comes from the
               account, and the public name from the review wall. -->
          <StackPanel x:Name="SignedInPanel" Spacing="12">
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- The picture. It is drawn at the size a review row draws it, times two. It is chosen
                   here and read at 28 px on the wall, so anything that survives this square survives
                   that. -->
              <Grid Grid.Column="0" Width="72" Height="72" VerticalAlignment="Top">
                <Border CornerRadius="36" Background="#2604C8FF" />
                <TextBlock x:Name="AvatarInitial" FontSize="28" FontWeight="SemiBold"
                           Foreground="#04C8FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ctl:AvatarPicture x:Name="AvatarImage" CornerRadius="36" />
              </Grid>

              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <!-- No supporter badge here. It is in the supporter card below, in place of the word. -->
                <TextBlock x:Name="NameText" FontSize="17" Foreground="White"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock x:Name="EmailText" FontSize="13" Foreground="#88FFFFFF"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{loc:Str Key=Profile_WallDetail}" FontSize="12"
                           Foreground="#88FFFFFF" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Grid>

            <!-- The public name and picture. This is collapsed on its own when the wall cannot be
                 reached. The account above it is local and still worth showing. -->
            <StackPanel x:Name="WallPanel" Spacing="10">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Str Key=Profile_DisplayName}" FontSize="12" Foreground="#88FFFFFF" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="DisplayNameBox" Grid.Column="0" MaxLength="40" FontSize="13"
                           TextChanged="OnDisplayNameChanged" />
                  <Button x:Name="SaveNameButton" Grid.Column="1" Click="OnSaveName" IsEnabled="False"
                          Style="{StaticResource GlassButtonStyle}">
                    <TextBlock Text="{loc:Str Key=Details_Save}" VerticalAlignment="Center" />
                  </Button>
                </Grid>
                <TextBlock x:Name="WallStatusText" FontSize="12" Foreground="#88FFFFFF"
                           TextWrapping="Wrap" Visibility="Collapsed" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ChooseAvatarButton" Click="OnChooseAvatar"
                        Style="{StaticResource GlassButtonStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf03e;" FontSize="11"
                              VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Str Key=Profile_ChoosePicture}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="RemoveAvatarButton" Click="OnRemoveAvatar"
                        Style="{StaticResource GlassButtonStyle}" Visibility="Collapsed">
                  <TextBlock Text="{loc:Str Key=Profile_RemovePicture}" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="#1AFFFFFF" />

            <TextBlock Text="{loc:Str Key=Profile_SignOutDetail}" FontSize="12"
                       Foreground="#88FFFFFF" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="SignOutButton" Click="OnSignOut"
                      Style="{StaticResource GlassButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf2f5;" FontSize="11"
                            VerticalAlignment="Center" />
                  <TextBlock Text="{loc:Str Key=Rpm_Profile_SignOut}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <!-- Deleting the account: the server deletes it and erases the cloud library. This
                   computer signs out and keeps its music. See AccountDeletion. -->
              <ctl:RpmDangerButton x:Name="DeleteAccountButton" Click="OnDeleteAccount">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf2ed;" FontSize="11"
                            VerticalAlignment="Center" />
                  <TextBlock Text="{loc:Str Key=Account_Delete}" VerticalAlignment="Center" />
                </StackPanel>
              </ctl:RpmDangerButton>
            </StackPanel>
          </StackPanel>

          <!-- Signed out: the content of this card is about an account, so say so plainly rather than
               showing empty fields. -->
          <StackPanel x:Name="SignedOutPanel" Spacing="12" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Profile_SignedOut}" FontSize="13"
                       Foreground="#CCFFFFFF" TextWrapping="Wrap" />
            <ctl:RpmPrimaryButton x:Name="SignInButton" Click="OnSignIn" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf2f6;" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Cloud_SignIn}" VerticalAlignment="Center" />
              </StackPanel>
            </ctl:RpmPrimaryButton>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Supporter. This shows only the status of this account. It stays hidden until the quota
           has been read. -->
      <Border x:Name="PlanCard" Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <!-- fa-heart, the mark this app uses for supporting everywhere else. -->
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf004;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Rpm_Profile_Plan}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Cyan for the free plan. The gold badge is for a supporter. The badge says "Supporter"
               itself, so the word is not written twice. -->
          <StackPanel x:Name="FreeStanding" Spacing="4" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Rpm_Profile_PlanFree}" FontSize="17"
                       Foreground="{StaticResource RpmCyanBrush}" />
            <TextBlock Text="{loc:Str Key=Rpm_Profile_PlanFreeDetail}" FontSize="12"
                       Foreground="#88FFFFFF" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Str Key=Rpm_Profile_PlanFreeAppeal}" FontSize="12" Margin="0,6,0,0"
                       Foreground="#B3FFFFFF" TextWrapping="Wrap" />
          </StackPanel>

          <!-- The status is given to the badge, not read from the account (ReadsAccount is False). So
               the badge and the card follow the one status that ShowPlan reads. -->
          <StackPanel x:Name="SupporterStanding" Spacing="4" Visibility="Collapsed">
            <ctl:SupporterBadge x:Name="PlanBadge" ReadsAccount="False" HorizontalAlignment="Left"
                                Margin="0,2,0,2" />
            <TextBlock Text="{loc:Str Key=Rpm_Profile_PlanSupporterDetail}" FontSize="12"
                       Foreground="#88FFFFFF" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Str Key=Rpm_Profile_PlanSupporterThanks}" FontSize="12" Margin="0,6,0,0"
                       Foreground="#B3FFFFFF" TextWrapping="Wrap" />
          </StackPanel>

          <!-- A closed beta tester has the supporter features but does not pay, so no gold badge. -->
          <StackPanel x:Name="TesterStanding" Spacing="4" Visibility="Collapsed">
            <TextBlock Text="{loc:Str Key=Rpm_Profile_PlanTester}" FontSize="17"
                       Foreground="{StaticResource RpmCyanBrush}" />
            <TextBlock Text="{loc:Str Key=Rpm_Profile_PlanTesterDetail}" FontSize="12"
                       Foreground="#88FFFFFF" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Str Key=Rpm_Profile_PlanTesterThanks}" FontSize="12" Margin="0,6,0,0"
                       Foreground="#B3FFFFFF" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Where the app keeps its own things. This is the desktop's version of the phone's log card. A
           phone must show the trail, because the user cannot reach its files. On the desktop the user
           can open the folder. -->
      <Border Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf07b;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Profile_DataFolder}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{loc:Str Key=Profile_DataFolderDetail}" FontSize="12"
                     Foreground="#88FFFFFF" TextWrapping="Wrap" />

          <TextBlock x:Name="DataPathText" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                     Foreground="#CCFFFFFF" TextWrapping="Wrap" />

          <Button x:Name="ShowFolderButton" Click="OnShowFolder"
                  Style="{StaticResource GlassButtonStyle}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf35d;" FontSize="11"
                        VerticalAlignment="Center" />
              <TextBlock Text="{loc:Str Key=Profile_ShowFolder}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Cached data from other services. It is one folder and one button. Everything in it can be
           fetched again, and nothing of the user's own is in it. -->
      <Border Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf1c0;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Profile_Cache}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{loc:Str Key=Profile_CacheDetail}" FontSize="12"
                     Foreground="#88FFFFFF" TextWrapping="Wrap" />

          <TextBlock x:Name="CacheSizeText" FontSize="13" Foreground="#CCFFFFFF" />

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="ClearCacheButton" Click="OnClearCache"
                    Style="{StaticResource GlassButtonStyle}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf2ed;" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Profile_ClearCache}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <TextBlock x:Name="CacheStatusText" FontSize="12" Foreground="#88FFFFFF"
                       VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Updates. The app keeps itself current on its own. This card is where a reader can see what it
           is doing, and ask it to check now. A copy that was not installed by the installer says so,
           rather than offering a button that cannot do anything. -->
      <Border x:Name="UpdatesCard" Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf021;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Profile_Updates}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{loc:Str Key=Profile_UpdatesDetail}" FontSize="12"
                     Foreground="#88FFFFFF" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="CheckUpdatesButton" Click="OnCheckUpdates"
                    Style="{StaticResource GlassButtonStyle}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf021;" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Profile_CheckUpdates}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Shown only once something has been fetched, which is also when the status line says so. -->
            <Button x:Name="RestartForUpdateButton" Click="OnRestartForUpdate"
                    Style="{StaticResource GlassButtonStyle}" HorizontalAlignment="Left"
                    Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf01e;" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Key=Update_Restart}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="#88FFFFFF"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>

          <ToggleSwitch x:Name="CrashReportsToggle"
                        Header="{loc:Str Key=Settings_CrashReports}"
                        Toggled="OnCrashReportsToggled"
                        OffContent="" OnContent="" />
          <TextBlock Text="{loc:Str Key=Settings_CrashReportsDesc}"
                     FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- About. -->
      <Border Style="{StaticResource ContentBorderStyle}" Padding="18">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Style="{StaticResource FaIcon}" Glyph="&#xf05a;" FontSize="12"
                      Foreground="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Key=Rpm_Profile_About}" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{loc:Str Key=Profile_Tagline}" FontSize="13" Foreground="#B3FFFFFF"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="VersionText" FontSize="12" Foreground="#66FFFFFF" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
