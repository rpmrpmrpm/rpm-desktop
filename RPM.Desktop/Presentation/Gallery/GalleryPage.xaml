<Page
    x:Class="RPM.Desktop.Presentation.Gallery.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#111114">

    <Page.Resources>
        <Style x:Key="GallerySection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6BE1FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="120"/>
            <Setter Property="Margin" Value="14,18,14,6"/>
        </Style>
        <Style x:Key="GalleryButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8E8EA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="6,1"/>
        </Style>
    </Page.Resources>

    <!-- A control panel, not a host: the buttons drive the MAIN app window. Pages navigate the main
         window; dialogs open over it. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,18,16,8">
            <TextBlock Text="GALLERY" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" CharacterSpacing="80"/>
            <TextBlock Text="drives the main window · demo data · no network"
                       Foreground="#7A7A82" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PAGES" Style="{StaticResource GallerySection}"/>
                <Button Style="{StaticResource GalleryButton}" Tag="MainPage" Click="Page_Click"
                        Content="Library workbench"/>
                <Button Style="{StaticResource GalleryButton}" Tag="WizardPage" Click="Page_Click"
                        Content="First-run setup"/>
                <Button Style="{StaticResource GalleryButton}" Click="AlbumPage_Click"
                        Content="Album page (full, with reviews)"/>

                <TextBlock Text="COLLECTION WILL NOT OPEN" Style="{StaticResource GallerySection}"/>
                <Button Style="{StaticResource GalleryButton}" Tag="Missing" Click="Problem_Click"
                        Content="Music folder is not there"/>
                <Button Style="{StaticResource GalleryButton}" Tag="TooNew" Click="Problem_Click"
                        Content="Made by a newer rpm"/>
                <Button Style="{StaticResource GalleryButton}" Tag="Unreadable" Click="Problem_Click"
                        Content="Database could not be read"/>
                <Button Style="{StaticResource GalleryButton}" Tag="ReadFailed" Click="Problem_Click"
                        Content="Database stopped answering (over the library)"/>

                <TextBlock Text="LIBRARY" Style="{StaticResource GallerySection}"/>
                <Button Style="{StaticResource GalleryButton}" Click="SmallLibrary_Click"
                        Content="Demo library (small, real artists)"/>
                <Button Style="{StaticResource GalleryButton}" Click="BigLibrary_Click"
                        Content="Stress library (200,000 tracks)"/>
                <Button Style="{StaticResource GalleryButton}" Click="WallLibrary_Click"
                        Content="Album wall (1,000 albums, with art)"/>

                <TextBlock Text="PLAYER" Style="{StaticResource GallerySection}"/>
                <Button Style="{StaticResource GalleryButton}" Click="RPaMp_Click"
                        Content="RPaMp player"/>
                <Button Style="{StaticResource GalleryButton}" Click="NewYear_Click"
                        Content="New Year greeting (out of season)"/>

                <TextBlock Text="DIALOGS" Style="{StaticResource GallerySection}"/>
                <Button Style="{StaticResource GalleryButton}" Tag="Login" Click="Dialog_Click"
                        Content="Sign in"/>
                <Button Style="{StaticResource GalleryButton}" Tag="LoginOffline" Click="Dialog_Click"
                        Content="Sign in (offline)"/>
                <Button Style="{StaticResource GalleryButton}" Tag="AddMusic" Click="Dialog_Click"
                        Content="Add music"/>
                <Button Style="{StaticResource GalleryButton}" Tag="RipCd" Click="Dialog_Click"
                        Content="Import from CD"/>
                <Button Style="{StaticResource GalleryButton}" Tag="RipDvd" Click="Dialog_Click"
                        Content="Import from DVD"/>
                <Button Style="{StaticResource GalleryButton}" Tag="Recognize" Click="Dialog_Click"
                        Content="Recognize (supporter)"/>
                <Button Style="{StaticResource GalleryButton}" Tag="RecognizeBasic" Click="Dialog_Click"
                        Content="Recognize (not a supporter)"/>
                <Button Style="{StaticResource GalleryButton}" Tag="ReleaseLookup" Click="Dialog_Click"
                        Content="Release lookup"/>
                <Button Style="{StaticResource GalleryButton}" Tag="RecordVinyl" Click="Dialog_Click"
                        Content="Record vinyl, step 1 (input and level)"/>
                <Button Style="{StaticResource GalleryButton}" Tag="RecordVinylSides" Click="Dialog_Click"
                        Content="Record vinyl, step 2 (record sides)"/>
                <Button Style="{StaticResource GalleryButton}" Tag="TrackDetails" Click="Dialog_Click"
                        Content="Track details"/>
                <Button Style="{StaticResource GalleryButton}" Tag="SplitAlbum" Click="Dialog_Click"
                        Content="Split album"/>
                <Button Style="{StaticResource GalleryButton}" Tag="CloudFull" Click="Dialog_Click"
                        Content="Cloud storage full"/>
                <Button Style="{StaticResource GalleryButton}" Tag="CloudFullAgain" Click="Dialog_Click"
                        Content="Cloud storage full (2nd time, opt-out)"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0B0B0D" Padding="14,10">
            <TextBlock x:Name="StatusText" Foreground="#9A9AA2" FontSize="11" TextWrapping="Wrap"
                       Text="Pick a screen — it opens in the main window."/>
        </Border>
    </Grid>
</Page>
