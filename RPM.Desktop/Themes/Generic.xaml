<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:RPM.Desktop.Presentation.Common"
                    xmlns:ctl="using:RPM.Desktop.Presentation.Controls"
                    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:not_win="http://uno.ui/not_win"
                    mc:Ignorable="not_win"
>

  <ResourceDictionary.MergedDictionaries>
    <!-- The app's checkbox skin: the Melodrama azure gradient. It is in its own file so that screens
         which also merge RpmAccentControls.xaml (flat cyan on every accent-filled control) can merge
         it again, after that file, so it wins. -->
    <ResourceDictionary Source="ms-appx:///Themes/AzureCheckBox.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- ══ Shared resources ══ -->

  <ImageBrush x:Key="AppBackgroundBrush"
              ImageSource="ms-appx:///Assets/background-rpamp.jpg"
              Stretch="UniformToFill"/>

  <!-- What a repeater inside a recycled item template shows when its binding has nothing to resolve.
       Every such ItemsSource sets FallbackValue={StaticResource NoItems}. Do not remove it: on that
       path null is the one value Uno's ItemsRepeater cannot take. NoItems explains why. -->
  <ui:NoItems x:Key="NoItems"/>

  <!-- Placeholder text, app-wide. In its rest state Uno's template binds the placeholder to the
       control's PlaceholderForeground property. It falls back to the TextControlPlaceholderForeground
       theme key (a bright system default) only when that property is not set. So a theme override in
       App.xaml alone does nothing at rest. The property must be set on the implicit styles to dim it.
       The theme keys still cover the hover and focus states, and NumberBox, which has no such property. -->
  <SolidColorBrush x:Key="PlaceholderInkBrush" Color="#40E6E6E6"/>
  <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="PlaceholderForeground" Value="{StaticResource PlaceholderInkBrush}"/>
    <!-- Right-click menu and Ctrl+V. The Win32 Skia host's TextBox does not provide them, although
         macOS does. See TextBoxClipboard. -->
    <Setter Property="ui:TextBoxClipboard.IsEnabled" Value="True"/>
    <!-- A character that does not fit in one UTF-16 unit, such as an emoji or an italic 𝑒, arrives in
         two halves. The host's TextBox writes and measures the first half alone, which ends the
         process. See TextBoxSurrogates. -->
    <Setter Property="ui:TextBoxSurrogates.IsEnabled" Value="True"/>
    <!-- Spell checking is on by default in WinUI. Most boxes in this app hold an artist, an album,
         a file name or a search term. A dictionary does not know these words, so the default would
         mark nearly everything typed. Spell checking is off here and on only where prose is
         written: the review editor, album comments and the report note. -->
    <Setter Property="IsSpellCheckEnabled" Value="False"/>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
    <Setter Property="PlaceholderForeground" Value="{StaticResource PlaceholderInkBrush}"/>
  </Style>
  <!-- This setter is for Uno only. WinUI's PasswordBox has no PlaceholderForeground property. Its
       template reads TextControlPlaceholderForeground instead, which App.xaml sets to #40E6E6E6, the
       same colour as this brush. The not_win prefix is listed in mc:Ignorable, so the WinUI markup
       compiler drops the line and Uno's generator keeps it. -->
  <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
    <not_win:Setter Property="PlaceholderForeground" Value="{StaticResource PlaceholderInkBrush}"/>
  </Style>

  <!-- Brand colours. -->
  <Color x:Key="RpmCyanColor">#04C8FF</Color>
  <Color x:Key="RpmGreenColor">#00F15E</Color>
  <Color x:Key="RpmRedColor">#FF6B6B</Color>
  <!-- The palette's Gold (Assets/RpmPalette, "Now 04"). It is the same tone as the edge of the
       warning message band, so a warning has one colour wherever the app shows one. -->
  <Color x:Key="RpmGoldColor">#EFAF12</Color>
  <Color x:Key="RpmInkColor">#0E1520</Color>
  <SolidColorBrush x:Key="RpmCyanBrush" Color="#04C8FF"/>
  <SolidColorBrush x:Key="RpmGreenBrush" Color="#00F15E"/>
  <SolidColorBrush x:Key="RpmRedBrush" Color="#FF6B6B"/>
  <SolidColorBrush x:Key="RpmGoldBrush" Color="#EFAF12"/>
  <SolidColorBrush x:Key="RpmInkBrush" Color="#0E1520"/>

  <!-- Every card, grid, player panel and art strip sits on the same ground: black at 10%. This is
       not a colour of its own. It is a shade over whatever the page is, so nothing can disagree at
       the seams. A gradient would disagree: its coordinates are relative to each element that uses
       it, so a short wide strip and a tall wide grid never match along the edge they share. -->
  <!-- The card fill matches the songs grid's surface (GridSurfaceBrush): the same 20% black veil,
       so every card reads as one ground with the grids over the artwork. -->
  <SolidColorBrush x:Key="DmCardBrush" Color="#33000000"/>
  <!-- Glass edge: a faint white gradient that turns at the middle of the card, so light catches both
       ends of the pane: a lit top, a dim middle and a brighter foot. A single gradient from top to
       bottom would leave the top edge almost unlit. The foot is brighter than the top because light
       falls from above, so the far rim of the glass catches more of it. The effect stays subtle. It
       should look like a lit pane of glass, not a drawn line. -->
  <LinearGradientBrush x:Key="DmCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#1EFFFFFF"/>
    <GradientStop Offset="0.5" Color="#0CFFFFFF"/>
    <GradientStop Offset="1" Color="#24FFFFFF"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="DmCardItemBrush" Color="#59151C28"/>

  <!-- FontAwesome icon style for menu items and similar. -->
  <Style x:Key="FaIcon" TargetType="FontIcon">
    <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/fa-solid-900.ttf#Font Awesome 5 Pro Solid"/>
  </Style>

  <!-- The icon on a menu row. Use this style for every menu icon. A MenuFlyoutItem's template puts
       its icon in a fixed 16x16 Viewbox that stretches whatever it holds. An unboxed FontIcon is
       scaled until its glyph fills that square, so a tall narrow glyph grows to the full height, a
       wide flat glyph only reaches the width, and the rows do not agree on a size. FontSize alone has
       no effect, because the Viewbox undoes it.

       Giving the icon a 16x16 box of its own makes the Viewbox a no-op (it scales 16 to 16). The
       glyph then follows FontSize, which means the same size on every row. -->
  <Style x:Key="FaMenuIcon" TargetType="FontIcon" BasedOn="{StaticResource FaIcon}">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- The brand marks (Apple, Google) are in their own font. They are NOT in the solid one, so a
       FontIcon that points at FaIcon shows a missing-glyph box.

       Set this on a TextBlock, not a FontIcon. Several brand glyphs are taller than the em box
       (Apple's leaf, Google's tail), and a FontIcon clips them to its own bounds. A TextBlock lays
       them out on a normal line, so they keep their full height. -->
  <FontFamily x:Key="FaBrandFont">ms-appx:///Assets/Fonts/fa-brands-400.ttf#Font Awesome 5 Brands Regular</FontFamily>

  <!-- The artist mark: a head and shoulders with a microphone in front. Font Awesome has no such
       glyph, so it is built from two glyphs it does have: the body of user-music, whose right shoulder
       is cut back to leave room for the microphone, and the FA microphone, placed where the music
       note was. Both outlines come from fa-solid-900.ttf at its native 512-unit scale, so the mark
       has the same weight, corner radii and clear space as the other icons. See
       Presentation/Controls/ArtistIcon.cs.

       F1 = nonzero winding. The mini-language defaults to even-odd. Under even-odd the head and the
       shoulder cancel where they overlap, and the microphone capsule cuts a hole through its own
       cradle. Font outlines use nonzero, so this path must too. -->
  <Style TargetType="ctl:ArtistIcon">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:ArtistIcon">
          <Viewbox Stretch="Uniform">
            <Path Stretch="Uniform"
                  Fill="{TemplateBinding Foreground}"
                  Data="F1 M254.8 225.6Q224.4 256 181.5 256Q138.5 256 108.2 225.6Q77.8 195.2 77.8 152.3Q77.8 109.4 108.2 79Q138.5 48.6 181.5 48.6Q224.4 48.6 254.8 79Q285.2 109.4 285.2 152.3Q285.2 195.2 254.8 225.6ZM233.3 398.6Q233.3 436.7 267.3 463.4H38.9Q22.7 463.4 11.3 452.1Q0 440.7 0 424.5V390.5Q0 345.9 32 313.9Q64 281.9 108.6 281.9H122.3Q150.7 294.9 181.5 294.9Q212.3 294.9 240.6 281.9H254.4Q294.9 281.9 325.7 309.5Q285.2 315.9 259.2 340.7Q233.3 365.4 233.3 398.6ZM353.3 303.5V210.2Q353.3 186.9 369.7 170.5Q386 154.2 409.3 154.2Q432.7 154.2 449 170.5Q465.3 186.9 465.3 210.2V303.5Q465.3 326.9 449 343.2Q432.7 359.5 409.3 359.5Q386 359.5 369.7 343.2Q353.3 326.9 353.3 303.5ZM502.7 266.2Q506.8 266.2 509.4 268.8Q512 271.5 512 275.5V303.5Q512 342 486.6 370.9Q461.3 399.8 423.3 405V424.9H456Q460.1 424.9 462.7 427.5Q465.3 430.1 465.3 434.2V443.5Q465.3 447.6 462.7 450.2Q460.1 452.9 456 452.9H362.7Q358.6 452.9 356 450.2Q353.3 447.6 353.3 443.5V434.2Q353.3 430.1 356 427.5Q358.6 424.9 362.7 424.9H395.3V405Q357.4 399.8 332.1 369.2Q306.7 338.5 306.7 298.9V275.5Q306.7 271.5 309.3 268.8Q311.9 266.2 316 266.2H325.3Q329.4 266.2 332.1 268.8Q334.7 271.5 334.7 275.5V300Q334.7 329.8 353.9 352.5Q373.2 375.3 401.8 377.6Q435 381.1 459.5 358.7Q484 336.2 484 303.5V275.5Q484 271.5 486.6 268.8Q489.3 266.2 493.3 266.2Z"/>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The explicit-lyrics mark: an E knocked out of a filled square, beside a song or record title.
       It is muted, not loud. It states a fact about the track, not a warning, so it uses the weight
       of the secondary text next to it and the title stays the main thing read.

       The fill is Foreground. The letter is LetterBrush, which must match the SURFACE the badge sits
       on, not the text beside it. The default is the dark used for the library's lists. A view over
       a lighter surface sets its own. -->
  <!-- StarRating builds its row of stars in code. The template only provides the presenter that the
       row is placed in. Do not parse the template from a string with XamlReader.Load inside the
       control. A Native AOT build cannot cast the result to ControlTemplate. The type initializer
       throws, and the album page fails on its first star. Windows ships as Native AOT. -->
  <Style TargetType="ctl:StarRating">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:StarRating">
          <ContentPresenter x:Name="PART_Host"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ctl:ExplicitBadge">
    <Setter Property="Width" Value="15"/>
    <Setter Property="Height" Value="15"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Foreground" Value="#8CFFFFFF"/>
    <Setter Property="LetterBrush" Value="#FF14161A"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:ExplicitBadge">
          <Border Background="{TemplateBinding Foreground}" CornerRadius="2.5">
            <!-- A Viewbox keeps the letter the same size as the badge. A tracklist uses 15 and a
                 record heading uses 16. A fixed font size would look cramped at one size and too
                 small at the other.

                 The inset is thin on purpose. At a tracklist's size a padding that suits a large
                 heading takes most of the glyph, and the E becomes a light square. -->
            <Viewbox Stretch="Uniform" Margin="1.5,1">
              <TextBlock Text="E" FontSize="10" FontWeight="Bold" LineHeight="10"
                         Foreground="{TemplateBinding LetterBrush}"/>
            </Viewbox>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The AD mark, shown beside the name of a station that carries advertising. It is drawn like the
       E mark on purpose. The two appear in the same kind of place, and a list that drew them
       differently would look like two unrelated marks, not two facts about the row.

       It is wider than the E because it has two letters. The letters are set closer together than
       the single E, so that at fifteen points the pair reads as one shape.

       It is muted, at the weight of the secondary text next to it. A station with ads is a normal
       fact about the station, not a warning. -->
  <Style TargetType="ctl:AdsBadge">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="15"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Foreground" Value="#8CFFFFFF"/>
    <Setter Property="LetterBrush" Value="#FF14161A"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:AdsBadge">
          <Border Background="{TemplateBinding Foreground}" CornerRadius="2.5">
            <Viewbox Stretch="Uniform" Margin="2,1">
              <TextBlock Text="AD" FontSize="10" FontWeight="Bold" LineHeight="10"
                         Foreground="{TemplateBinding LetterBrush}"/>
            </Viewbox>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The Discogs mark. The path is copied from Assets/Svg/discogs.svg, so the mark scales cleanly
       and takes the Foreground of the element it sits in. Font Awesome's brands font has no Discogs
       glyph, so this path is needed.

       F1 = nonzero winding. The mini-language defaults to even-odd. Under even-odd the concentric
       arcs cancel each other and the record would draw as rings with holes in them. -->
  <Style TargetType="ctl:DiscogsIcon">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:DiscogsIcon">
          <Viewbox Stretch="Uniform">
            <Path Stretch="Uniform"
                  Fill="{TemplateBinding Foreground}"
                  Data="F1 M1.7422 11.982c0-5.6682 4.61-10.2782 10.2758-10.2782 1.8238 0 3.5372.48 5.0251 1.3175l.8135-1.4879C16.1768.588 14.2474.036 12.1908.0024h-.1944C5.4091.0144.072 5.3107 0 11.886v.1152c.0072 3.4389 1.4567 6.5345 3.7748 8.7207l1.1855-1.2814c-1.9798-1.8743-3.218-4.526-3.218-7.4585zM20.362 3.4053l-1.1543 1.2406c1.903 1.867 3.0885 4.4636 3.0885 7.3361 0 5.6658-4.61 10.2758-10.2758 10.2758-1.783 0-3.4605-.456-4.922-1.2575l-.8542 1.5214c1.7086.9384 3.6692 1.4735 5.7546 1.4759C18.6245 23.9976 24 18.6246 24 11.9988c-.0048-3.3717-1.399-6.4146-3.638-8.5935zM1.963 11.982c0 2.8701 1.2119 5.4619 3.146 7.2953l1.1808-1.2767c-1.591-1.5166-2.587-3.6524-2.587-6.0186 0-4.586 3.7293-8.3152 8.3152-8.3152 1.483 0 2.875.3912 4.082 1.0751l.8351-1.5262C15.481 2.395 13.8034 1.927 12.018 1.927 6.4746 1.9246 1.963 6.4362 1.963 11.982zm18.3702 0c0 4.586-3.7293 8.3152-8.3152 8.3152-1.4327 0-2.7837-.3648-3.962-1.0055l-.852 1.5166c1.4303.7823 3.0718 1.2287 4.814 1.2287 5.5434 0 10.055-4.5116 10.055-10.055 0-2.8077-1.1567-5.3467-3.0165-7.1729l-1.183 1.2743c1.519 1.507 2.4597 3.5924 2.4597 5.8986zm-1.9486 0c0 3.5109-2.8558 6.3642-6.3642 6.3642a6.3286 6.3286 0 01-3.0069-.756l-.8471 1.507c1.147.624 2.4597.9768 3.854.9768 4.4636 0 8.0944-3.6308 8.0944-8.0944 0-2.239-.9143-4.2692-2.3902-5.7378l-1.1783 1.267c1.1351 1.152 1.8383 2.731 1.8383 4.4732zm-14.4586 0c0 2.3014.9671 4.382 2.515 5.8578l1.1734-1.2695c-1.207-1.159-1.9606-2.786-1.9606-4.5883 0-3.5108 2.8557-6.3642 6.3642-6.3642 1.1423 0 2.215.3048 3.1437.8352l.8303-1.5167c-1.1759-.6647-2.5317-1.0487-3.974-1.0487-4.4612 0-8.092 3.6308-8.092 8.0944zm12.5292 0c0 2.4502-1.987 4.4372-4.4372 4.4372a4.4192 4.4192 0 01-2.0614-.5088l-.8351 1.4879a6.1135 6.1135 0 002.8965.727c3.3885 0 6.1434-2.7548 6.1434-6.1433 0-1.6774-.6767-3.1989-1.7686-4.3076l-1.1615 1.2503c.7559.7967 1.2239 1.8718 1.2239 3.0573zm-10.5806 0c0 1.7374.7247 3.3069 1.8886 4.4252L8.92 15.1569l.0144.0144c-.8351-.8063-1.3559-1.9366-1.3559-3.1869 0-2.4502 1.9846-4.4372 4.437