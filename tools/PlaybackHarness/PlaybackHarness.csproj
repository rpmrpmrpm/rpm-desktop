<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately NOT in RPM.sln: it compiles app source files directly, and it is a thing you
    run by hand when playback misbehaves, not part of any build. See README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RPM.Tools.PlaybackHarness</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The real pipeline, compiled unmodified: a copy would prove nothing. -->
    <Compile Include="../../RPM.Desktop/Services/Audio/AudioEngine*.cs" />
    <Compile Include="../../RPM.Desktop/Services/Audio/OpenAlSink.cs" />
    <Compile Include="../../RPM.Desktop/Services/Audio/PipelineProbe.cs" />
    <Compile Include="../../RPM.Desktop/Services/Audio/AudioDeviceWatch.cs" />
    <Compile Include="../../RPM.Desktop/Services/Audio/MacAudioDevices.cs" />
    <Compile Include="../../RPM.Desktop/Services/Audio/WinAudioDevices.cs" />
    <Compile Include="../../RPM.Desktop/Services/Audio/LinuxAudioDevices.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../RPM.Core/RPM.Core.csproj" />
    <PackageReference Include="Silk.NET.OpenAL" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" />
  </ItemGroup>

</Project>
