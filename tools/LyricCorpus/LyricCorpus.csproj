<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LyricCorpus</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../RPM.Core/RPM.Core.csproj" />
    <!-- The aligner's own sample rate and alphabet. A corpus cut at some other rate, or carrying
         letters the model has no token for, is a corpus for a different model. -->
    <ProjectReference Include="../../RPM.Onnx/RPM.Onnx.csproj" />
  </ItemGroup>
</Project>
